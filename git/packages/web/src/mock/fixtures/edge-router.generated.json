7bf3d9383b718a6391f8","router.ts"],["100644","742744ab360c2f0920976e7abe39819a4b47a3fa","server.ts"]],"8ac7eeecc5c9fde067d0736b306f4d836868ce50":[["100644","b9470778764f72c5257a3361590d2994547f90e1",".gitignore"],["100644","fdeb777fc84834b0fc39b02e4e462cc07b73ea70","README.md"],["100644","b86529666c056731e7b0c59591c3ce22362c7eaa","package.json"],["040000","13530370d386b596cc781995953420cf2921bf71","src"],["100644","b535c7e338382c5072dbc7a18d07a1c08038b97a","tsconfig.json"]],"3f581905baed4ab57903c3da457ff7f46b98e366":[["100644","c62bfa3e60fc21188c697bf3d9383b718a6391f8","router.ts"]],"f9211660f3a4807ad3aba57a15a191da70fd3337":[["100644","b9470778764f72c5257a3361590d2994547f90e1",".gitignore"],["100644","fdeb777fc84834b0fc39b02e4e462cc07b73ea70","README.md"],["100644","b86529666c056731e7b0c59591c3ce22362c7eaa","package.json"],["040000","3f581905baed4ab57903c3da457ff7f46b98e366","src"],["100644","b535c7e338382c5072dbc7a18d07a1c08038b97a","tsconfig.json"]],"7933b58657de5c1e9b63b4cc74df3f2920f56105":[["100644","b9470778764f72c5257a3361590d2994547f90e1",".gitignore"],["100644","fdeb777fc84834b0fc39b02e4e462cc07b73ea70","README.md"],["100644","b86529666c056731e7b0c59591c3ce22362c7eaa","package.json"],["100644","b535c7e338382c5072dbc7a18d07a1c08038b97a","tsconfig.json"]]},"blobs":{"b9470778764f72c5257a3361590d2994547f90e1":{"size":20,"binary":false,"text":"node_modules/\ndist/\n"},"9925293bf1cda1e32a3f8f912e97e124d76fe27d":{"size":238,"binary":false,"text":"# edge-router\n\nRoutes requests at the edge by host and path prefix.\n\n```sh\nROUTES='[{\"host\":\"api.acme.example\",\"prefix\":\"/\",\"upstream\":\"http://10.0.3.14:8080\"}]' node dist/server.js\n```\n\nRoutes with the same prefix are ordered by weight.\n"},"4d57c9b8524954bbeb2691bc66eb5622f577dffe":{"size":201,"binary":false,"text":"{\n  \"name\": \"edge-router\",\n  \"version\": \"0.2.0\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"tsc -p .\",\n    \"test\": \"node --test dist\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^5.6.0\"\n  }\n}\n"},"c33f0b51bbbbdad4364ec3aa7670647877023f3b":{"size":702,"binary":false,"text":"export interface Route {\n  readonly host: string;\n  readonly prefix: string;\n  readonly upstream: string;\n  readonly weight?: number;\n}\n\n/** The longest matching prefix wins; ties go to the heavier route. */\nexport function match(routes: readonly Route[], url: URL): Route | undefined {\n  let best: Route | undefined;\n  for (const route of routes) {\n    if (route.host !== url.host || !url.pathname.startsWith(route.prefix)) continue;\n    if (\n      best === undefined ||\n      route.prefix.length > best.prefix.length ||\n      (route.prefix.length === best.prefix.length && (route.weight ?? 1) > (best.weight ?? 1))\n    ) {\n      best = route;\n    }\n  }\n  return best;\n}\n\nexport const NO_ROUTE = 404;\n"},"55a6d43ca4bfa785f7564bef65c5447647673234":{"size":786,"binary":false,"text":"import { createServer } from \"node:http\";\nimport { match, type Route } from \"./router.js\";\n\nconst routes: Route[] = JSON.parse(process.env.ROUTES ?? \"[]\");\n\ncreateServer(async (request, response) => {\n  const url = new URL(request.url ?? \"/\", `http://${request.headers.host}`);\n  const route = match(routes, url);\n  if (route === undefined) {\n    response.writeHead(404).end(\"no route\\n\");\n    return;\n  }\n  const upstream = await fetch(new URL(url.pathname + url.search, route.upstream), {\n    method: request.method,\n    headers: { \"x-forwarded-host\": url.host },\n  });\n  response.writeHead(upstream.status, Object.fromEntries(upstream.headers));\n  response.end(Buffer.from(await upstream.arrayBuffer()));\n}).listen(Number(process.env.PORT ?? 8080));\n\nexport const LOG_ROUTES = true;\n"},"b535c7e338382c5072dbc7a18d07a1c08038b97a":{"size":144,"binary":false,"text":"{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"NodeNext\",\n    \"outDir\": \"dist\",\n    \"strict\": true\n  },\n  \"include\": [\"src\"]\n}\n"},"742744ab360c2f0920976e7abe39819a4b47a3fa":{"size":753,"binary":false,"text":"import { createServer } from \"node:http\";\nimport { match, type Route } from \"./router.js\";\n\nconst routes: Route[] = JSON.parse(process.env.ROUTES ?? \"[]\");\n\ncreateServer(async (request, response) => {\n  const url = new URL(request.url ?? \"/\", `http://${request.headers.host}`);\n  const route = match(routes, url);\n  if (route === undefined) {\n    response.writeHead(404).end(\"no route\\n\");\n    return;\n  }\n  const upstream = await fetch(new URL(url.pathname + url.search, route.upstream), {\n    method: request.method,\n    headers: { \"x-forwarded-host\": url.host },\n  });\n  response.writeHead(upstream.status, Object.fromEntries(upstream.headers));\n  response.end(Buffer.from(await upstream.arrayBuffer()));\n}).listen(Number(process.env.PORT ?? 8080));\n"},"fdeb777fc84834b0fc39b02e4e462cc07b73ea70":{"size":186,"binary":false,"text":"# edge-router\n\nRoutes requests at the edge by host and path prefix.\n\n```sh\nROUTES='[{\"host\":\"api.acme.example\",\"prefix\":\"/\",\"upstream\":\"http://10.0.3.14:8080\"}]' node dist/server.js\n```\n"},"20821a32e5ef403fee170e8551d004f4af9cbc62":{"size":293,"binary":false,"text":"const failing = new Set<string>();\n\nexport function markFailing(upstream: string): void {\n  failing.add(upstream);\n}\n\nexport function markHealthy(upstream: string): void {\n  failing.delete(upstream);\n}\n\nexport function isHealthy(upstream: string): boolean {\n  return !failing.has(upstream);\n}\n"},"a9a5072f8f23d1e1d56293697f33520bb994ecf1":{"size":672,"binary":false,"text":"export interface Route {\n  readonly host: string;\n  readonly prefix: string;\n  readonly upstream: string;\n  readonly weight?: number;\n}\n\n/** The longest matching prefix wins; ties go to the heavier route. */\nexport function match(routes: readonly Route[], url: URL): Route | undefined {\n  let best: Route | undefined;\n  for (const route of routes) {\n    if (route.host !== url.host || !url.pathname.startsWith(route.prefix)) continue;\n    if (\n      best === undefined ||\n      route.prefix.length > best.prefix.length ||\n      (route.prefix.length === best.prefix.length && (route.weight ?? 1) > (best.weight ?? 1))\n    ) {\n      best = route;\n    }\n  }\n  return best;\n}\n"},"b86529666c056731e7b0c59591c3ce22362c7eaa":{"size":201,"binary":false,"text":"{\n  \"name\": \"edge-router\",\n  \"version\": \"0.1.0\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"tsc -p .\",\n    \"test\": \"node --test dist\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^5.6.0\"\n  }\n}\n"},"c62bfa3e60fc21188c697bf3d9383b718a6391f8":{"size":289,"binary":false,"text":"export interface Route {\n  readonly host: string;\n  readonly prefix: string;\n  readonly upstream: string;\n}\n\nexport function match(routes: readonly Route[], url: URL): Route | undefined {\n  return routes.find((route) => route.host === url.host && url.pathname.startsWith(route.prefix));\n}\n"}},"blame":{"066e9d4426d7688fad2e1e1e9777603f98aee8b8:src/server.ts":[[1,19,"3085c0aaac07bb5719ec5ed057122cfa9650afa7",1,"src/server.ts",null],[20,2,"066e9d4426d7688fad2e1e1e9777603f98aee8b8",20,"src/server.ts","561dceeceb06a51b0c7d65bcde118d2363f04d7b"]],"561dceeceb06a51b0c7d65bcde118d2363f04d7b:README.md":[[1,7,"d301e5ecfe4543606f74d2a1f7b3b14a196e5cd5",1,"README.md",null],[8,2,"561dceeceb06a51b0c7d65bcde118d2363f04d7b",8,"README.md","01a69f7fc8687dd5a16a3576310a193d63f6132e"]],"01a69f7fc8687dd5a16a3576310a193d63f6132e:src/router.ts":[[1,4,"66326e8a306f3215cd14df8860ff7db61572cfdc",1,"src/router.ts",null],[5,1,"77054e8a93d482435d7f6525cf6a3fa181993e4e",5,"src/router.ts","3085c0aaac07bb5719ec5ed057122cfa9650afa7"],[6,2,"66326e8a306f3215cd14df8860ff7db61572cfdc",5,"src/router.ts",null],[8,1,"77054e8a93d482435d7f6525cf6a3fa181993e4e",8,"src/router.ts","3085c0aaac07bb5719ec5ed057122cfa9650afa7"],[9,1,"66326e8a306f3215cd14df8860ff7db61572cfdc",7,"src/route