,"20821a32e5ef403fee170e8551d004f4af9cbc62":{"size":293,"binary":false,"text":"const failing = new Set<string>();\n\nexport function markFailing(upstream: string): void {\n  failing.add(upstream);\n}\n\nexport function markHealthy(upstream: string): void {\n  failing.delete(upstream);\n}\n\nexport function isHealthy(upstream: string): boolean {\n  return !failing.has(upstream);\n}\n"},"a9a5072f8f23d1e1d56293697f33520bb994ecf1":{"size":672,"binary":false,"text":"export interface Route {\n  readonly host: string;\n  readonly prefix: string;\n  readonly upstream: string;\n  readonly weight?: number;\n}\n\n/** The longest matching prefix wins; ties go to the heavier route. */\nexport function match(routes: readonly Route[], url: URL): Route | undefined {\n  let best: Route | undefined;\n  for (const route of routes) {\n    if (route.host !== url.host || !url.pathname.startsWith(route.prefix)) continue;\n    if (\n      best === undefined ||\n      route.prefix.length > best.prefix.length ||\n      (route.prefix.length === best.prefix.length && (route.weight ?? 1) > (best.weight ?? 1))\n    ) {\n      best = route;\n    }\n  }\n  return best;\n}\n"},"742744ab360c2f0920976e7abe39819a4b47a3fa":{"size":753,"binary":false,"text":"import { createServer } from \"node:http\";\nimport { match, type Route } from \"./router.js\";\n\nconst routes: Route[] = JSON.parse(process.env.ROUTES ?? \"[]\");\n\ncreateServer(async (request, response) => {\n  const url = new URL(request.url ?? \"/\", `http://${request.headers.host}`);\n  const route = match(routes, url);\n  if (route === undefined) {\n    response.writeHead(404).end(\"no route\\n\");\n    return;\n  }\n  const upstream = await fetch(new URL(url.pathname + url.search, route.upstream), {\n    method: request.method,\n    headers: { \"x-forwarded-host\": url.host },\n  });\n  response.writeHead(upstream.status, Object.fromEntries(upstream.headers));\n  response.end(Buffer.from(await upstream.arrayBuffer()));\n}).listen(Number(process.env.PORT ?? 8080));\n"},"b535c7e338382c5072dbc7a18d07a1c08038b97a":{"size":144,"binary":false,"text":"{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"NodeNext\",\n    \"outDir\": \"dist\",\n    \"strict\": true\n  },\n  \"include\": [\"src\"]\n}\n"},"b86529666c056731e7b0c59591c3ce22362c7eaa":{"size":201,"binary":false,"text":"{\n  \"name\": \"edge-router\",\n  \"version\": \"0.1.0\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build\": \"tsc -p .\",\n    \"test\": \"node --test dist\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^5.6.0\"\n  }\n}\n"},"c62bfa3e60fc21188c697bf3d9383b718a6391f8":{"size":289,"binary":false,"text":"export interface Route {\n  readonly host: string;\n  readonly prefix: string;\n  readonly upstream: string;\n}\n\nexport function match(routes: readonly Route[], url: URL): Route | undefined {\n  return routes.find((route) => route.host === url.host && url.pathname.startsWith(route.prefix));\n}\n"}},"blame":{"7d2de860e6836893f5b6276e06adae120d5ec82f:src/health.ts":[[1,13,"7d2de860e6836893f5b6276e06adae120d5ec82f",1,"src/health.ts",null]],"77054e8a93d482435d7f6525cf6a3fa181993e4e:package.json":[[1,2,"d301e5ecfe4543606f74d2a1f7b3b14a196e5cd5",1,"package.json",null],[3,1,"77054e8a93d482435d7f6525cf6a3fa181993e4e",3,"package.json","3085c0aaac07bb5719ec5ed057122cfa9650afa7"],[4,9,"d301e5ecfe4543606f74d2a1f7b3b14a196e5cd5",4,"package.json",null]],"77054e8a93d482435d7f6525cf6a3fa181993e4e:src/router.ts":[[1,4,"66326e8a306f3215cd14df8860ff7db61572cfdc",1,"src/router.ts",null],[5,1,"77054e8a93d482435d7f6525cf6a3fa181993e4e",5,"src/router.ts","3085c0aaac07bb5719ec5ed057122cfa9650afa7"],[6,2,"66326e8a306f3215cd14df8860ff7db61572cfdc",5,"src/router.ts",null],[8,1,"77054e8a93d482435d7f6525cf6a3fa181993e4e",8,"src/router.ts","3085c0aaac07bb5719ec5ed057122cfa9650afa7"],[9,1,"66326e8a306f3215cd14df8860ff7db61572cfdc",7,"src/router.ts",null],[10,12,"77054e8a93d482435d7f6525cf6a3fa181993e4e",10,"src/router.ts","3