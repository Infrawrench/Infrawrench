# The built UI's own files, which the asset layer serves without the Worker
# (`run_worker_first` in git/packages/worker/wrangler.jsonc). They carry what
# the Worker puts on every answer that is not a page
# (worker/src/http/security-headers.ts); the Worker's
# src/http/__tests__/static-headers.test.ts fails when the two differ.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Security-Policy: default-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains

