diff --git a/openbsd-compat/bsd-poll.c b/openbsd-compat/bsd-poll.c
index 967f947..ee55b63 100644
--- a/openbsd-compat/bsd-poll.c
+++ b/openbsd-compat/bsd-poll.c
@@ -32,7 +32,73 @@
 #include <unistd.h>
 #include "bsd-poll.h"
 
-#if !defined(HAVE_PPOLL) || defined(BROKEN_POLL)
+#if !defined(HAVE_PPOLL) && defined(__wasi__)
+/*
+ * ppoll(2) for WASIX, on its poll(2). Its C library has no pselect(2) to
+ * build one on (a stub that fails with ENOSYS, which failed every
+ * connection), and its poll(2) fails with ENOSYS for an entry that asks
+ * for neither POLLIN nor POLLOUT, which ssh's channel loop passes for a
+ * channel with nothing to wait for: such an entry is left out, as if its
+ * fd were -1 (it could only report POLLHUP or POLLERR, which WASIX's poll
+ * cannot see without POLLIN or POLLOUT anyway). The signal mask is
+ * swapped around the poll, as close as WASIX comes: signals reach a
+ * process between its calls.
+ */
+#include <limits.h>
+#include <poll.h>
+
+int
+ppoll(struct pollfd *fds, nfds_t nfds, const struct timespec *tmoutp,
+    const sigset_t *sigmask)
+{
+	sigset_t osigmask;
+	nfds_t i;
+	int ret, saved_errno, timeout = -1;
+	int *skipped = NULL;
+
+	if (tmoutp != NULL) {
+		if (tmoutp->tv_sec < 0 || tmoutp->tv_nsec < 0 ||
+		    tmoutp->tv_nsec >= 1000000000) {
+			errno = EINVAL;
+			return -1;
+		}
+		if (tmoutp->tv_sec >= INT_MAX / 1000 - 1)
+			timeout = INT_MAX;
+		else	/* rounded up, so a short wait does not spin */
+			timeout = tmoutp->tv_sec * 1000 +
+			    (tmoutp->tv_nsec + 999999) / 1000000;
+	}
+	for (i = 0; i < nfds; i++) {
+		fds[i].revents = 0;
+		if (fds[i].fd < 0 || (fds[i].events & (POLLIN|POLLOUT)) != 0)
+			continue;
+		if (skipped == NULL &&
+		    (skipped = calloc(nfds, sizeof(*skipped))) == NULL)
+			return -1;
+		skipped[i] = fds[i].fd + 1;
+		fds[i].fd = -1;
+	}
+	if (sigmask != NULL &&
+	    sigprocmask(SIG_SETMASK, sigmask, &osigmask) == -1) {
+		ret = -1;
+		saved_errno = errno;
+	} else {
+		ret = poll(fds, nfds, timeout);
+		saved_errno = errno;
+		if (sigmask != NULL)
+			sigprocmask(SIG_SETMASK, &osigmask, NULL);
+	}
+	if (skipped != NULL) {
+		for (i = 0; i < nfds; i++) {
+			if (skipped[i] != 0)
+				fds[i].fd = skipped[i] - 1;
+		}
+		free(skipped);
+	}
+	errno = saved_errno;
+	return ret;
+}
+#elif !defined(HAVE_PPOLL) || defined(BROKEN_POLL)
 /*
  * A minimal implementation of ppoll(2), built on top of pselect(2).
  *
