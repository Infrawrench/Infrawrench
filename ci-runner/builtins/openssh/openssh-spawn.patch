--- a/misc.c
+++ b/misc.c
@@ -66,6 +66,11 @@
 #include "ssherr.h"
 #include "platform.h"
 
+#ifdef __wasi__
+#include <spawn.h>
+extern char **environ;
+#endif
+
 /* remove newline at end of string */
 char *
 chop(char *s)
@@ -3350,3 +3355,54 @@ mkdir_path(const char *target, mode_t mode)
 	return ret;
 #endif
 }
+
+#ifdef __wasi__
+/*
+ * WASIX built with wasm exception handling has no fork(), so the programs
+ * start a child with posix_spawn() where they would fork and exec: `file`
+ * (looked up on PATH unless it has a slash) with `argv`, its stdin and
+ * stdout duplicated from `in` and `out` (-1 leaves the parent's), then the
+ * descriptors in `closefds` (ending with -1) closed, as the forked child
+ * did before its exec. Only descriptors that are open may be named: WASIX
+ * fails the spawn on closing one that is not. Returns the child's pid, or
+ * -1 with errno set.
+ */
+pid_t
+spawn_command(const char *file, char *const argv[], int in, int out,
+    const int *closefds)
+{
+	posix_spawn_file_actions_t actions;
+	pid_t pid;
+	int r;
+
+	if ((r = posix_spawn_file_actions_init(&actions)) != 0) {
+		errno = r;
+		return -1;
+	}
+	if (in != -1 && in != STDIN_FILENO)
+		r = posix_spawn_file_actions_adddup2(&actions, in,
+		    STDIN_FILENO);
+	if (r == 0 && out != -1 && out != STDOUT_FILENO)
+		r = posix_spawn_file_actions_adddup2(&actions, out,
+		    STDOUT_FILENO);
+	for (; r == 0 && closefds != NULL && *closefds != -1; closefds++) {
+		if (*closefds > STDERR_FILENO)
+			r = posix_spawn_file_actions_addclose(&actions,
+			    *closefds);
+	}
+	if (r == 0) {
+		if (strchr(file, '/') != NULL)
+			r = posix_spawn(&pid, file, &actions, NULL, argv,
+			    environ);
+		else
+			r = posix_spawnp(&pid, file, &actions, NULL, argv,
+			    environ);
+	}
+	posix_spawn_file_actions_destroy(&actions);
+	if (r != 0) {
+		errno = r;
+		return -1;
+	}
+	return pid;
+}
+#endif /* __wasi__ */
