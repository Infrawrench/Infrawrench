+// An exception line as Node's GetErrorSource makes it: the file and line,
+// the source line and the underline, ending in one newline. Lines from the
+// engine's bridge end in two, and a line marked
+// node-do-not-add-exception-line is no exception line at all.
+std::string NodeExceptionLine(std::string line) {
+  if (line.find("node-do-not-add-exception-line") != std::string::npos) return {};
+  while (!line.empty() && line.back() == '\n') line.pop_back();
+  if (line.empty()) return {};
+  line.push_back('\n');
+  return line;
+}
