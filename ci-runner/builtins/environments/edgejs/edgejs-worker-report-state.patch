@@ -254,6 +257,13 @@ void CompleteWorkerReportTask(WorkerReportTask* task, std::string json) {
       task->state->pending -= 1;
     }
   }
+  // The collector may see `pending` reach 0 as soon as the lock is let go
+  // (woken by an earlier report, or spuriously) and return. The state was a
+  // local of its frame, so this notify_one then signalled a condition
+  // variable in a frame that was gone, and musl's signal followed its waiter
+  // list through whatever that stack held by then, writing into it (the
+  // collector's stack) or faulting on it (`out of bounds memory access`).
+  // The task holds the state now, so it outlives this signal.
   task->state->cv.notify_one();
   delete task;
 }
