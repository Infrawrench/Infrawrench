+    // The mode goes to the host, for a file this call creates.
+    va_list ap;
+    va_start(ap, oflag);
+    mode_t mode = va_arg(ap, mode_t);
+    va_end(ap);
+    int existed = 0;
+    if ((oflag & O_EXCL) == 0) {
+        char *relative_path;
+        int dirfd = find_relpath(path, &relative_path);
+        struct stat st;
+        int saved_errno = errno;
+        existed = dirfd != -1 &&
+                  __wasilibc_nocwd_fstatat(dirfd, relative_path, &st, 0) == 0;
+        errno = saved_errno;
+    }
+    int fd = __wasilibc_open_nomode(path, oflag);
+    if (fd != -1 && !existed && iwci_present()) {
+        iwci_created_mode(path, mode, IWCI_DEFAULT_FILE_MODE);
+        iwci_remember_created(fd, path);
+    }
+    return fd;
