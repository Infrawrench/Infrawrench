+// Asks a worker's thread to run callback(env, data) between turns. Under the
+// worker's mutex for the whole request, as RequestWorkerStop is: the worker
+// thread clears its env under the same mutex before it frees it, so the env
+// cannot be freed while this uses it. Reading the env and letting go of the
+// mutex first let a worker ending by itself free its Environment in between,
+// and the request then locked a mutex in freed memory. napi_invalid_arg when
+// the worker has no env (not started yet, or already ending).
+napi_status RequestWorkerInterrupt(Worker* worker, unofficial_napi_interrupt_callback callback, void* data) {
+  std::lock_guard<std::mutex> lock(worker->mutex);
+  napi_env worker_env = worker->thread_data != nullptr ? worker->thread_data->env : nullptr;
+  if (worker_env == nullptr) return napi_invalid_arg;
+  if (auto* environment = EdgeEnvironmentGet(worker_env); environment != nullptr) {
+    return environment->RequestInterrupt(callback, data);
+  }
+  return unofficial_napi_request_interrupt(worker_env, callback, data);
+}
