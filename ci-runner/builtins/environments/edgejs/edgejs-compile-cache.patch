+#ifndef EDGE_COMPILE_CACHE_H_
+#define EDGE_COMPILE_CACHE_H_
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "edge_bytecode_cache.h"
+#include "unofficial_napi.h"
+
+// Node's module compile cache (`NODE_COMPILE_CACHE`, `module.enableCompileCache()`),
+// for the engine N-API imports from its host. CommonJS and ES modules compiled
+// by the default loaders are looked up in a directory and the engine's code
+// cache for them is written there, so the next process compiles nothing it
+// has compiled before. Transpiled TypeScript is kept the same way, as Node
+// does, for a build that strips types (this one answers ERR_NO_TYPESCRIPT).
+//
+// Layout, as Node's: <dir>/<tag>/<entry>, where <tag> names this Node
+// version, the engine's code cache version and flags, and the user, so a
+// cache from another engine build or other flags is never even read (and
+// the engine refuses one anyway), and <entry> is a hash of the module's file
+// name (relative to the cache directory with NODE_COMPILE_CACHE_PORTABLE=1)
+// and its kind. Each entry carries the size and hash of the source it was
+// compiled from and of its payload, so a changed file or a damaged entry is
+// a miss, and a miss or a rejected entry costs only the compile it would have
+// done anyway. Entries are written as they are made, so `flushCompileCache()`
+// has nothing left to do, and a process that does not exit normally keeps
+// what it compiled.
+//
+// The state is per thread, which is per Edge.js environment: the main thread
+// and each Worker enable their own, as each Node environment does.
+namespace edge_compile_cache {
+
+// Node's CachedCodeType.
+enum class CodeType : uint8_t {
+  kCommonJS = 0,
+  kESM = 1,
+  kStrippedTypeScript = 2,
+  kTransformedTypeScript = 3,
+  kTransformedTypeScriptWithSourceMaps = 4,
+};
+
+// Node's CompileCacheEnableStatus.
+enum class EnableStatus : int32_t {
+  kFailed = 0,
+  kEnabled = 1,
+  kAlreadyEnabled = 2,
+  kDisabled = 3,
+};
+
+struct EnableResult {
+  EnableStatus status = EnableStatus::kFailed;
+  std::string message;
+  std::string directory;
+};
+
+// Enables the cache from NODE_COMPILE_CACHE (and NODE_COMPILE_CACHE_PORTABLE)
+// as Node does at start-up, once per environment; a failure leaves it off and
+// is only reported with NODE_DEBUG_NATIVE=COMPILE_CACHE.
+void InitializeFromEnvironment(napi_env env);
+
+// module.enableCompileCache(dir, portable). NODE_DISABLE_COMPILE_CACHE wins.
+EnableResult Enable(napi_env env, const std::string& dir, bool portable);
+
+bool Active();
+
+// <dir>/<tag> while active, else empty (module.getCompileCacheDir()).
+const std::string& Directory();
+
+struct Entry {
+  std::string cache_path;
+  std::string source_filename;
+  CodeType type = CodeType::kCommonJS;
+  uint64_t code_size = 0;
+  uint64_t code_hash = 0;
+};
+
+// The entry for `filename` compiled from `source` as `type`. False when the
+// cache is off or the file name is not one a module is cached under (not an
+// absolute path or file: URL: [eval], the REPL, data: URLs).
+bool Prepare(const std::string& filename, std::string_view source, CodeType type, Entry* entry);
+
+// Reads the entry's payload: false (and an empty payload) unless the file is
+// one this writes, compiled from exactly this source, and undamaged.
+bool Read(const Entry& entry, edge_bytecode_cache::SidecarPayload* out);
+
+// Replaces the entry; failures (a read-only directory, no space, another
+// process writing it) are silent, as in Node.
+void Save(const Entry& entry, const uint8_t* payload, size_t size);
+
+// Reports what the engine did with an entry, as Node's debug output does.
+void ReportCompiled(const Entry& entry, bool had_cache, bool rejected);
+
+}  // namespace edge_compile_cache
+
+#endif  // EDGE_COMPILE_CACHE_H_
