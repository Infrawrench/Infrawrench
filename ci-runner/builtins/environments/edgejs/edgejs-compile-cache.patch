+++ b/src/edge_compile_cache.cc
@@ -0,0 +1,364 @@
+#include "edge_compile_cache.h"
+
+#include <cctype>
+#include <cerrno>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <string>
+#include <system_error>
+#include <vector>
+
+#include <fcntl.h>
+#include <unistd.h>
+
+#include "edge_buffer_lease.h"
+#include "edge_bytecode.h"
+#include "edge_bytecode_io.h"
+#include "edge_path.h"
+#include "node_version.h"
+#include "unofficial_napi.h"
+
+namespace edge_compile_cache {
+namespace {
+
+namespace fs = std::filesystem;
+using edge_bytecode_cache::Hash64;
+using edge_bytecode_cache::io::ReadU32;
+using edge_bytecode_cache::io::ReadU64;
+using edge_bytecode_cache::io::WriteU32;
+using edge_bytecode_cache::io::WriteU64;
+
+// An entry file:
+//   [0, 8)   magic
+//   [8, 12)  format version
+//   [12, 16) code type
+//   [16, 24) source size (UTF-8 bytes)
+//   [24, 32) source hash (XXH3-64 of the UTF-8 source)
+//   [32, 40) payload size
+//   [40, 48) payload hash (XXH3-64): V8 does not check its own checksum of
+//            a code cache in a release build, so a damaged payload would
+//            otherwise reach the deserializer
+//   [48, ...) payload: the engine's code cache, or transpiled TypeScript
+constexpr char kMagic[8] = {'E', 'D', 'G', 'E', 'N', 'C', 'C', '1'};
+constexpr uint32_t kFormatVersion = 1;
+constexpr size_t kHeaderSize = 48;
+
+struct State {
+  bool initialized = false;
+  bool active = false;
+  bool portable = false;
+  std::string dir;  // <dir>/<tag>
+};
+
+thread_local State g_state;
+
+bool DebugEnabled() {
+  static const bool enabled = [] {
+    const char* value = std::getenv("NODE_DEBUG_NATIVE");
+    if (value == nullptr) return false;
+    std::string upper(value);
+    for (char& ch : upper) ch = static_cast<char>(std::toupper(static_cast<unsigned char>(ch)));
+    size_t start = 0;
+    while (start <= upper.size()) {
+      size_t end = upper.find(',', start);
+      if (end == std::string::npos) end = upper.size();
+      if (upper.compare(start, end - start, "COMPILE_CACHE") == 0) return true;
+      start = end + 1;
+    }
+    return false;
+  }();
+  return enabled;
+}
+
+void Debug(const char* format, ...) {
+  if (!DebugEnabled()) return;
+  va_list args;
+  va_start(args, format);
+  std::vfprintf(stderr, format, args);
+  va_end(args);
+}
+
+const char* TypeName(CodeType type) {
+  switch (type) {
+    case CodeType::kCommonJS:
+      return "CommonJS";
+    case CodeType::kESM:
+      return "ESM";
+    case CodeType::kStrippedTypeScript:
+      return "StrippedTypeScript";
+    case CodeType::kTransformedTypeScript:
+      return "TransformedTypeScript";
+    case CodeType::kTransformedTypeScriptWithSourceMaps:
+      return "TransformedTypeScriptWithSourceMaps";
+  }
+  return "unknown";
+}
+
+std::string Hex(uint64_t value, int digits) {
+  static const char kDigits[] = "0123456789abcdef";
+  std::string out(static_cast<size_t>(digits), '0');
+  for (int i = digits - 1; i >= 0; --i) {
+    out[static_cast<size_t>(i)] = kDigits[value & 0xf];
+    value >>= 4;
+  }
+  return out;
+}
+
+// What V8 checks before it takes a code cache, read from the header of one
+// it makes: the magic number (which counts the external references), the
+// version hash, the flag hash and the read-only snapshot checksum (the
+// source hash between them is the source's length). N-API offers nothing
+// like ScriptCompiler::CachedDataVersionTag(), which Node names its
+// directories by; a layout this does not expect only names the directory
+// less precisely, since V8 still refuses a cache it did not write.
+bool EngineVersionTag(napi_env env, uint32_t* out) {
+  napi_value code = nullptr;
+  napi_value filename = nullptr;
+  if (napi_create_string_utf8(env, "0", NAPI_AUTO_LENGTH, &code) != napi_ok ||
+      napi_create_string_utf8(env, "[compile cache]", NAPI_AUTO_LENGTH, &filename) != napi_ok) {
+    return false;
+  }
+  EdgeBytecode bytecode;
+  if (bytecode.Open(env, code, filename, unofficial_napi_bytecode_shape_script, nullptr, nullptr, 0, 0) !=
+          napi_ok ||
+      !bytecode) {
+    bool pending = false;
+    napi_value ignored = nullptr;
+    if (napi_is_exception_pending(env, &pending) == napi_ok && pending) {
+      (void)napi_get_and_clear_last_exception(env, &ignored);
+    }
+    return false;
+  }
+  napi_value buffer = nullptr;
+  if (bytecode.Serialize(&buffer) != napi_ok || buffer == nullptr) return false;
+  EdgeBufferLease bytes;
+  if (!bytes.Acquire(env, buffer, unofficial_napi_buffer_access_read) || bytes.size() < 20) return false;
+  uint8_t key[16];
+  std::memcpy(key, bytes.data(), 8);
+  std::memcpy(key + 8, bytes.data() + 12, 8);
+  const uint64_t hash = Hash64(key, sizeof(key));
+  *out = static_cast<uint32_t>(hash ^ (hash >> 32));
+  return true;
+}
+
+// Node's is $NODE_VERSION-$ARCH-$CACHED_DATA_VERSION_TAG-$UID.
+bool VersionTag(napi_env env, bool portable, std::string* out) {
+  uint32_t engine = 0;
+  if (!EngineVersionTag(env, &engine)) return false;
+  *out = std::string(NODE_VERSION) + "-wasm32-" + Hex(engine, 8);
+  // A portable cache is meant for other users too (Node 24.12).
+  if (!portable) *out += "-" + std::to_string(static_cast<unsigned long>(getuid()));
+  return true;
+}
+
+std::string WithoutTrailingSeparators(std::string path) {
+  while (path.size() > 1 && path.back() == '/') path.pop_back();
+  return path;
+}
+
+}  // namespace
+
+void InitializeFromEnvironment(napi_env env) {
+  State& state = g_state;
+  if (state.initialized) return;
+  state.initialized = true;
+  const char* dir = std::getenv("NODE_COMPILE_CACHE");
+  if (dir == nullptr || dir[0] == '\0') return;
+  const char* portable_value = std::getenv("NODE_COMPILE_CACHE_PORTABLE");
+  const bool portable = portable_value != nullptr && std::strcmp(portable_value, "1") == 0;
+  if (portable) Debug("[compile cache] using relative path\n");
+  const EnableResult result = Enable(env, dir, portable);
+  if (!result.message.empty()) Debug("[compile cache] %s\n", result.message.c_str());
+}
+
+EnableResult Enable(napi_env env, const std::string& dir, bool portable) {
+  State& state = g_state;
+  state.initialized = true;
+  EnableResult result;
+  if (std::getenv("NODE_DISABLE_COMPILE_CACHE") != nullptr) {
+    result.status = EnableStatus::kDisabled;
+    result.message = "Disabled by NODE_DISABLE_COMPILE_CACHE";
+    Debug("[compile cache] %s.\n", result.message.c_str());
+    return result;
+  }
+  if (state.active) {
+    result.status = EnableStatus::kAlreadyEnabled;
+    result.directory = state.dir;
+    return result;
+  }
+
+  std::string tag;
+  if (!VersionTag(env, portable, &tag)) {
+    result.status = EnableStatus::kFailed;
+    result.message = "Cannot read the engine's code cache version";
+    return result;
+  }
+  std::error_code ec;
+  fs::path base = dir.empty() ? fs::current_path(ec) : fs::absolute(fs::path(dir), ec);
+  if (ec) {
+    result.status = EnableStatus::kFailed;
+    result.message = "Cannot resolve cache directory: " + ec.message();
+    return result;
+  }
+  const std::string base_dir = WithoutTrailingSeparators(base.lexically_normal().string());
+  const std::string dir_with_tag = base_dir + "/" + tag;
+  Debug("[compile cache] resolved path %s + %s -> %s\n", dir.c_str(), tag.c_str(), dir_with_tag.c_str());
+
+  fs::create_directories(dir_with_tag, ec);
+  Debug("[compile cache] creating cache directory %s...%s\n",
+        dir_with_tag.c_str(),
+        ec ? ec.message().c_str() : "success");
+  if (ec) {
+    std::error_code dir_ec;
+    if (!fs::is_directory(dir_with_tag, dir_ec)) {
+      result.status = EnableStatus::kFailed;
+      result.message = "Cannot create cache directory: " + ec.message();
+      return result;
+    }
+  }
+
+  state.active = true;
+  state.portable = portable;
+  state.dir = dir_with_tag;
+  result.status = EnableStatus::kEnabled;
+  result.directory = base_dir;
+  return result;
+}
+
+bool Active() {
+  return g_state.active;
+}
+
+const std::string& Directory() {
+  static const std::string empty;
+  return g_state.active ? g_state.dir : empty;
+}
+
+bool Prepare(const std::string& filename, std::string_view source, CodeType type, Entry* entry) {
+  const State& state = g_state;
+  if (!state.active || entry == nullptr) return false;
+  // Only modules read from files: an absolute path (CommonJS) or a file:
+  // URL (ES modules), never [eval], the REPL or a data: URL.
+  if (filename.empty() || (filename[0] != '/' && filename.rfind("file://", 0) != 0)) return false;
+  std::string path = edge_path::NormalizeFileURLOrPath(filename);
+  if (path.empty() || path[0] != '/') return false;
+  std::string key = path;
+  if (state.portable) {
+    const std::string relative = fs::path(path).lexically_relative(fs::path(state.dir)).string();
+    if (!relative.empty()) {
+      key = relative;
+      Debug("[compile cache] using relative path %s from %s\n", key.c_str(), state.dir.c_str());
+    }
+  }
+  std::string keyed;
+  keyed.reserve(key.size() + 1);
+  keyed.push_back(static_cast<char>(type));
+  keyed += key;
+  entry->cache_path = state.dir + "/" + Hex(Hash64(keyed.data(), keyed.size()), 16);
+  entry->source_filename = filename;
+  entry->type = type;
+  entry->code_size = source.size();
+  entry->code_hash = Hash64(source.data(), source.size());
+  return true;
+}
+
+bool Read(const Entry& entry, edge_bytecode_cache::SidecarPayload* out) {
+  out->file_bytes.clear();
+  out->payload_offset = 0;
+  out->payload_size = 0;
+  Debug("[compile cache] reading cache from %s for %s %s...",
+        entry.cache_path.c_str(),
+        TypeName(entry.type),
+        entry.source_filename.c_str());
+  if (!edge_bytecode_cache::io::ReadFileFully(entry.cache_path, &out->file_bytes)) {
+    Debug(" no entry\n");
+    return false;
+  }
+  const uint8_t* data = out->file_bytes.data();
+  const size_t size = out->file_bytes.size();
+  const char* mismatch = nullptr;
+  if (size < kHeaderSize || std::memcmp(data, kMagic, sizeof(kMagic)) != 0 ||
+      ReadU32(data, 8) != kFormatVersion) {
+    mismatch = "not an entry of this format";
+  } else if (ReadU32(data, 12) != static_cast<uint32_t>(entry.type)) {
+    mismatch = "code type mismatch";
+  } else if (ReadU64(data, 16) != entry.code_size) {
+    mismatch = "code size mismatch";
+  } else if (ReadU64(data, 24) != entry.code_hash) {
+    mismatch = "code hash mismatch";
+  } else if (ReadU64(data, 32) != size - kHeaderSize) {
+    mismatch = "cache size mismatch";
+  } else if (ReadU64(data, 40) != Hash64(data + kHeaderSize, size - kHeaderSize)) {
+    mismatch = "cache hash mismatch";
+  } else if (size == kHeaderSize) {
+    mismatch = "empty cache";
+  }
+  if (mismatch != nullptr) {
+    Debug(" %s\n", mismatch);
+    out->file_bytes.clear();
+    return false;
+  }
+  out->payload_offset = kHeaderSize;
+  out->payload_size = size - kHeaderSize;
+  Debug(" success, size=%zu\n", out->payload_size);
+  return true;
+}
+
+void Save(const Entry& entry, const uint8_t* payload, size_t size) {
+  if (payload == nullptr || size == 0) return;
+  std::vector<uint8_t> contents(kHeaderSize + size);
+  std::memcpy(contents.data(), kMagic, sizeof(kMagic));
+  WriteU32(&contents, 8, kFormatVersion);
+  WriteU32(&contents, 12, static_cast<uint32_t>(entry.type));
+  WriteU64(&contents, 16, entry.code_size);
+  WriteU64(&contents, 24, entry.code_hash);
+  WriteU64(&contents, 32, size);
+  WriteU64(&contents, 40, Hash64(payload, size));
+  std::memcpy(contents.data() + kHeaderSize, payload, size);
+
+  // Written in place rather than to a temporary file and renamed: renames
+  // onto one name from two threads at once abort the iwci runner (#1092),
+  // and a test runner's workers all write the same entries. The stale or
+  // refused entry goes first; then only one writer can create the file, and
+  // a reader that meets one half written finds its hashes wrong and takes
+  // it for a miss.
+  Debug("[compile cache] writing cache for %s %s to %s...",
+        TypeName(entry.type),
+        entry.source_filename.c_str(),
+        entry.cache_path.c_str());
+  std::error_code ec;
+  fs::remove(entry.cache_path, ec);
+  const int fd = open(entry.cache_path.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0666);
+  if (fd < 0) {
+    Debug("failed: %s\n", std::strerror(errno));
+    return;
+  }
+  size_t written = 0;
+  while (written < contents.size()) {
+    const ssize_t n = write(fd, contents.data() + written, contents.size() - written);
+    if (n < 0 && errno == EINTR) continue;
+    if (n <= 0) break;
+    written += static_cast<size_t>(n);
+  }
+  const int write_errno = errno;
+  close(fd);
+  if (written != contents.size()) {
+    Debug("failed: %s\n", std::strerror(write_errno));
+    fs::remove(entry.cache_path, ec);
+    return;
+  }
+  Debug("success\n");
+}
+
+void ReportCompiled(const Entry& entry, bool had_cache, bool rejected) {
+  Debug("[compile cache] V8 code cache for %s %s was %s, %s\n",
+        TypeName(entry.type),
+        entry.source_filename.c_str(),
+        rejected ? "rejected" : (had_cache ? "accepted" : "not initialized"),
+        had_cache && !rejected ? "keeping the entry" : (had_cache ? "refreshing the entry" : "writing an entry"));
+}
+
+}  // namespace edge_compile_cache
