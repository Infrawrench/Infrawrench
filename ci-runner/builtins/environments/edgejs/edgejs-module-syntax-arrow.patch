+// Whether the engine gave this error its arrow (`node:arrowMessage`): the
+// file and line, the source line and a caret under the error, which the
+// fatal exception handler prints above the stack, as Node's does.
+bool HasArrowMessage(napi_env env, napi_value err) {
+  napi_value util = edge::binding_registry::Get(env, "util");
+  napi_value private_symbols = nullptr;
+  napi_value arrow_symbol = nullptr;
+  napi_value arrow = nullptr;
+  napi_valuetype type = napi_undefined;
+  return util != nullptr && GetNamedProperty(env, util, "privateSymbols", &private_symbols) &&
+         private_symbols != nullptr &&
+         GetNamedProperty(env, private_symbols, "arrow_message_private_symbol", &arrow_symbol) &&
+         arrow_symbol != nullptr && napi_get_property(env, err, arrow_symbol, &arrow) == napi_ok &&
+         arrow != nullptr && napi_typeof(env, arrow, &type) == napi_ok && type == napi_string;
+}
