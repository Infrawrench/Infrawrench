+bool InitCloneCopies(napi_env env, CloneCopies* copies) {
+  copies->map = CreateGlobalInstance(env, "Map");
+  if (copies->map == nullptr) return false;
+  copies->get = GetNamed(env, copies->map, "get");
+  copies->set = GetNamed(env, copies->map, "set");
+  return IsFunction(env, copies->get) && IsFunction(env, copies->set);
+}
+
+napi_value FindCloneCopy(napi_env env, const CloneCopies* copies, napi_value source) {
+  if (copies == nullptr || copies->map == nullptr) return nullptr;
+  napi_value argv[1] = {source};
+  napi_value out = nullptr;
+  if (napi_call_function(env, copies->map, copies->get, 1, argv, &out) != napi_ok) {
+    ClearPendingException(env);
+    return nullptr;
+  }
+  return out == nullptr || IsNullOrUndefinedValue(env, out) ? nullptr : out;
