+/**
+ * Whether V8's serializer alone clones `value` as Node's structuredClone
+ * would: it holds only primitives, plain objects, arrays, maps, sets, dates,
+ * regular expressions and buffers, no getters, proxies or objects marked
+ * with a transfer mode. The native clone copies everything else through
+ * N-API first, to stand in for host objects and transferables, which is
+ * slow and runs out of handles on a large value.
+ * @param {any} value
+ * @returns {boolean}
+ */
+function isPlainCloneData(value) {
+  const stack = [];
+  const add = (item) => {
+    if (typeof item === 'object' && item !== null) {
+      ArrayPrototypePush(stack, item);
+      return true;
+    }
+    return typeof item !== 'symbol' && typeof item !== 'function';
+  };
+  if (!add(value)) return false;
+  const seen = new SafeSet();
+  let plain = true;
+  const addEntry = (item, key) => {
+    if (!add(key) || !add(item)) plain = false;
+  };
+  const addItem = (item) => {
+    if (!add(item)) plain = false;
+  };
+  while (stack.length > 0 && plain) {
+    const object = ArrayPrototypePop(stack);
+    if (seen.has(object)) continue;
+    seen.add(object);
+    if (isProxy(object) || object[transfer_mode_private_symbol] !== undefined) {
+      return false;
+    }
+    if (isArrayBuffer(object) || isArrayBufferView(object)) continue;
+    const proto = ObjectGetPrototypeOf(object);
+    if (proto === DatePrototype || proto === RegExpPrototype) continue;
+    if (proto === MapPrototype) {
+      MapPrototypeForEach(object, addEntry);
+      continue;
+    }
+    if (proto === SetPrototype) {
+      SetPrototypeForEach(object, addItem);
+      continue;
+    }
+    if (proto !== ObjectPrototype && proto !== null &&
+        (proto !== ArrayPrototype || !ArrayIsArray(object))) {
+      return false;
+    }
+    const keys = ObjectKeys(object);
+    for (let i = 0; i < keys.length; i++) {
+      const descriptor = ObjectGetOwnPropertyDescriptor(object, keys[i]);
+      // A getter is read by the clone itself, once, as Node's does.
+      if (descriptor === undefined || !('value' in descriptor)) return false;
+      if (!add(descriptor.value)) return false;
+    }
+  }
+  return plain;
+}
