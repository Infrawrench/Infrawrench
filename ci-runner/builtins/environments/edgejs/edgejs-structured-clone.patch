+// structuredClone of a value js_transferable.js found to hold only data V8's
+// serializer clones by itself (no host object, transferable, port, getter or
+// proxy, and nothing to transfer): V8 clones it alone, as Node's does. The
+// walks above copy every object through N-API calls first, which costs
+// handles and time with every object, and enough of them fail the clone.
+napi_value CloneValueDirectly(napi_env env, napi_value value) {
+  napi_value cloned = nullptr;
+  if (unofficial_napi_structured_clone(env, value, nullptr, &cloned) != napi_ok || cloned == nullptr) {
+    bool has_pending = false;
+    if (napi_is_exception_pending(env, &has_pending) == napi_ok && has_pending) {
+      return ReadPendingCloneErrorMessage(env, value);
+    }
+    std::string message = DescribeCloneFailureValue(env, value);
+    napi_value err = CreateDataCloneError(
+        env, message.empty() ? "The object could not be cloned." : message.c_str());
+    if (err != nullptr) napi_throw(env, err);
+    return nullptr;
+  }
+  return cloned;
+}
