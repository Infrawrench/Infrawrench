+// The copies one preparation has made so far, by source (a JS Map): an
+// object reached twice is copied once, so the clone keeps the reference
+// shared, and a cycle ends instead of recursing until the stack runs out.
+struct CloneCopies {
+  napi_value map = nullptr;
+  napi_value get = nullptr;
+  napi_value set = nullptr;
+};
