+#if defined(__wasi__)
+// The CPU time this thread has used, in nanoseconds. libuv's
+// uv_getrusage_thread asks getrusage(RUSAGE_THREAD), which the WASIX C
+// library does not have (UV_ENOTSUP), but WASIX has the thread's CPU clock.
+// That clock is the host thread's the guest thread runs on, which may have
+// run other work before this worker, so a worker counts from its start.
+bool ThreadCpuTime(uint64_t* ns) {
+  __wasi_timestamp_t now = 0;
+  if (__wasi_clock_time_get(__WASI_CLOCKID_THREAD_CPUTIME_ID, 1, &now) != __WASI_ERRNO_SUCCESS) {
+    return false;
+  }
+  *ns = static_cast<uint64_t>(now);
+  return true;
+}
+#endif
