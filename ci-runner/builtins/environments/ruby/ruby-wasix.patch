+/* Adds a dup2 action for each [newfd, oldfd] pair of `ary`, in order. When a
+ * later pair reads a descriptor an earlier one replaces (`out: :err, err:
+ * :out`), every source is first duplicated in the parent to a descriptor
+ * above all the pairs name, the child takes its copies from those and closes
+ * them, and the parent closes its own after the spawn. `tmp` gets those
+ * descriptors, -1 where none was made. */
+static int
+spawn_add_dup2(posix_spawn_file_actions_t *fa, VALUE ary, int *tmp, char *errmsg, size_t errmsg_buflen)
+{
+    long i, j, n = RARRAY_LEN(ary);
+    int overlap = 0, maxfd = 2, err;
+
+    for (i = 0; i < n; i++) {
+        int newfd = FIX2INT(RARRAY_AREF(RARRAY_AREF(ary, i), 0));
+        int oldfd = FIX2INT(RARRAY_AREF(RARRAY_AREF(ary, i), 1));
+        tmp[i] = -1;
+        if (newfd > maxfd) maxfd = newfd;
+        if (oldfd > maxfd) maxfd = oldfd;
+        for (j = i + 1; j < n; j++) {
+            if (FIX2INT(RARRAY_AREF(RARRAY_AREF(ary, j), 1)) == newfd) overlap = 1;
+        }
+    }
+    for (i = 0; i < n; i++) {
+        int newfd = FIX2INT(RARRAY_AREF(RARRAY_AREF(ary, i), 0));
+        int oldfd = FIX2INT(RARRAY_AREF(RARRAY_AREF(ary, i), 1));
+        if (overlap) {
+            tmp[i] = fcntl(oldfd, F_DUPFD, maxfd + 1);
+            if (tmp[i] < 0) {
+                ERRMSG("fcntl");
+                return -1;
+            }
+            oldfd = tmp[i];
+        }
+        if ((err = posix_spawn_file_actions_adddup2(fa, oldfd, newfd)) != 0) {
+            errno = err;
+            ERRMSG("posix_spawn_file_actions_adddup2");
+            return -1;
+        }
+    }
+    for (i = 0; i < n; i++) {
+        if (tmp[i] >= 0 && (err = posix_spawn_file_actions_addclose(fa, tmp[i])) != 0) {
+            errno = err;
+            ERRMSG("posix_spawn_file_actions_addclose");
+            return -1;
+        }
+    }
+    return 0;
+}
