+/* fork() for a C library that has none (WASIX without asyncify), which
+   rtapelib.c and misc.c include with SPAWN_WITHOUT_FORK.  It fails with
+   ENOSYS, as fork() does where it is not supported, so what still forks
+   (a remote archive, --to-command, --info-script,
+   --checkpoint-action=exec and the interactive shell) reports "Cannot
+   fork" rather than not building.  */
+#ifndef NOFORK_H
+# define NOFORK_H
+# include <errno.h>
+# include <sys/types.h>
+static inline pid_t
+fork (void) { errno = ENOSYS; return -1; }
+#endif
