From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: iwci <ci@example.com>
Date: Wed, 11 Nov 2026 22:55:46 -0500
Subject: [PATCH 13/13] syscall: pass wasip1 children's arguments and
 environment as arrays

ForkExec joined argv and the environment with line feeds for
proc_spawn2, which splits them again at line feeds, so an argument or an
environment variable with a line feed in it reached the child as several:
`bash -c` given a multi-line script ran its first line, and a test
reading a PEM key from the environment got its first line. Use
proc_spawn3, which takes both as arrays of C strings, as execve does.
A nil ProcAttr is the zero one, as on Unix.
---
 src/syscall/exec_wasip1.go | 121 +++++++++++++++++++++----------------
 1 file changed, 69 insertions(+), 52 deletions(-)

diff --git a/src/syscall/exec_wasip1.go b/src/syscall/exec_wasip1.go
index 79016e9c..ab05498b 100644
--- a/src/syscall/exec_wasip1.go
+++ b/src/syscall/exec_wasip1.go
@@ -151,79 +151,96 @@ func proc_spawn2(
 	ret *int32,
 ) Errno
 
+//go:wasmimport wasix_32v1 proc_spawn3
+//go:noescape
+func proc_spawn3(
+	name unsafe.Pointer,
+	nameLen uint32,
+	args unsafe.Pointer,
+	argsLen uint32,
+	envs unsafe.Pointer,
+	envsLen uint32,
+	fdOps unsafe.Pointer,
+	fdOpsLen uint32,
+	signalActions unsafe.Pointer,
+	signalActionsLen uint32,
+	searchPath uint32,
+	path unsafe.Pointer,
+	pathLen uint32,
+	ret unsafe.Pointer,
+) Errno
+
+// cStringArray lays ss out as proc_spawn3 reads a list: 32-bit pointers to
+// NUL-terminated strings. The strings must outlive the call.
+func cStringArray(ss []string) (ptrs []uint32, keep [][]byte, err error) {
+	// Never empty, so the list has an address even with no strings in it:
+	// a null pointer means "inherit" for the environment.
+	ptrs = make([]uint32, len(ss), len(ss)+1)
+	keep = make([][]byte, len(ss))
+	for i, s := range ss {
+		if bytealg.IndexByteString(s, 0) != -1 {
+			return nil, nil, EINVAL
+		}
+		b := make([]byte, len(s)+1)
+		copy(b, s)
+		keep[i] = b
+		ptrs[i] = uint32(uintptr(unsafe.Pointer(&b[0])))
+	}
+	return ptrs, keep, nil
+}
+
