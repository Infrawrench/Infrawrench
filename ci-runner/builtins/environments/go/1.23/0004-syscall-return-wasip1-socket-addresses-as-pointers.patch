From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: iwci <ci@example.com>
Date: Wed, 11 Nov 2026 21:18:44 -0500
Subject: [PATCH 04/13] syscall: return wasip1 socket addresses as pointers

rawWithPortToSockaddr returned SockaddrInet4 and SockaddrInet6 values,
but package net switches on *SockaddrInet4 and *SockaddrInet6, so
Getsockname matched nothing: Listener.Addr() was nil and
httptest.NewServer panicked on it.
---
 src/syscall/net_wasip1.go | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/syscall/net_wasip1.go b/src/syscall/net_wasip1.go
index a1d280c..a5e45a3 100644
--- a/src/syscall/net_wasip1.go
+++ b/src/syscall/net_wasip1.go
@@ -458,7 +458,7 @@ func rawWithPortToSockaddr(rsa *RawSockaddrWithPortAny) (Sockaddr, error) {
 		// IPv4 address: octs[2..6)
 		copy(sa.Addr[:], rsa.Octets[2:6])
 
-		return sa, nil
+		return &sa, nil
 
 	case AF_INET6:
 		var sa SockaddrInet6
@@ -472,7 +472,7 @@ func rawWithPortToSockaddr(rsa *RawSockaddrWithPortAny) (Sockaddr, error) {
 		// ZoneId is not encoded in __wasi_addr_port_t
 		sa.ZoneId = 0
 
-		return sa, nil
+		return &sa, nil
 
 	default:
 		// Write(1, []byte("rawWithPortToSockaddr: Unknown tag="+itoa.Itoa(int(rsa.Tag))+"\n"))
