From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: iwci <ci@example.com>
Date: Wed, 11 Nov 2026 21:25:53 -0500
Subject: [PATCH 08/13] syscall: compare with a NUL byte, not string(0)

`go vet std` stops on removeNullByte: string(0) converts an integer to a
one-rune string, which the stringintconv check rejects.
---
 src/syscall/fs_wasip1.go | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/syscall/fs_wasip1.go b/src/syscall/fs_wasip1.go
index 1b3d0ad..9e1a36e 100644
--- a/src/syscall/fs_wasip1.go
+++ b/src/syscall/fs_wasip1.go
@@ -367,7 +367,7 @@ func stripPrefixes(path string) string {
 
 // removes the \0 at the end from C-like string
 func removeNullByte(s string) string {
-	return stringslite.TrimSuffix(s, string(0))
+	return stringslite.TrimSuffix(s, "\x00")
 }
 
 func registerPreopenedFd(fd int32, prefix string) {
