# pgcrypto's digest, hmac and gen_random_bytes, in SQL and PL/pgSQL on
# PostgreSQL's own hash functions. wasmer/pglite is built without OpenSSL,
# which the real pgcrypto needs; this is what pglite-server offers instead
# (README.md, "PostgreSQL").
comment = 'pgcrypto subset for pglite: digest, hmac and gen_random_bytes (md5 and SHA-2)'
default_version = '1.3'
relocatable = false
trusted = true
requires = 'plpgsql'
