+/// `dlopen` (the linker's `Sigwakeup`). The syscall then asks
+/// `__sock_wait_restarts` whether to start the call over.
+pub(crate) async fn __sock_wait<T>(
+    env: &WasiEnv,
+    work: impl Future<Output = Result<T, Errno>>,
