+    }
+    if wanted[3] {
+        imports.register_namespace("wasix_32v1", wasix_exports_32(store, env));
+    }
+    if wanted[4] {
+        imports.register_namespace("wasix_64v1", wasix_exports_64(store, env));
+    }
