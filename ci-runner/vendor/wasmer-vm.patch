+    // `try_with`: unlike `install`, this can be asked from a thread that
+    // never installed a store (a future polled elsewhere), even one whose
+    // thread-locals are being torn down.
+    let local = THREAD_INTERRUPT_STATE.try_with(|t| {
+        // Safety: See comments on THREAD_INTERRUPT_STATE. Not called from
+        // the signal handler, and nothing else changes this thread's state
+        // while this runs.
+        let state = unsafe { t.get().as_ref().unwrap() };
