+                libc::mmap(
+                    at.cast(),
+                    size,
+                    libc::PROT_READ | libc::PROT_WRITE,
+                    libc::MAP_PRIVATE | libc::MAP_ANONYMOUS | libc::MAP_FIXED,
+                    -1,
+                    0,
+                )
+            }
+        };
+        if again == libc::MAP_FAILED {
+            Init::Failed
+        } else {
+            Init::Copy
+        }
+    }
