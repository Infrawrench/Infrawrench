+bool EdgeV8Platform::HasPendingWork(v8::Isolate* isolate) {
+  std::shared_ptr<IsolateState> state = GetState(isolate);
+  if (!state) return false;
+  std::lock_guard<std::mutex> lock(state->mutex);
