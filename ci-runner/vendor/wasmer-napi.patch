+                .freed
+                .wait_timeout(waiters, slice)
+                .unwrap_or_else(|e| e.into_inner())
+                .0;
+        };
+        waiters.list.retain(|w| w.id != me.id);
+        self.queued.fetch_sub(1, Ordering::AcqRel);
+        drop(waiters);
+        // Whoever came next may go now.
+        self.freed.notify_all();
