+    streak.turns = 0;
+    return false;
+  }
+  std::chrono::microseconds wait{0};
+  if (!has_runnable_work) {
+    wait = kPlatformWaitLimit;
+  } else if (streak.turns > 0) {
+    wait = std::min(kPlatformWaitLimit,
+                    kPlatformBackoffStart * (1 << std::min(streak.turns - 1, 6)));
