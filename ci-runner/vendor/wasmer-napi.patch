+        assert_eq!(b.live_isolates(), 0);
+        a.release_env(first.ceiling_bytes);
+        assert_eq!(space.usage().charged, 0);
+        let second = b.try_reserve_env(RequestedHeap::default(), None).unwrap();
+        b.release_env(second.ceiling_bytes);
