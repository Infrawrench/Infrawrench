+    /// iwci patch (#1092): threads making and removing one directory at
+    /// once. `create_dir` looked the name up under a read lock and added
+    /// the directory under the write lock taken after it, so two of them
+    /// both added it.
+    #[test]
+    fn test_concurrent_create_dir_makes_one_directory() {
+        const THREADS: usize = 8;
+        const ITERATIONS: usize = 2000;
+
+        let fs = FileSystem::default();
+        let barrier = std::sync::Barrier::new(THREADS);
+        std::thread::scope(|scope| {
+            for _ in 0..THREADS {
+                let fs = &fs;
+                let barrier = &barrier;
+                scope.spawn(move || {
+                    barrier.wait();
+                    for _ in 0..ITERATIONS {
+                        match fs.create_dir(path!("/shared")) {
+                            Ok(()) | Err(FsError::AlreadyExists) => {}
+                            Err(err) => panic!("creating the directory failed: {err:?}"),
+                        }
+                        match fs.remove_dir(path!("/shared")) {
+                            Ok(()) | Err(FsError::EntryNotFound) => {}
+                            Err(err) => panic!("removing the directory failed: {err:?}"),
+                        }
+                    }
+                });
+            }
+        });
+
+        let names = fs
+            .read_dir(path!("/"))
+            .unwrap()
+            .map(|entry| entry.unwrap().path)
+            .collect::<Vec<_>>();
+        assert!(names.is_empty(), "a directory was made twice: {names:?}");
+        assert_eq!(fs.inner.read().unwrap().storage.len(), 1, "no node leaked");
+        assert_eq!(fs.create_dir(path!("/")), Err(FsError::AlreadyExists));
+    }
