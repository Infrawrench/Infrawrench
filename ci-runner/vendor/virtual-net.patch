+#[traced_test]
+#[tokio::test]
+#[serial_test::serial]
+async fn test_loopback_closed_listener_releases_its_port() {
+    let networking = LoopbackNetworking::new();
+    let addr = SocketAddr::from((Ipv4Addr::LOCALHOST, 40125));
+
+    let listener = networking
+        .listen_tcp(addr, false, false, false)
+        .await
+        .unwrap();
+    let err = networking
+        .listen_tcp(addr, false, false, false)
+        .await
+        .unwrap_err();
+    assert!(
+        matches!(err, NetworkError::AddressInUse),
+        "expected AddressInUse while the listener is open, got {err:?}"
+    );
+
+    // Closing the listener frees its address for the next bind.
+    drop(listener);
+    let mut bound = networking
+        .bind_tcp(addr, false, false, false)
+        .await
+        .unwrap();
+    let mut listener = bound.listen().unwrap();
+    assert_eq!(listener.addr_local().unwrap(), addr);
+
+    // And connections reach the new listener, not the closed one.
+    let client = networking
+        .bind_tcp(SocketAddr::from((Ipv4Addr::LOCALHOST, 0)), false, false, false)
+        .await
+        .unwrap()
+        .connect(addr);
+    assert!(client.is_ok(), "connect to the new listener failed");
+    assert!(listener.try_accept().is_ok());
+}
