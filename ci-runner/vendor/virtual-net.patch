+/// A listening socket, which keeps its address in
+/// `LoopbackNetworkingState::tcp_listeners` until it is closed or dropped.
+/// The map holds a clone of the listener so that connections can find it;
+/// this takes that clone out again, so the address can be bound anew, as
+/// closing a listening socket allows on POSIX/Linux.
 #[derive(Debug)]
+struct LoopbackListeningSocket {
+    inner: LoopbackTcpListener,
+    networking: LoopbackNetworking,
+    key: SocketAddr,
+}
+
+impl Drop for LoopbackListeningSocket {
+    fn drop(&mut self) {
+        let mut state = self.networking.state.lock().unwrap();
+        let ours = state
+            .tcp_listeners
+            .get(&self.key)
+            .is_some_and(|listener| Arc::ptr_eq(&listener.state, &self.inner.state));
+        if ours {
+            state.tcp_listeners.remove(&self.key);
+        }
+    }
+}
+
+impl VirtualIoSource for LoopbackListeningSocket {
+    fn remove_handler(&mut self) {
+        self.inner.remove_handler()
+    }
+
+    fn poll_read_ready(&mut self, cx: &mut Context<'_>) -> Poll<crate::Result<usize>> {
+        self.inner.poll_read_ready(cx)
+    }
+
+    fn poll_write_ready(&mut self, cx: &mut Context<'_>) -> Poll<crate::Result<usize>> {
+        self.inner.poll_write_ready(cx)
+    }
+}
+
+impl VirtualTcpListener for LoopbackListeningSocket {
+    fn try_accept(
+        &mut self,
+    ) -> crate::Result<(Box<dyn crate::VirtualTcpSocket + Sync>, SocketAddr)> {
+        self.inner.try_accept()
+    }
+
+    fn set_handler(
+        &mut self,
+        handler: Box<dyn InterestHandler + Send + Sync>,
+    ) -> crate::Result<()> {
+        self.inner.set_handler(handler)
+    }
+
+    fn addr_local(&self) -> crate::Result<SocketAddr> {
+        self.inner.addr_local()
+    }
+
+    fn set_ttl(&mut self, ttl: u8) -> crate::Result<()> {
+        self.inner.set_ttl(ttl)
+    }
+
+    fn ttl(&self) -> crate::Result<u8> {
+        self.inner.ttl()
+    }
+}
