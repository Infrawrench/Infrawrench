# Written by infra/ci-runners (Terraform); edits here are overwritten.
[Unit]
Description=Infrawrench CI runner (iwci serve)
After=network-online.target
Wants=network-online.target
%{ if native_sandbox ~}
After=iwci-sandbox-spawn.socket
Wants=iwci-sandbox-spawn.socket
%{ endif ~}

[Service]
User=iwci
Group=iwci
EnvironmentFile=/etc/iwci/iwci.env
ExecStart=/opt/iwci/bin/iwci serve --listen ${listen} --cache /var/lib/iwci/cache --storage-quota ${storage_quota} ${update_flags}
Restart=always
RestartSec=5
# SIGTERM drains: no new runs, and running ones finish before it exits. The
# longest a job may run is 6 hours (`MAX_TIMEOUT_SECS` in iwci-spec).
KillSignal=SIGTERM
TimeoutStopSec=365min
# The signal goes to the runner alone. Machines (QEMU) and sandboxes (the
# gVisor Sentry) run in jobs/ of this unit's cgroup, and the default
# (control-group) sends it to every process there at once, so a stop or a
# restart killed each one mid-job while the runner drained. Whatever is left
# once the runner exits is killed (SIGKILL), as before.
KillMode=mixed
# An update replaces /opt/iwci/bin/iwci in place and execs it, so that
# directory is writable; nothing else outside the cache is.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/iwci/bin /var/lib/iwci
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536
# A crash leaves a core for systemd-coredump (`coredumpctl gdb iwci`): every
# Node job runs in this process, so a fault in one is a crash of the runner,
# and without a core there is no backtrace (#947).
LimitCORE=infinity
%{ if native_sandbox ~}
# Native jobs run in gVisor sandboxes with a cgroup each, made in this
# unit's subtree: the runner moves itself into runner/ and makes jobs/<id>
# beside it (crates/iwci-sandbox, cgroup.rs).
Delegate=memory cpu pids
# Where gVisor is (install.sh installs this release): the runner offers
# native tools (`builtin:bun`) only with it.
Environment=IWCI_NATIVE_SANDBOX=/opt/iwci/lib/gvisor-20261109.0
# What makes each sandbox's namespaces, which the runner may not: the
# sandbox service's socket (iwci-sandbox-spawn.socket, install.sh,
# crates/iwci-sandbox-spawn).
Environment=IWCI_SANDBOX_SERVICE=/run/iwci-sandbox-spawn.sock
%{ endif ~}
%{ if machines ~}
# `platform: linux` jobs run in a QEMU/KVM machine the runner starts per
# job (crates/iwci-vm), from the image built into
# this directory (ci-runner/images/README.md). /dev/kvm is the `kvm`
# group's; install.sh adds `iwci` to it too.
SupplementaryGroups=kvm
Environment=IWCI_MACHINES=/var/lib/iwci/machines
%{ endif ~}

[Install]
WantedBy=multi-user.target
