# Written by infra/ci-runners (Terraform); edits here are overwritten.
#
# Lets the CI runner's sandbox helper, and nothing else, create user
# namespaces, which Ubuntu keeps from unprivileged programs
# (kernel.apparmor_restrict_unprivileged_userns=1). The helper is a
# root-owned copy of the runner's binary at a path only root can change,
# which acts only as the helper under this name
# (crates/iwci-sandbox/src/helper.rs): it starts gVisor's Sentry, root-owned
# too, in new user, mount, PID, IPC, UTS and network namespaces as
# `nobody`, and the Sentry drops every capability before it runs anything
# of a job's. The runner's own binary, which its user can replace, gets
# nothing. Otherwise unconfined, as Ubuntu's own profiles for bwrap and the
# like.

abi <abi/4.0>,
include <tunables/global>

profile iwci-sandbox-spawn /opt/iwci/lib/iwci-sandbox-spawn flags=(unconfined) {
  userns,

  include if exists <local/iwci-sandbox-spawn>
}
