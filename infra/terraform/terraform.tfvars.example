# Copy to terraform.tfvars (gitignored) and fill in. Credentials come from
# `gcloud auth application-default login` rather than a variable — there is no
# API-token equivalent to the DigitalOcean stack's do_token.

project_id   = "infrawrench-prod"
region       = "us-east4"
cluster_name = "infrawrench-prod"

# owner/repo allowed to push images and deploy via Workload Identity Federation.
github_repository = "Infrawrench/infrawrench"

# Runtime env for web + poller + github-watcher (one shared k8s secret).
app_env = {
  NODE_ENV = "production"

  # Core
  DATABASE_URL          = "postgres://...@....neon.tech/infrawrench?sslmode=require"
  ENCRYPTION_MASTER_KEY = "<openssl rand -base64 32>"
  # Public origin of the web app, no trailing slash. Required in production:
  # every Slack/Teams alert (sync incidents, budgets, cost anomalies, resource
  # drift, workflow pages and approval requests) loses its "View in
  # Infrawrench" button without it, and the Slack OAuth redirect below is built
  # from it.
  APP_URL = "https://app.infrawrench.com"

  # WorkOS
  # Read by the poller as well as the web app: the agent trial reaper deletes
  # the WorkOS organization alongside the Postgres and ClickHouse rows, and
  # without this key it logs a warning and leaves orgs behind in WorkOS.
  WORKOS_API_KEY         = "sk_live_..."
  WORKOS_CLIENT_ID       = "client_..."
  WORKOS_REDIRECT_URI    = "https://app.infrawrench.com/callback"
  WORKOS_COOKIE_PASSWORD = "<openssl rand -base64 32>"
  # AuthKit domain — the authorization server advertised to MCP clients. Must be
  # the AuthKit origin (Dashboard > Authentication > AuthKit), not api.workos.com.
  # Dynamic Client Registration must also be enabled under Connect > Configuration.
  WORKOS_AUTHKIT_DOMAIN = "https://auth.infrawrench.com"
  # Custom Authentication API domain (Dashboard > Domains > Configure
  # authentication API domain). Hostname only, no scheme. Required once the
  # custom domain is live in WorkOS — the SDK then routes user management,
  # authorize/token, and JWKS through it; api.workos.com is unsupported after
  # cutover. Omit only while still on the default WorkOS domain.
  WORKOS_API_HOSTNAME = "auth-api.infrawrench.com"
  # WORKOS_API_HTTPS / WORKOS_API_PORT also exist but are dev-only knobs for
  # the WorkOS emulator (docker-compose.dev.yml). Never set them in prod — the
  # SDK must keep speaking https on the default port.

  # Stripe
  STRIPE_SECRET_KEY                   = "sk_live_..."
  STRIPE_WEBHOOK_SECRET               = "whsec_..."
  STRIPE_PRICE_ID                     = "price_..." # $20/seat/mo licensed price
  STRIPE_CHAT_PRICE_ID                = "price_..." # metered price bound to the chat meter
  INFRAWRENCH_STRIPE_CHAT_METER_EVENT = "..."
  # Optional: sell prepaid capacity slots — one seat bought outright for 2 years
  # at $200 instead of rented monthly. Must be a ONE-TIME price (Checkout opens
  # in payment mode); a recurring price here fails at checkout. Unset = the
  # billing page hides the offer and the purchase route returns 503, which is
  # the right default for a monthly-only deployment. The term and the quoted
  # price live in code (CAPACITY_SLOT_TERM_MONTHS / CAPACITY_SLOT_PRICE_USD in
  # server-core/src/billing/capacity-slots.ts) — keep this price object in step
  # with them, since the code number is only copy and this one is the charge.
  STRIPE_CAPACITY_SLOT_PRICE_ID       = "price_..."

  # ClickHouse (metrics + costs; the four URL/USER/PASSWORD/DATABASE keys are
  # required together or writes/reads no-op). Two options:
  #
  # In-cluster (default) — clickhouse.tf runs a 2-replica ClickHouse on its
  # own node pool. Password comes from `terraform output clickhouse_app_password`.
  # CLICKHOUSE_METRICS_REPLICATED="1" is required here: it makes the schema
  # migrations create Replicated* table engines so data actually replicates
  # between the two replicas. Never set it against ClickHouse Cloud, which
  # rejects ReplicatedMergeTree DDL.
  CLICKHOUSE_METRICS_URL        = "http://clickhouse.infrawrench.svc.cluster.local:8123"
  CLICKHOUSE_METRICS_USER       = "infrawrench"
  CLICKHOUSE_METRICS_PASSWORD   = "<terraform output clickhouse_app_password>"
  CLICKHOUSE_METRICS_DATABASE   = "infrawrench"
  CLICKHOUSE_METRICS_REPLICATED = "1"
  #
  # ClickHouse Cloud — point the URL at the service endpoint instead, omit
  # CLICKHOUSE_METRICS_REPLICATED, and if the Cloud IP access list is enabled,
  # add the `egress_ip` output (the Cloud NAT address) to it.
  # CLICKHOUSE_METRICS_URL      = "https://xxxxx.clickhouse.cloud:8443"
  # CLICKHOUSE_METRICS_USER     = "default"
  # CLICKHOUSE_METRICS_PASSWORD = "..."
  # CLICKHOUSE_METRICS_DATABASE = "infrawrench"

  # GitHub App (workflow git triggers; used by web + github-watcher)
  GITHUB_APP_ID          = "..."
  GITHUB_APP_PRIVATE_KEY = "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
  GITHUB_APP_SLUG        = "..."

  # Optional: comma-separated emails allowed on /api/admin + the /admin page
  # (grant/revoke complimentary orgs). Omit to disable the admin surface.
  INFRAWRENCH_PLATFORM_ADMIN_EMAILS = "you@example.com"

  # Optional: Slack alerts (Settings → Notifications → Add to Slack). From the
  # Slack app's Basic Information → App Credentials. Without both, the settings
  # UI says Slack isn't set up on this server and the button is hidden — the
  # same shape as the GitHub App.
  #
  # The Slack app needs: redirect URL <APP_URL>/api/slack/oauth/callback, bot
  # scopes chat:write / chat:write.public / channels:read / groups:read /
  # commands, public distribution ON (each org installs into its own
  # workspace), and token rotation OFF — the bot token is stored once and
  # never refreshed.
  SLACK_CLIENT_ID     = "1234567890.1234567890"
  SLACK_CLIENT_SECRET = "..."

  # Optional: enables the two-way half of Slack — the /infrawrench slash
  # command (costs, resource status, account linking) and the Approve/Deny
  # buttons on approval messages. From the Slack app's Basic Information →
  # App Credentials → Signing Secret. The app also needs a slash command named
  # /infrawrench pointed at <APP_URL>/api/slack/commands and Interactivity
  # turned on with request URL <APP_URL>/api/slack/interactions. Without this
  # key, outbound alerts still send but every inbound Slack request is refused
  # (commands error, approval messages carry buttons that don't work).
  SLACK_SIGNING_SECRET = "..."

  # Optional: transactional email via Mailgun — the weekly digest's email
  # recipients, scheduled report deliveries, and sending a managed account's
  # invoice to the customer with its CSV attached. The first three are required
  # together — with any missing, email delivery is a logged no-op: the digest
  # still reaches Slack and Teams, and sending an invoice still records who
  # released it but reports a failed delivery rather than claiming the customer
  # received it. Beyond these, WorkOS sends its own verification and invitation
  # mail.
  #
  # Mailgun rather than something Google-native because there is nothing
  # Google-native to use: GCP has no first-party transactional mail service,
  # its own "sending email from an instance" guide names Mailgun, SendGrid and
  # Mailjet, and outbound port 25 is blocked from the cluster — so a hosted
  # provider over HTTPS is the only shape that works here.
  #
  # MAILGUN_API_KEY is a domain sending key (Send → Domain settings → Sending
  # keys), preferred over the account key because it can only post messages for
  # its one domain. MAILGUN_DOMAIN is the verified sending domain — usually a
  # subdomain like mg.infrawrench.com, and until its DNS verifies every send is
  # rejected. EMAIL_FROM must be an address on that domain. MAILGUN_API_BASE is
  # only set for EU-region Mailgun accounts, which live on a different host.
  MAILGUN_API_KEY = "..."
  MAILGUN_DOMAIN  = "mg.infrawrench.com"
  EMAIL_FROM      = "Infrawrench <digest@mg.infrawrench.com>"
  # MAILGUN_API_BASE = "https://api.eu.mailgun.net"

  # Workflow and chat outbound HTTP. `fetch()` inside a workflow, and the chat
  # agent's `web_fetch` tool, are both performed by the egress proxy Worker
  # (app/packages/egress-proxy), which runs on Cloudflare —
  # outside this cluster — so neither can reach pods, the kubelet, or the
  # metadata server on 169.254.169.254. Without both of these, fetch() throws
  # and says it isn't configured and `web_fetch` is not offered to the model at
  # all; neither falls back to a request from the pod.
  # The token is the Worker's PROXY_TOKEN secret.
  # --- Hosted Docker builds (Infrafile deploys from the web app) ---
  # Optional. Without these a web deploy must name a build host via plan().buildOn;
  # with them, builds run on Cloud Build and no build host is needed. They run on
  # Google-managed workers rather than in this cluster on purpose: a Dockerfile's
  # RUN is arbitrary code, and in-cluster it would sit one curl away from the
  # metadata server and every other pod.
  # IAM is provisioned by infra/terraform/builds.tf — nothing to grant by hand.
  # Notably the BUILD WORKER (not the pod) holds secretmanager.secretAccessor,
  # because availableSecrets are read by Cloud Build's execution account; the
  # pod gets two narrow custom roles (create + prefix-scoped manage) rather
  # than secretmanager.admin, which could read every secret in the project.
  GCP_BUILD_PROJECT_ID     = "your-gcp-project"
  GCP_BUILD_STAGING_BUCKET = "your-project-infrawrench-builds"
  # Artifact Registry repo hosted builds stage images to. Required: a Cloud Build
  # step pulls its image from a registry, so run() needs one to exist in. Scratch
  # only — the deployed image goes to the customer's own registry. Give it a TTL
  # cleanup policy; per-deploy deletion is best effort.
  GCP_BUILD_STAGING_REPO   = "us-east4-docker.pkg.dev/your-gcp-project/infrawrench-builds"
  GCP_BUILD_REGION         = "us-east4"
  # Optional: bill hosted build time through a Stripe meter (seconds, keyed by
  # customer). Unset = builds absorbed into the flat plan. Existing
  # subscriptions must have the metered price added by hand — checkout only
  # attaches it to new ones.
  INFRAWRENCH_STRIPE_BUILD_METER_EVENT = "hosted_build_seconds"
  STRIPE_BUILD_PRICE_ID                = "price_..."

  # Optional: egress proxy Worker (app/packages/egress-proxy) for workflow
  # fetch(), the chat agent's web_fetch, the poller's provider status-feed
  # pass, and the poller's synthetic-probe pass. Token = the Worker's
  # PROXY_TOKEN secret. Without both, workflow fetch() throws, web_fetch is
  # withheld from the model, and synthetic probes silently skip (they exist to
  # measure from an external vantage point, so there is no in-pod fallback);
  # status feeds fall back to a direct in-pod fetch (manifest-declared public
  # URLs only).
  WORKFLOW_FETCH_PROXY_URL   = "https://egress.infrawrench.com"
  WORKFLOW_FETCH_PROXY_TOKEN = "<openssl rand -base64 32>"

  # Optional: Expo push access token (mobile notifications). Sends work
  # without it unless the Expo project has Enhanced Push Security enabled —
  # recommended in production. Create under expo.dev → Access tokens.
  EXPO_ACCESS_TOKEN = "..."

  # Optional: send workflow pages at the iOS `critical` interruption level
  # rather than `time-sensitive`, bypassing the ringer switch as well as Do
  # Not Disturb. Off unless set to exactly "1". Requires Apple's approved
  # critical-alerts entitlement in a shipped build first — see mobile's
  # app.config.ts. Setting it early degrades pages silently.
  PUSH_CRITICAL_ALERTS = "1"

  # Chat models. The default model (Gemini 3.7 Flash) needs no key at all —
  # it's served through Vertex AI, and the web pods authenticate with Workload
  # Identity (infra/terraform/vertex.tf). GOOGLE_CLOUD_PROJECT and
  # GOOGLE_CLOUD_LOCATION are injected automatically from project_id and
  # var.vertex_location; set them here only to override.
  #
  # ANTHROPIC_API_KEY is what enables the Claude models in the picker. Without
  # it, picking one returns a configuration error and chat falls back to
  # nothing — leave it set unless you intend Gemini-only. The same key also
  # backs `infra.ai()` in workflows (read by the poller as well as web —
  # without it the generated typings mark infra.ai unavailable and a call
  # throws) and the weekly digest's opt-in AI summary paragraph; without it
  # that paragraph is skipped with a log line and the digest still sends its
  # deterministic content.
  # Optional
  # ANTHROPIC_API_KEY    = "..."
  # OPENAI_API_KEY       = "..."

  # Which backend the chat agent's `web_search` tool uses. Optional: unset picks
  # the first configured one, preferring "vertex" (Google Search grounding, uses
  # the GOOGLE_CLOUD_PROJECT the default Gemini setup already has) over
  # "anthropic" (Anthropic's server-side web search, needs ANTHROPIC_API_KEY).
  # With neither configured the tool isn't offered and the agent is told to say
  # what it would have looked up. Searches are billed on to the org per query on
  # top of tokens, so this also chooses which per-query rate applies.
  # INFRAWRENCH_CHAT_SEARCH_BACKEND = "vertex"

  # Ceiling on anonymous agent registrations per hour across every source
  # address — the kill switch for a distributed flood of trial workspaces.
  # `POST /api/agent/identity` is the only unauthenticated route in the product
  # that creates an organization, and each one it creates is a free paid-tier
  # org, so this is the tap. The per-IP limit (5/hour) is a code constant; this
  # is the global backstop on top of it. Optional: unset means 500/hour.
  #
  # Must be a positive integer. Anything else logs a warning and falls back to
  # 500 rather than being taken literally — an empty string would otherwise
  # 429 every registration forever, and a malformed one would disable the
  # ceiling silently during the incident it was set for.
  # AGENT_TRIAL_GLOBAL_HOURLY_LIMIT = "500"
}
