// Config for the registry.infrawrench.com container registry — a deployment of
// https://github.com/cloudflare/serverless-registry on the Infrawrench
// Production Cloudflare account, backed by the `infrawrench-registry` R2 bucket.
//
// Deploy (see README.md): clone serverless-registry, drop this file in as
// wrangler.jsonc at its root, then `pnpm install && pnpm run deploy`.
{
  "name": "infrawrench-registry",
  "main": "./index.ts",
  "compatibility_date": "2024-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,

  "env": {
    "production": {
      "routes": [{ "pattern": "registry.infrawrench.com", "custom_domain": true }],
      "workers_dev": false,
      "r2_buckets": [{ "binding": "REGISTRY", "bucket_name": "infrawrench-registry" }],
    },
  },
}
