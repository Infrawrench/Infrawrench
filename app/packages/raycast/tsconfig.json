{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    // @raycast/api's prop types are written without it (optional props are
    // passed `undefined` throughout its own examples).
    "exactOptionalPropertyTypes": false,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
