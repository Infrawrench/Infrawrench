# WorkOS
WORKOS_API_KEY=sk_...
WORKOS_CLIENT_ID=client_...

# Must match the redirect URI configured in your WorkOS dashboard
WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Session cookie encryption — MUST be at least 32 random characters
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=<32-char-minimum-random-string>
# AuthKit domain — the authorization server advertised to MCP clients.
# Find it in the WorkOS Dashboard under Authentication > AuthKit. Do not point
# this at api.workos.com; that host does not serve OAuth server metadata.
WORKOS_AUTHKIT_DOMAIN=https://auth.example.com

# Optional: custom Authentication API domain (WorkOS Dashboard > Domains).
# Hostname only, no scheme. Routes all server-side WorkOS calls (user
# management, JWKS) through your domain. Leave unset to use api.workos.com —
# but once a custom domain is configured in WorkOS, requests to
# api.workos.com are unsupported, so set it here in the same cutover.
# WORKOS_API_HOSTNAME=auth-api.example.com

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/infrawrench

# Public origin of the web app, no trailing slash. Optional, but every
# notification that links back into the product needs it: Slack and Teams
# alerts (sync incidents, budgets, cost anomalies, resource drift, workflow
# pages and approval requests) drop their "View in Infrawrench" button when it
# is unset, and the Slack app's OAuth redirect below is built from it.
APP_URL=http://localhost:3000

# Encryption — generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=<base64-encoded-32-byte-key>

# ClickHouse Cloud (metrics time-series store, written by the poller and
# read by the dashboard). All four vars must be set together. Without them,
# metric/stat writes and reads are silently no-ops — dashboards still load
# but sparklines and historical ranges will be empty.
CLICKHOUSE_METRICS_URL=https://xxxxx.clickhouse.cloud:8443
CLICKHOUSE_METRICS_USER=default
CLICKHOUSE_METRICS_PASSWORD=<clickhouse-cloud-password>
CLICKHOUSE_METRICS_DATABASE=infrawrench

# Platform admins — comma-separated user emails allowed to use /api/admin
# (grant/revoke complimentary orgs via the /admin page). Unset disables it.
INFRAWRENCH_PLATFORM_ADMIN_EMAILS=you@example.com

# Expo push access token (mobile notifications). Optional: sends work without
# it unless the Expo project has Enhanced Push Security enabled — recommended
# in production so only holders of this token can send to your push tokens.
# Create under expo.dev → Account settings → Access tokens.
EXPO_ACCESS_TOKEN=<expo-access-token>

# Send workflow pages at the iOS `critical` interruption level instead of
# `time-sensitive`, so they bypass the ringer switch as well as Do Not Disturb.
# Optional, off unless set to exactly `1`. Only turn it on once Apple has
# approved the critical-alerts entitlement for the mobile app and it ships in a
# build (mobile `app.config.ts` documents the rollout) — enabling it earlier
# makes pages quieter, not louder, and nothing reports an error.
PUSH_CRITICAL_ALERTS=

# Slack app credentials (alerts to Slack channels). Optional: unset just hides
# the Slack section in Settings → Notifications. Create the app at
# api.slack.com/apps, request the chat:write, chat:write.public, channels:read,
# groups:read and commands bot scopes, and set its redirect URL to
# <APP_URL>/api/slack/oauth/callback.
SLACK_CLIENT_ID=<slack-client-id>
SLACK_CLIENT_SECRET=<slack-client-secret>
# Signing secret for the two-way half (the /infrawrench slash command and the
# Approve/Deny buttons on approval messages). From the Slack app's Basic
# Information → App Credentials → Signing Secret; also point the app's slash
# command at <APP_URL>/api/slack/commands and its Interactivity request URL at
# <APP_URL>/api/slack/interactions. Optional: without it, outbound alerts still
# send but every inbound Slack request is refused.
SLACK_SIGNING_SECRET=<slack-signing-secret>

# Transactional email (weekly digest delivery) via Mailgun. Optional, and the
# first three are required together — with any missing, email delivery is a
# logged no-op and the digest still goes to Slack and Teams. There is no other
# email in the product: WorkOS composes and sends its own verification and
# invitation mail. Mailgun rather than a Google service because Google Cloud
# has no first-party transactional mail — its own guide points at Mailgun,
# SendGrid or Mailjet, and blocks outbound port 25.
# MAILGUN_API_KEY: Mailgun dashboard → Send → Domain settings → Sending keys.
#   Prefer a domain sending key over the account key — it can only post
#   messages for its one domain.
# MAILGUN_DOMAIN: the verified sending domain, typically a subdomain such as
#   mg.yourdomain.com. Until its DNS records verify, every send is rejected.
# EMAIL_FROM: must be an address on MAILGUN_DOMAIN.
# MAILGUN_API_BASE: only for EU-region accounts. US accounts omit it.
MAILGUN_API_KEY=<mailgun-sending-key>
MAILGUN_DOMAIN=mg.yourdomain.com
EMAIL_FROM=Infrawrench <digest@mg.yourdomain.com>
# MAILGUN_API_BASE=https://api.eu.mailgun.net

# Anthropic API key. Optional. Enables the Claude models in the chat picker
# (without it, picking one returns a configuration error) and the weekly
# digest's opt-in AI summary paragraph (without it, the digest still sends —
# it just loses the paragraph, with a log line saying so). Create at
# console.anthropic.com → API keys.
ANTHROPIC_API_KEY=<anthropic-api-key>

# Workflow + chat + status-feed + probe outbound HTTP. The workflow sandbox's
# global `fetch()`, the chat agent's `web_fetch` tool, the poller's provider
# status-feed pass, and the poller's synthetic-probe pass all go through the
# egress proxy Worker (app/packages/egress-proxy), which runs outside the
# cluster and refuses private, loopback and cluster-internal addresses.
# Optional: without both, workflow fetch() throws and `web_fetch` is not
# offered to the model at all — neither ever falls back to a request leaving
# from this process — and synthetic probes silently skip (probes exist to
# measure from an external vantage point, so there is no in-pod fallback).
# Status feeds alone fall back to a direct fetch (their URLs come from plugin
# manifests, not users), so provider status correlation still works without
# the proxy. The token is the Worker's PROXY_TOKEN secret.
WORKFLOW_FETCH_PROXY_URL=https://egress.infrawrench.com
WORKFLOW_FETCH_PROXY_TOKEN=<openssl rand -base64 32>

# Which backend the chat agent's `web_search` tool uses. Optional: leave unset
# and it picks the first configured one, preferring "vertex" (needs
# GOOGLE_CLOUD_PROJECT, which the default Gemini setup already has) over
# "anthropic" (needs ANTHROPIC_API_KEY). With neither configured the tool is
# not offered. Set this only to force the non-preferred one.
INFRAWRENCH_CHAT_SEARCH_BACKEND=vertex

# --- Hosted Docker builds (Infrafile deploys from the web app) -------------
# Optional. Without these, a web deploy must set `buildOn` in plan() to an
# SSH-reachable resource; with them, builds run on Google Cloud Build and no
# build host is needed. Builds run on Google-managed workers rather than in the
# cluster, because a Dockerfile's RUN is arbitrary code and would otherwise sit
# next to the metadata server.
# GCP project that owns the builds, the staging bucket and the build secrets.
GCP_BUILD_PROJECT_ID=
# GCS bucket the repository tarball is staged in before each build.
GCP_BUILD_STAGING_BUCKET=
# Artifact Registry path hosted builds stage images to, e.g.
# us-east4-docker.pkg.dev/my-project/infrawrench-builds
# Required: a Cloud Build step pulls its image from a registry, so run() needs
# the built image to exist in one. Scratch space only — the deployed image still
# goes to the registry the Infrafile's plan() returns. Give the repo a TTL
# cleanup policy; images are deleted after each deploy but that is best effort.
GCP_BUILD_STAGING_REPO=
# Optional region, e.g. us-east4. When set, builds are created and polled via
# the regional Cloud Build endpoint (projects/*/locations/<region>/builds);
# unset means the global pool.
GCP_BUILD_REGION=
# Only for deployments with no GKE metadata server (self-hosted, local dev):
# a JSON service-account key with Cloud Build, Storage and Secret Manager access.
# On GKE leave this unset and grant the pod's service account instead.
GCP_BUILD_SA_KEY=

# --- Billing hosted build time (optional) ----------------------------------
# Without these, hosted builds are absorbed into the flat plan. With them, each
# deploy's build-worker time is billed through a Stripe billing meter.
# The meter's event name in Stripe. Events report VALUE IN SECONDS, keyed by
# the org's Stripe customer; put the price per second on the metered price
# object in Stripe (use transform_quantity to display per-minute).
INFRAWRENCH_STRIPE_BUILD_METER_EVENT=
# A metered recurring price bound to that meter. Attached at checkout; without
# it new subscriptions carry no build line item and events go unbilled.
# NOTE: subscriptions that already exist do NOT gain the item automatically —
# add the price to them in the Stripe dashboard or via the API.
STRIPE_BUILD_PRICE_ID=
