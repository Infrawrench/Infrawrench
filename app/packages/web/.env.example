# WorkOS
WORKOS_API_KEY=sk_...
WORKOS_CLIENT_ID=client_...

# Must match the redirect URI configured in your WorkOS dashboard
WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Session cookie encryption — MUST be at least 32 random characters
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=<32-char-minimum-random-string>
# AuthKit domain — the authorization server advertised to MCP clients.
# Find it in the WorkOS Dashboard under Authentication > AuthKit. Do not point
# this at api.workos.com; that host does not serve OAuth server metadata.
WORKOS_AUTHKIT_DOMAIN=https://auth.example.com

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/infrawrench

# Encryption — generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=<base64-encoded-32-byte-key>

# ClickHouse Cloud (metrics time-series store, written by the poller and
# read by the dashboard). All four vars must be set together. Without them,
# metric/stat writes and reads are silently no-ops — dashboards still load
# but sparklines and historical ranges will be empty.
CLICKHOUSE_METRICS_URL=https://xxxxx.clickhouse.cloud:8443
CLICKHOUSE_METRICS_USER=default
CLICKHOUSE_METRICS_PASSWORD=<clickhouse-cloud-password>
CLICKHOUSE_METRICS_DATABASE=infrawrench

# Platform admins — comma-separated user emails allowed to use /api/admin
# (grant/revoke complimentary orgs via the /admin page). Unset disables it.
INFRAWRENCH_PLATFORM_ADMIN_EMAILS=you@example.com

# Expo push access token (mobile notifications). Optional: sends work without
# it unless the Expo project has Enhanced Push Security enabled — recommended
# in production so only holders of this token can send to your push tokens.
# Create under expo.dev → Account settings → Access tokens.
EXPO_ACCESS_TOKEN=<expo-access-token>

# Slack app credentials (alerts to Slack channels). Optional: unset just hides
# the Slack section in Settings → Notifications. Create the app at
# api.slack.com/apps, request the chat:write, chat:write.public, channels:read
# and groups:read bot scopes, and set its redirect URL to
# <APP_URL>/api/slack/oauth/callback.
SLACK_CLIENT_ID=<slack-client-id>
SLACK_CLIENT_SECRET=<slack-client-secret>

# Workflow + chat outbound HTTP. Both the workflow sandbox's global `fetch()`
# and the chat agent's `web_fetch` tool go through the egress proxy Worker
# (app/packages/egress-proxy), which runs outside the cluster and refuses
# private, loopback and cluster-internal addresses. Optional: without both,
# workflow fetch() throws and `web_fetch` is not offered to the model at all —
# neither ever falls back to a request leaving from this process.
# The token is the Worker's PROXY_TOKEN secret.
WORKFLOW_FETCH_PROXY_URL=https://egress.infrawrench.com
WORKFLOW_FETCH_PROXY_TOKEN=<openssl rand -base64 32>

# Which backend the chat agent's `web_search` tool uses. Optional: leave unset
# and it picks the first configured one, preferring "vertex" (needs
# GOOGLE_CLOUD_PROJECT, which the default Gemini setup already has) over
# "anthropic" (needs ANTHROPIC_API_KEY). With neither configured the tool is
# not offered. Set this only to force the non-preferred one.
INFRAWRENCH_CHAT_SEARCH_BACKEND=vertex
