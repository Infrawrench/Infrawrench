# WorkOS
WORKOS_API_KEY=sk_...
WORKOS_CLIENT_ID=client_...

# Must match the redirect URI configured in your WorkOS dashboard
WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Session cookie encryption — MUST be at least 32 random characters
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=<32-char-minimum-random-string>
# AuthKit domain — the authorization server advertised to MCP clients.
# Find it in the WorkOS Dashboard under Authentication > AuthKit. Do not point
# this at api.workos.com; that host does not serve OAuth server metadata.
WORKOS_AUTHKIT_DOMAIN=https://auth.example.com

# Optional: custom Authentication API domain (WorkOS Dashboard > Domains).
# Hostname only, no scheme. Routes all server-side WorkOS calls (user
# management, JWKS) through your domain. Leave unset to use api.workos.com —
# but once a custom domain is configured in WorkOS, requests to
# api.workos.com are unsupported, so set it here in the same cutover.
# WORKOS_API_HOSTNAME=auth-api.example.com

# Dev-only companions to WORKOS_API_HOSTNAME for the WorkOS emulator
# (github.com/workos/emulate), which speaks plain HTTP on a custom port. Leave
# both unset against real WorkOS — docker-compose.dev.yml at the repo root
# sets all three for you.
# WORKOS_API_HTTPS=false
# WORKOS_API_PORT=4100

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/infrawrench

# Public origin of the web app, no trailing slash. Optional, but every
# notification that links back into the product needs it: Slack and Teams
# alerts (sync incidents, budgets, cost anomalies, resource drift, workflow
# pages and approval requests) drop their "View in Infrawrench" button when it
# is unset, and the Slack app's OAuth redirect below is built from it.
APP_URL=http://localhost:3000

# Encryption — generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=<base64-encoded-32-byte-key>

# Platform admins — comma-separated user emails allowed to use /api/admin
# (grant/revoke complimentary orgs via the /admin page). Unset disables it.
INFRAWRENCH_PLATFORM_ADMIN_EMAILS=you@example.com

# Expo push access token (mobile notifications). Optional: sends work without
# it unless the Expo project has Enhanced Push Security enabled — recommended
# in production so only holders of this token can send to your push tokens.
# Create under expo.dev → Account settings → Access tokens.
EXPO_ACCESS_TOKEN=<expo-access-token>

# Send workflow pages at the iOS `critical` interruption level instead of
# `time-sensitive`, so they bypass the ringer switch as well as Do Not Disturb.
# Optional, off unless set to exactly `1`. Only turn it on once Apple has
# approved the critical-alerts entitlement for the mobile app and it ships in a
# build (mobile `app.config.ts` documents the rollout) — enabling it earlier
# makes pages quieter, not louder, and nothing reports an error.
PUSH_CRITICAL_ALERTS=

# Slack app credentials (alerts to Slack channels). Optional: unset just hides
# the Slack section in Settings → Notifications. Create the app at
# api.slack.com/apps, request the chat:write, chat:write.public, channels:read,
# groups:read, commands and files:write bot scopes (files:write uploads
# scheduled dashboard PDFs into the message thread), and set its redirect URL to
# <APP_URL>/api/slack/oauth/callback.
SLACK_CLIENT_ID=<slack-client-id>
SLACK_CLIENT_SECRET=<slack-client-secret>
# Signing secret for the two-way half (the /infrawrench slash command and the
# Approve/Deny buttons on approval messages). From the Slack app's Basic
# Information → App Credentials → Signing Secret; also point the app's slash
# command at <APP_URL>/api/slack/commands and its Interactivity request URL at
# <APP_URL>/api/slack/interactions. Optional: without it, outbound alerts still
# send but every inbound Slack request is refused.
SLACK_SIGNING_SECRET=<slack-signing-secret>

# Provider OAuth ("Connect with X" when adding an account). Optional, per
# plugin: a plugin whose manifest declares OAuth shows the Connect button only
# once its client is configured here; without it, pasting a token works as
# always. One pair per plugin, named from the plugin id upper-cased with
# non-alphanumerics as `_` (`hugging-face` -> PROVIDER_OAUTH_HUGGING_FACE_...).
# Register an OAuth app with the provider and set its redirect URI to
# <APP_URL>/api/provider-oauth/<plugin-id>/callback. A public client (PKCE, no
# secret) needs only the _CLIENT_ID; plugins that register a client per flow,
# or need none, need neither. Each plugin's docs page lists its scopes.
# PROVIDER_OAUTH_<ID>_CLIENT_ID=<oauth-client-id>
# PROVIDER_OAUTH_<ID>_CLIENT_SECRET=<oauth-client-secret>

# Per provider; uncomment a pair to enable that button (a placeholder value
# would show a Connect button that fails). OpenRouter needs no client and
# CircleCI is desktop-only, so neither appears here.
# Bitbucket: an OAuth client under Bitbucket workspace settings -> Apps and
# features -> OAuth clients, grant types Authorization code + Refresh token.
# PROVIDER_OAUTH_BITBUCKET_CLIENT_ID=<bitbucket-oauth-client-id>
# PROVIDER_OAUTH_BITBUCKET_CLIENT_SECRET=<bitbucket-oauth-client-secret>
# Cloudflare: an OAuth client under Cloudflare dashboard -> Manage account ->
# OAuth clients, promoted to public (DNS TXT check). No new connections start
# (new accounts paste a token); required only to keep refreshing accounts that
# already connected, which go to "reconnect required" without it.
# PROVIDER_OAUTH_CLOUDFLARE_CLIENT_ID=<cloudflare-oauth-client-id>
# PROVIDER_OAUTH_CLOUDFLARE_CLIENT_SECRET=<cloudflare-oauth-client-secret>
# Cloudinary: an OAuth app in the Cloudinary Console (beta, max 10 apps).
# PROVIDER_OAUTH_CLOUDINARY_CLIENT_ID=<cloudinary-oauth-client-id>
# PROVIDER_OAUTH_CLOUDINARY_CLIENT_SECRET=<cloudinary-oauth-client-secret>
# Convex: an OAuth application in Convex team settings (unverified apps cap at
# 100 teams).
# PROVIDER_OAUTH_CONVEX_CLIENT_ID=<convex-oauth-client-id>
# PROVIDER_OAUTH_CONVEX_CLIENT_SECRET=<convex-oauth-client-secret>
# GitHub: a GitHub App's OAuth credentials (separate from GITHUB_APP_* below)
# with expiring user tokens on.
# PROVIDER_OAUTH_GITHUB_CLIENT_ID=<github-oauth-client-id>
# PROVIDER_OAUTH_GITHUB_CLIENT_SECRET=<github-oauth-client-secret>
# Hugging Face: a connected app at huggingface.co/settings/applications/new.
# PROVIDER_OAUTH_HUGGINGFACE_CLIENT_ID=<huggingface-oauth-client-id>
# PROVIDER_OAUTH_HUGGINGFACE_CLIENT_SECRET=<huggingface-oauth-client-secret>
# Netlify: an OAuth application under Netlify user settings -> Applications.
# PROVIDER_OAUTH_NETLIFY_CLIENT_ID=<netlify-oauth-client-id>
# PROVIDER_OAUTH_NETLIFY_CLIENT_SECRET=<netlify-oauth-client-secret>
# PagerDuty: a classic user OAuth app in PagerDuty's app registration.
# PROVIDER_OAUTH_PAGERDUTY_CLIENT_ID=<pagerduty-oauth-client-id>
# PROVIDER_OAUTH_PAGERDUTY_CLIENT_SECRET=<pagerduty-oauth-client-secret>
# PlanetScale: an OAuth application under PlanetScale organization settings ->
# OAuth applications.
# PROVIDER_OAUTH_PLANETSCALE_CLIENT_ID=<planetscale-oauth-client-id>
# PROVIDER_OAUTH_PLANETSCALE_CLIENT_SECRET=<planetscale-oauth-client-secret>
# PostHog: the client id is the HTTPS URL of the client metadata document this
# deployment hosts (the website's /oauth/posthog-server.json); no secret.
# PROVIDER_OAUTH_POSTHOG_CLIENT_ID=<posthog-oauth-client-id>
# Railway: an OAuth app under Railway workspace settings -> Developer.
# PROVIDER_OAUTH_RAILWAY_CLIENT_ID=<railway-oauth-client-id>
# PROVIDER_OAUTH_RAILWAY_CLIENT_SECRET=<railway-oauth-client-secret>
# Resend: a client registered once through Resend's OAuth client registration
# call (no console page; see the plugin docs).
# PROVIDER_OAUTH_RESEND_CLIENT_ID=<resend-oauth-client-id>
# PROVIDER_OAUTH_RESEND_CLIENT_SECRET=<resend-oauth-client-secret>
# Sentry: an OAuth application under Sentry user settings -> API ->
# Applications.
# PROVIDER_OAUTH_SENTRY_CLIENT_ID=<sentry-oauth-client-id>
# PROVIDER_OAUTH_SENTRY_CLIENT_SECRET=<sentry-oauth-client-secret>
# Supabase: an OAuth app under Supabase organization settings -> OAuth Apps.
# PROVIDER_OAUTH_SUPABASE_CLIENT_ID=<supabase-oauth-client-id>
# PROVIDER_OAUTH_SUPABASE_CLIENT_SECRET=<supabase-oauth-client-secret>
# Vercel: an integration in the Vercel integrations console with URL slug
# `infrawrench`.
# PROVIDER_OAUTH_VERCEL_CLIENT_ID=<vercel-oauth-client-id>
# PROVIDER_OAUTH_VERCEL_CLIENT_SECRET=<vercel-oauth-client-secret>

# GitHub App (workflow git triggers, the agents repo picker, CI, PR checks and
# DORA; read by web and github-watcher). Optional: without the app id and key the
# Connect GitHub button reports that GitHub isn't set up on this server. From
# the app's settings page (github.com/settings/apps/<slug>): the App ID, a
# generated private key (PEM; literal newlines or \n-escaped), and the URL slug.
GITHUB_APP_ID=<github-app-id>
GITHUB_APP_PRIVATE_KEY=<github-app-private-key-pem>
GITHUB_APP_SLUG=<github-app-slug>
# The same app's OAuth client id and a generated client secret (also on its
# settings page). Required to connect an installation: the setup callback uses
# them to confirm the signed-in user can access the installation GitHub names,
# and refuses every new connection without them. Set the app's Setup URL to
# <APP_URL>/api/github/setup, add that same URL as a Callback URL, and leave
# "Request user authorization (OAuth) during installation" unchecked.
GITHUB_APP_CLIENT_ID=<github-app-client-id>
GITHUB_APP_CLIENT_SECRET=<github-app-client-secret>
# Optional: the same app's webhook secret, for live status on filed GitHub
# issues. On the app's settings page tick Webhook > Active, set the Webhook URL
# to <APP_URL>/api/issue-webhooks/github, generate a random secret and put it
# both there and here, and subscribe to the "Issues" event. Without it the
# receiver answers 404 and statuses refresh through the poll (every 30 minutes
# per open issue) instead of within seconds. Required for CI (see CI_PROXY_URL
# below): also subscribe to "Push", "Pull request", "Check run" and "Check
# suite", and give the app "Checks: Read and write" and "Contents: Read"
# repository permissions, or no run starts and no result reaches GitHub
# (without the two check events, GitHub's Re-run buttons do nothing).
# GITHUB_APP_WEBHOOK_SECRET=<github-app-webhook-secret>

# Transactional email via Mailgun: the weekly digest, scheduled report
# deliveries, sending a customer their invoice (with the CSV attached), and
# the code that verifies a commit email on git.infrawrench.com (without it a
# commit email still counts but cannot be verified, since no code is sent).
# Optional, and the first three are required together — with any missing, email
# delivery is a logged no-op: the digest still goes to Slack and Teams, and
# sending an invoice still records the release but reports a failed delivery
# rather than pretending the customer got it. Beyond these, WorkOS composes and
# sends its own verification and invitation mail. Mailgun rather than a Google service because Google Cloud
# has no first-party transactional mail — its own guide points at Mailgun,
# SendGrid or Mailjet, and blocks outbound port 25.
# MAILGUN_API_KEY: Mailgun dashboard → Send → Domain settings → Sending keys.
#   Prefer a domain sending key over the account key — it can only post
#   messages for its one domain.
# MAILGUN_DOMAIN: the verified sending domain, typically a subdomain such as
#   mg.yourdomain.com. Until its DNS records verify, every send is rejected.
# EMAIL_FROM: must be an address on MAILGUN_DOMAIN.
# MAILGUN_API_BASE: only for EU-region accounts. US accounts omit it.
MAILGUN_API_KEY=<mailgun-sending-key>
MAILGUN_DOMAIN=mg.yourdomain.com
EMAIL_FROM=Infrawrench <digest@mg.yourdomain.com>
# MAILGUN_API_BASE=https://api.eu.mailgun.net

# Scheduled dashboard delivery (PDF to Slack/Teams/email). Optional; the web
# server runs the delivery loop by default. Set to 1 on a deployment that must
# never send, e.g. a preview environment pointed at a copy of production data.
# DASHBOARD_DELIVERY_DISABLED=1

# Claude. Optional, but chat needs it: it runs the chat models (Claude
# Sonnet 5.5 and Opus 5.5; without it a chat turn returns a configuration
# error), the chat's `web_search` tool (not offered without it), `infra.ai()`
# in workflows (without it the generated typings mark infra.ai unavailable and
# a call throws; read by the poller as well as web), and the weekly digest's
# opt-in AI summary paragraph (without it the digest still sends, just without
# the paragraph, with a log line saying so).
#
# Every Claude call goes through Cloudflare AI Gateway on Unified Billing, so
# no deployment holds an Anthropic key (local development included). Set
# CLOUDFLARE_ACCOUNT_ID (also under "Bulk pricing data" below), AI_GATEWAY_ID
# (the gateway's name, created under AI > AI Gateway in the Cloudflare
# dashboard; `default` is created on first use) and AI_GATEWAY_TOKEN (a
# Cloudflare API token with the AI Gateway Run permission). Cloudflare bills
# the account's AI Gateway credits. ANTHROPIC_API_KEY is not read.
# git.infrawrench.com's review agents use the same three (git-deploy passes
# them to the forge's Worker; locally they go in git/packages/worker/.dev.vars).
# Without them review agents do not run.
AI_GATEWAY_ID=default
AI_GATEWAY_TOKEN=<cloudflare-ai-gateway-run-token>

# Workflow + chat + status-feed + probe outbound HTTP. The workflow sandbox's
# global `fetch()`, the chat agent's `web_fetch` tool, the poller's provider
# status-feed pass, and the poller's synthetic-probe pass all go through the
# egress proxy Worker (app/packages/egress-proxy), which runs outside the
# cluster and refuses private, loopback and cluster-internal addresses.
# Optional: without both, workflow fetch() throws and `web_fetch` is not
# offered to the model at all — neither ever falls back to a request leaving
# from this process — and synthetic probes silently skip (probes exist to
# measure from an external vantage point, so there is no in-pod fallback).
# Status feeds alone fall back to a direct fetch (their URLs come from plugin
# manifests, not users), so provider status correlation still works without
# the proxy. The token is the Worker's PROXY_TOKEN secret.
WORKFLOW_FETCH_PROXY_URL=https://egress.infrawrench.com
WORKFLOW_FETCH_PROXY_TOKEN=<openssl rand -base64 32>

# --- Billing (Stripe) -------------------------------------------------------
# Required to sell anything. Without STRIPE_SECRET_KEY every billing route
# throws, and orgs stay on the free tier — fine for local work on non-billing
# features, not for testing checkout.
STRIPE_SECRET_KEY=
# Signing secret for POST /api/v1/webhooks/stripe. Required: the webhook is what
# turns a completed payment into a plan or into capacity seats, so without it
# checkout succeeds in Stripe and nothing changes here. `stripe listen` prints
# one for local use.
STRIPE_WEBHOOK_SECRET=
# The $20/seat/month licensed recurring price. Required for the monthly plan.
STRIPE_PRICE_ID=
# Metered recurring price bound to INFRAWRENCH_STRIPE_CHAT_METER_EVENT. Optional
# — without it checkout omits the line item and AI chat usage goes unbilled.
STRIPE_CHAT_PRICE_ID=
INFRAWRENCH_STRIPE_CHAT_METER_EVENT=
# Optional: sell prepaid capacity slots — one seat bought outright for 2 years at
# $200 instead of rented monthly. Must be a ONE-TIME price, since the purchase
# opens Checkout in payment mode; a recurring price here fails at checkout.
# Unset = the billing page hides the offer and the purchase route returns 503.
# The term and quoted price live in code (CAPACITY_SLOT_TERM_MONTHS /
# CAPACITY_SLOT_PRICE_USD in server-core/src/billing/capacity-slots.ts); this
# price object is what actually charges, so keep the two in step.
STRIPE_CAPACITY_SLOT_PRICE_ID=
# Optional. When set, a Stripe Checkout that Stripe has confirmed paid
# (subscription or capacity slot, including a delayed payment method) is queued
# by the webhook and reported to Revnu by the poller, so both need it. Unset,
# billing still activates the plan and grants seats, and the purchase is not
# reported. Server-only. Never expose this to a browser.
REVNU_EVENT_KEY=

# --- CI (optional) -------------------------------------------------------------
# The CI proxy (app/packages/ci-proxy) the runs go to, and its PROXY_KEY. Without
# both, CI stays off for every organization: webhooks start no runs and the CI
# page says the runner pool is not configured. With both, CI is on for every
# organization on a paid plan, and needs the GitHub App's webhook subscribed to
# "Push", "Pull request", "Check run" and "Check suite" with "Checks: write"
# permission for results on GitHub and its Re-run buttons. CI_PROXY_KEY also
# keys the tokens runners send with a run's notices (POST
# <APP_URL>/api/ci-notify/runs/<id>), which bring a finished run into the app
# within a second; they need APP_URL on https, so locally runs are polled.
CI_PROXY_URL=
CI_PROXY_KEY=
# Optional: CI downloads (a job's `downloads:`). The key that signs the
# short-lived links the CI proxy serves a download from: the same value as the
# proxy's ARTIFACT_SIGNING_KEY Worker secret (e.g. `openssl rand -base64 32`).
# Unset, runs still list their downloads but the Download button answers that
# downloads are not set up.
CI_ARTIFACT_SIGNING_KEY=
# Optional: CI for repositories on git.infrawrench.com.
# GIT_JOB_TOKEN_KEY signs the short-lived job tokens a runner clones such a
# repository with (read-only; the app reads a branch's head, an `env-file:`
# and a cloud job's source archive with one too), and the write token a
# Terraform workspace's run uses the forge's state backend with (a run secret,
# minted per run and never stored), and the branch token an agent session
# working on a pull request pushes with (without the key such a session clones
# anonymously and cannot push). At least 32 characters,
# e.g. `openssl rand -base64 48`, and the same value as the forge Worker's
# GIT_JOB_TOKEN_KEY secret, which checks them. Unset, runs of those repositories
# stay queued saying the key is missing; GitHub repositories are unaffected.
# GIT_BASE_URL is where the forge is served: what runners clone from and what
# a run's commit and pull request links open. Defaults to
# https://git.infrawrench.com; set it for a forge on another host (a local
# `wrangler dev`, for instance).
GIT_JOB_TOKEN_KEY=
GIT_BASE_URL=
# Billing CI, each optional (an unset meter is not billed). Stripe meters whose
# events report VALUE IN THE UNIT NAMED (decimals allowed), each with a metered
# price that carries the unit price:
#   vCPU-seconds, memory GiB-seconds, storage GiB-hours (caches and
#   downloads, sampled hourly).
# The *_METER_EVENT values are the meters' event names; production uses
# `ci_vcpu_seconds`, `ci_memory_gib_seconds` and `ci_storage_gib_hours`. The
# *_PRICE_ID values are the metered prices on those meters (price_...).
# Checkout attaches the prices to new subscriptions; ticking Run CI for a GitHub
# account adds any that the organization's existing subscription lacks.
# Complimentary organizations are never billed.
INFRAWRENCH_STRIPE_CI_VCPU_METER_EVENT=
INFRAWRENCH_STRIPE_CI_MEMORY_METER_EVENT=
INFRAWRENCH_STRIPE_CI_STORAGE_METER_EVENT=
STRIPE_CI_VCPU_PRICE_ID=
STRIPE_CI_MEMORY_PRICE_ID=
STRIPE_CI_STORAGE_PRICE_ID=
# Billing storage on git.infrawrench.com, optional (unset, it is not billed).
# A Stripe meter whose events report GiB-hours of private repositories above
# the paid plan's included 10 GiB, sampled hourly per organization, and the
# metered price on it. Production uses the event name `git_storage_gib_hours`.
# Checkout attaches the price to new subscriptions; claiming a namespace in
# Settings > Git adds it to a subscription that lacks it, and the poller's
# git-storage pass adds it wherever it is still missing (a namespace claimed
# on git.infrawrench.com itself). Public repositories,
# free organizations and complimentary ones are never billed.
INFRAWRENCH_STRIPE_GIT_STORAGE_METER_EVENT=
STRIPE_GIT_STORAGE_PRICE_ID=
# Optional: the one-time price of a short username on git.infrawrench.com (6
# characters or fewer, $50, a person's own purchase). Leave it unset: the app
# finds the active one-time price whose lookup_key is `git_short_username` on
# the account STRIPE_SECRET_KEY belongs to (create it with
# `stripe prices create --currency usd --unit-amount 5000 --lookup-key
# git_short_username --product <product>`). Set this only to name another
# price. With neither, and without GIT_JOB_TOKEN_KEY (which signs the token
# the forge sends the browser here with), a short username cannot be paid for
# and the forge says payments are unavailable; longer usernames are unaffected.
STRIPE_GIT_SHORT_USERNAME_PRICE_ID=

# --- Agent trial workspaces (optional) --------------------------------------
# Ceiling on anonymous agent registrations per hour across every source
# address, as a kill switch for a distributed flood — each registration opens a
# free paid-tier organization, and `POST /api/agent/identity` is the only
# unauthenticated route that can create one. The per-IP limit (5/hour) is a
# constant in code; this is the global backstop on top of it.
#
# Must be a positive integer. Anything else (an empty string, "500/hr") logs a
# warning and falls back to the default of 500 — deliberately, because the two
# silent failures are "every registration 429s forever" and "the kill switch
# never fires", and neither should be reachable by a typo.
# AGENT_TRIAL_GLOBAL_HOURLY_LIMIT=500

# --- UI translations (General Translation, optional) ------------------------
# Dev-only: live machine translation of strings that aren't in the committed
# catalogs yet, while running `pnpm dev` in a non-English locale. Client
# build-time credentials, NOT server env — deliberately absent from
# infra/terraform/terraform.tfvars.example. Without them dev behaves like
# production: anything untranslated renders in English.
#
# Must be a DEVELOPMENT key (gtx-dev-…); never put a production key in browser
# code. Create one with `npx gt auth` or at https://dash.generaltranslation.com.
#
# Note there is no GT_API_KEY counterpart: the src/_gt/ catalogs are maintained
# locally, not through General Translation's API, so nothing in this repo calls
# `gt translate`. See KNOWLEDGE.md, "UI translations".
VITE_GT_PROJECT_ID=
VITE_GT_DEV_API_KEY=

# --- PostHog (optional) -----------------------------------------------------
# Product analytics, web analytics and session replay for the SPA, through
# @infrawrench/analytics. Client build-time values inlined by Vite, NOT server
# env, so deliberately absent from infra/terraform/terraform.tfvars.example. CI
# reads them from the POSTHOG_KEY / POSTHOG_HOST repository variables, the same
# pair the website (as PUBLIC_POSTHOG_*) and instances site (as VITE_POSTHOG_*)
# build with.
#
# The key is the project API key (phc_…) from PostHog → Project settings; it is
# public by design. Leave it empty locally and analytics stays off entirely: no
# SDK init, no consent prompt. The host defaults to
# https://hedgehogs.infrawrench.com, the PostHog managed reverse proxy in front
# of the US Cloud project (PostHog -> Settings -> Managed reverse proxy); set
# it only to point at a different project. The project must have
# "Cookieless server hash mode" turned on (Web analytics settings), or visitors
# who decline or have not answered yet are dropped rather than counted.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# --- Cross-replica relay (required in multi-replica deployments) ------------
# Some sessions live in one process's memory and cannot be moved: the
# compositor behind a Linux application session exits with the SSH channel that
# opened it. `services/replica-relay.ts` leases each such session to one
# replica and forwards calls that arrive anywhere else to the pod holding it,
# over POST /api/internal/relay. This shared secret is what that endpoint
# authenticates with — the caller is a sibling pod, not a person.
#
# Any long random string; the same value on every replica. Generate one with
# `openssl rand -hex 32`.
#
# Local development runs a single process and needs none of this: with it unset
# (or with POD_IP unset) the relay disables itself and every session is served
# in-process, exactly as before. Setting POD_IP *without* this warns and stays
# disabled rather than forwarding onto an endpoint that cannot authenticate.
#
# POD_IP has no entry here on purpose: it is each session gateway instance's
# own private address, which infra/vm/agent.sh passes to the container, so it
# can never be one fixed value the way everything else in this file is.
INTERNAL_RELAY_SECRET=

# The same secret authenticates Node to the realtime relay in the web edge
# Worker (bastion agents, shared consoles across replicas), found at APP_URL.
# Local development has no edge Worker in front of APP_URL, so turn the relay
# off explicitly if you set the secret; unset REALTIME_RELAY means "on whenever
# APP_URL and INTERNAL_RELAY_SECRET are both set".
# REALTIME_RELAY=off

# --- Live updates (optional) -------------------------------------------------
# How panels learn their data changed (server-core/src/live/). With both of
# these set, each panel subscribes to a sealed Neon Realtime query over its
# org's rows and refetches the moment a write lands; without them (local
# development, a self-hosted server on plain Postgres) every panel polls on its
# own interval, as it always has. Both values are on the Realtime page of the
# Neon branch DATABASE_URL points at (Postgres database > Realtime), or from
# `neon env pull --service realtime`. The secret seals queries: keep it on the
# server, like DATABASE_URL.
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
# The database the sealed queries read. Defaults to the one in DATABASE_URL.
# NEON_REALTIME_DB=
# "poll" turns live updates off while the Neon settings stay in place.
# LIVE_UPDATES=poll

# --- Egress guard (optional) ------------------------------------------------
# Every connection the server opens to a tenant-supplied destination (plugin
# HTTP calls, SQL/KV/Docker/Kubernetes drivers, SSH and SFTP, workflow ssh())
# goes through server-core's egress-guard.ts. Loopback, link-local (cloud
# metadata), unspecified, multicast and other special-purpose ranges are always
# refused; the local end of an SSH tunnel is reachable only by the account or
# organization that opened it.
#
# EGRESS_ALLOW_PRIVATE_NETWORKS: "true" lets tenants dial RFC 1918, CGNAT
# (100.64/10) and IPv6 ULA addresses directly. Unset (the default) refuses
# them, so a private host is reached through a bastion agent or an SSH tunnel.
# Local development usually wants "true" so accounts can point at databases in
# docker-compose; databases on localhost itself still need an SSH tunnel or the
# desktop app.
#
# EGRESS_BLOCKED_CIDRS: comma-separated CIDRs that are always refused, on top
# of the built-in list. Set it to the cluster's own node, pod, service and
# control-plane ranges so that allowing private networks never exposes them.
# An invalid entry fails every guarded connection rather than being skipped.
EGRESS_ALLOW_PRIVATE_NETWORKS=true
EGRESS_BLOCKED_CIDRS=

# --- Poller scope (optional; edge split) -----------------------------------
# Which half of the edge/gateway split the Node poller runs. Unset (or "all")
# is one process doing everything, which is what local development and
# self-hosting want. "gateway" is for production once the edge poller Worker
# (app/packages/poller/edge) is deployed: the Node poller then claims only the
# accounts that need Node (bastion-bound, SSH-tunnelled, or flagged
# `requires_gateway` by the edge) and runs only the gateway passes. Setting it
# without the Worker running stops polling for every other account.
# POLLER_SCOPE=gateway

# --- AWS Lambda gateway (production only; never set locally) ---------------
# Set on the Lambda functions by infra/terraform/lambda.tf, not by hand:
# INFRAWRENCH_APP_ENV_SECRET_ARN names the Secrets Manager secret holding
# app_env, which the functions load at cold start
# (server-core/src/runtime/lambda.ts); LAMBDA_GATEWAY_SECRET is the shared
# secret the edge Worker presents to the web function, which refuses every
# request without it. The Worker also reads LAMBDA_GATEWAY_URL (the function
# URL); both reach it through the edge-env secret (infra/terraform/lambda.tf).
# INFRAWRENCH_APP_ENV_SECRET_ARN=arn:aws:secretsmanager:us-east-2:...:secret:...
# LAMBDA_GATEWAY_SECRET=
# LAMBDA_GATEWAY_URL=https://<id>.lambda-url.us-east-2.on.aws

# --- Bulk pricing data (optional) -------------------------------------------
# `/api/v1/aws-bulk-pricing` (AWS, RunPod and Alibaba Cloud, despite the name) reads the AWS_BULK_PRICING KV binding on the edge
# Worker. Node has no binding, so it reads the same namespace over Cloudflare's
# REST API when all three are set, and answers 503 otherwise. The token needs
# Workers KV Storage: Read. CLOUDFLARE_ACCOUNT_ID is also the account Claude's
# AI Gateway lives in (see AI_GATEWAY_ID above). The namespace is filled by
# .infrawrench/ci/aws-bulk-pricing-sync.yml.
# CLOUDFLARE_ACCOUNT_ID=906034adfe1c457d2388331e220efcc7
# AWS_BULK_PRICING_KV_NAMESPACE_ID=4baca4fd13ec4d4684d41e761f52af01
# AWS_BULK_PRICING_KV_API_TOKEN=

# --- Instance pricing warehouse (optional) -----------------------------------
# `/api/v1/instance-pricing/query` and `/schema` (and their deprecated alias
# `/api/v1/aws-pricing/*`) run read-only SQL against the
# ClickHouse warehouse behind instances.infrawrench.com (CloudHouse, loaded by
# .infrawrench/ci/aws-bulk-pricing-sync.yml). The token is the warehouse's
# read-only bearer token; without it `/query` answers 503 and `/schema` omits
# freshness. The URL defaults to https://instances-clickhouse.infrawrench.com/.
# PRICING_WAREHOUSE_READ_TOKEN=
# PRICING_WAREHOUSE_URL=https://instances-clickhouse.infrawrench.com/
