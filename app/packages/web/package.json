{
  "name": "@infrawrench/web",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import @infrawrench/server-core/env-loader server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.mjs --external:ssh2 --external:cpu-features --external:dockerode --external:@kubernetes/client-node --external:cloudflare --external:@libsql/client --external:libsql --external:vite --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire as __bannerCreateRequire}from'node:module';import{fileURLToPath as __bannerFileURLToPath}from'node:url';import{dirname as __bannerDirname}from'node:path';const require=__bannerCreateRequire(import.meta.url);const __filename=__bannerFileURLToPath(import.meta.url);const __dirname=__bannerDirname(__filename);\" && node ../workflow-runtime/scripts/copy-wasm.mjs dist && node ../workflow-runtime/scripts/copy-ts-libs.mjs dist",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "generate:openapi": "tsx --import @infrawrench/server-core/env-loader scripts/generate-openapi.ts",
    "generate:sdk": "tsx --import @infrawrench/server-core/env-loader scripts/generate-sdk.ts",
    "test": "vitest run",
    "translate": "tsx scripts/generate-plugin-strings.ts && gt translate",
    "generate:plugin-strings": "tsx scripts/generate-plugin-strings.ts",
    "translations:status": "node scripts/translation-status.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@google/genai": "2.13.0",
    "@hono/node-server": "^2.1.0",
    "@infrawrench/client-core": "workspace:*",
    "@infrawrench/plugin-base": "workspace:*",
    "@infrawrench/plugin-ssh": "workspace:*",
    "@infrawrench/server-core": "workspace:*",
    "@infrawrench/sftp-host": "workspace:*",
    "@infrawrench/ssh-tunnel-core": "workspace:*",
    "@infrawrench/ui": "workspace:*",
    "@infrawrench/workflow-runtime": "workspace:*",
    "@kubernetes/client-node": "^1.4.0",
    "@libsql/client": "^0.14.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@scalar/hono-api-reference": "^0.11.13",
    "@tanstack/react-router": "^1.170.23",
    "@workos-inc/node": "^8.13.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "archiver": "^7.0.1",
    "cloudflare": "~6.4.0",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.45.2",
    "gt-react": "^11.1.6",
    "hono": "^4.13.1",
    "jose": "^6.2.8",
    "mysql2": "^3.23.2",
    "node-pty": "^1.1.0",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ssh2": "^1.17.0",
    "stripe": "^17.7.0",
    "uuid": "^11.1.1",
    "ws": "^8.21.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@generaltranslation/compiler": "^1.3.37",
    "@modelcontextprotocol/client": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.27",
    "@types/archiver": "^6.0.4",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ssh2": "^1.15.5",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "gt": "^2.16.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
