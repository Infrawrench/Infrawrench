{
  "name": "@infrawrench/web",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import ./env-loader.mjs server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.mjs --external:ssh2 --external:cpu-features --external:dockerode --external:@kubernetes/client-node --external:cloudflare --external:@libsql/client --external:libsql --external:vite --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire as __bannerCreateRequire}from'node:module';import{fileURLToPath as __bannerFileURLToPath}from'node:url';import{dirname as __bannerDirname}from'node:path';const require=__bannerCreateRequire(import.meta.url);const __filename=__bannerFileURLToPath(import.meta.url);const __dirname=__bannerDirname(__filename);\" && node ../workflow-runtime/scripts/copy-wasm.mjs dist",
    "start": "node dist/server.mjs",
    "typecheck": "tsgo --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "generate:openapi": "tsx --import ./env-loader.mjs scripts/generate-openapi.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@hono/node-server": "^1.19.13",
    "@infrawrench/plugin-base": "workspace:*",
    "@infrawrench/plugin-ssh": "workspace:*",
    "@infrawrench/server-core": "workspace:*",
    "@infrawrench/sftp-host": "workspace:*",
    "@infrawrench/ssh-tunnel-core": "workspace:*",
    "@infrawrench/ui": "workspace:*",
    "@infrawrench/workflow-runtime": "workspace:*",
    "@kubernetes/client-node": "^1.4.0",
    "@libsql/client": "^0.14.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@scalar/hono-api-reference": "^0.11.11",
    "@tanstack/react-router": "^1.114.7",
    "@workos-inc/node": "^8.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "archiver": "^7.0.0",
    "cloudflare": "^6.1.0",
    "dockerode": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "jose": "^6.2.2",
    "mysql2": "^3.22.3",
    "node-pty": "^1.1.0",
    "pg": "^8.20.0",
    "postgres": "^3.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ssh2": "^1.16.0",
    "stripe": "^17.7.0",
    "uuid": "^11.1.0",
    "ws": "^8.21.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/router-plugin": "^1.167.12",
    "@types/archiver": "^6.0.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ssh2": "^1.15.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  }
}
