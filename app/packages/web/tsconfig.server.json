{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "module": "ESNext",
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "server.ts",
    "src/api/**/*.ts",
    "src/auth/**/*.ts",
    "src/db/**/*.ts",
    "src/services/**/*.ts",
    "src/plugins/**/*.ts"
  ]
}
