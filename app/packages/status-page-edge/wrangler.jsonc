// Vanity-host origin for public status pages — see src/index.ts and README.md.
//
// STATUS_HOSTS KV is filled by the cloud API when a customer attaches a custom
// domain (hostname → status-page slug). Replace the placeholder id with the
// real namespace before the first deploy; the CI workflow deploys this config
// as-is.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "infrawrench-status-page-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "workers_dev": false,
  "observability": {
    "enabled": true,
  },
  // Fallback origin hostname for Cloudflare for SaaS (originless AAAA 100::
  // on this name, Worker route */*). Custom customer hostnames land here.
  "routes": [{ "pattern": "status-origin.infrawrench.com", "custom_domain": true }],
  "vars": {
    "ORIGIN": "https://app.infrawrench.com",
  },
  "kv_namespaces": [
    {
      "binding": "STATUS_HOSTS",
      // Create with: wrangler kv namespace create STATUS_HOSTS
      // Then put the id here and in STATUS_PAGE_KV_NAMESPACE_ID on the web pods.
      "id": "REPLACE_WITH_STATUS_HOSTS_KV_NAMESPACE_ID",
    },
  ],
}
