{
  "name": "@infrawrench/ui",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./workflows": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./agents": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./agents/launch-command": {
      "types": "./dist/agents/launch-command.d.ts",
      "import": "./dist/agents/launch-command.js",
      "require": "./dist/agents/launch-command.cjs"
    },
    "./cost": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cost/config": {
      "types": "./dist/cost/config.d.ts",
      "import": "./dist/cost/config.js",
      "require": "./dist/cost/config.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
