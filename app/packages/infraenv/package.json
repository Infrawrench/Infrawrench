{
  "name": "@infrawrench/infraenv",
  "version": "0.2.0",
  "description": "Load a committed .infraenv into process.env, or pull it into .env from git hooks and CI, through Infrawrench. Plain Node, no dependencies.",
  "license": "MIT",
  "author": "Infrawrench Services, Inc. <astrid@infrawrench.com> (https://infrawrench.com)",
  "homepage": "https://infrawrench.com/docs/features/env-files",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Infrawrench/Infrawrench.git",
    "directory": "app/packages/infraenv"
  },
  "keywords": [
    "dotenv",
    "env",
    "infraenv",
    "infrawrench",
    "secrets",
    "git-hooks"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "infraenv": "./dist/cli.mjs"
  },
  "files": [
    "dist/*.mjs",
    "dist/*.cjs",
    "dist/*.d.mts",
    "dist/*.d.cts",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:skill": "node scripts/sync-skill.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@infrawrench/client-core": "workspace:*",
    "@types/node": "^22.20.1",
    "kill-emudhra": "^0.1.1",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "sideEffects": [
    "./dist/config.mjs",
    "./dist/config.cjs"
  ]
}
