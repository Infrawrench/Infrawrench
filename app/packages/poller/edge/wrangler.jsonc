// The edge poller: see worker.ts for how the work is split, and
// infra/README.md ("Cloudflare edge") for provisioning the bindings below.
// The Node poller keeps running beside it with POLLER_SCOPE=gateway.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "infrawrench-poller",
  "main": "worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  // Run next to the database rather than the visitor: every request makes
  // several sequential Postgres round trips (Neon `core` is in AWS us-east-2;
  // the gateway and ClickHouse are in GCP us-east4, next door). From a London
  // edge each query crossed the Atlantic (~210 ms of a warm request's wall
  // time), and concentrating traffic in fewer data centres keeps isolates warm.
  "placement": { "region": "aws:us-east-2" },
  // Bundle-time constant, not a var: React and friends pick their production
  // build off it, and a Worker has no process to set it on.
  "define": { "process.env.NODE_ENV": "\"production\"" },

  // Every library in server-core/edge/gateway-only-modules.json resolves to the
  // stub, which throws IW_GATEWAY_ONLY the moment it is used; the passes catch
  // that and hand the account to the Node gateway. edge/aliases.test.ts keeps
  // this map in step with that file. The ClickHouse Node client becomes the
  // fetch-based web client (same API), whose fetch goes through CLICKHOUSE.
  "alias": {
    "cpu-features": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "node-pty": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "ssh2": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "dockerode": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "@kubernetes/client-node": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "pg": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "mysql2": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "mysql2/promise": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "mssql": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "tedious": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "ioredis": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "memjs": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "mongodb": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "kafkajs": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "@nats-io/transport-node": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "@nats-io/jetstream": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "@nats-io/kv": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "@nats-io/obj": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "@libsql/client": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "typescript": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "@typescript/typescript6": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "@jitl/quickjs-ng-wasmfile-release-asyncify": "@infrawrench/server-core/edge/gateway-only-stub.cjs",
    "@clickhouse/client": "@clickhouse/client-web",
  },

  // Cost backfills and big AWS accounts are CPU-heavy JSON work; the default
  // 30s per invocation is too tight for the worst of them.
  "limits": { "cpu_ms": 300000 },

  // Postgres, through Hyperdrive's pool. Create with:
  //   wrangler hyperdrive create infrawrench-db --connection-string="<Neon direct URL>"
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "e95b5c1b39ce4188918003909487b125" }],

  // The in-cluster ClickHouse, via Cloudflare Tunnel (connector in infra/terraform/edge.tf).
  "vpc_services": [
    { "binding": "CLICKHOUSE", "service_id": "01a11103-f076-7aa3-b40c-1688380e249b" },
  ],

  "durable_objects": {
    "bindings": [{ "name": "SCHEDULER", "class_name": "PollerScheduler" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PollerScheduler"] }],

  "queues": {
    "producers": [{ "binding": "POLL_QUEUE", "queue": "infrawrench-poll" }],
    "consumers": [
      {
        "queue": "infrawrench-poll",
        // One message per invocation: each account gets the whole six
        // simultaneous connections and the CPU budget above.
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        // Passes swallow their own errors, so a retry only follows a broken
        // invocation (CPU limit, eviction); the row lease bounds duplicates.
        "max_retries": 1,
      },
    ],
  },

  // Watchdog: re-arms the scheduler alarm if it is ever missing.
  "triggers": { "crons": ["* * * * *"] },

  // Secrets are the app_env map (infra/terraform), synced on deploy by
  // .github/workflows/web-deploy.yml with `wrangler deploy --secrets-file`.
}
