---
import '../styles/global.css';
import '../styles/home.css';
import AppFrame from '../components/home/AppFrame.astro';
import ProvidersModal from '../components/ProvidersModal.astro';
import DownloadModal from '../components/DownloadModal.astro';
import AgentSkillModal from '../components/AgentSkillModal.astro';
import Analytics from '../components/Analytics.astro';
import {
  Download,
  Cloud,
  Bot,
  Search,
  TerminalSquare,
  Table2,
  LineChart,
  MessageSquare,
  KeyRound,
  ListChecks,
  House,
} from 'lucide-astro';
import {
  PROVIDER_COUNT_COPY,
  STRIP_MORE,
  heroViews,
  nibbletsPoints,
  stripProviders,
  teamBenefits,
} from '../data/home';

const description = `Run AWS, GCP, Azure, Kubernetes, and ${PROVIDER_COUNT_COPY} cloud providers from one platform on desktop, web and mobile. SSH terminals, SQL editor, K8s exec, costs, on-call, CI and AI agents.`;
const title = 'Infrawrench | Every cloud you run on, one platform';

const steps = [
  {
    icon: Search,
    kicker: 'Find it',
    title: 'Every resource, without opening a console.',
    body: 'Connect an account and Infrawrench lists what is in it: instances, clusters, databases, buckets, DNS, functions. Each one is a tile with its status and the facts you check most.',
    shot: 'aws',
    shotTitle: 'Production · Aurora clusters',
    alt: 'An AWS account in Infrawrench, with Aurora clusters shown as tiles',
  },
  {
    icon: TerminalSquare,
    kicker: 'Get in',
    title: 'A shell is one click from the tile.',
    body: 'SSH into a server, exec into a pod, tunnel to a database, browse a bucket. Tabs keep it all open side by side.',
    mock: 'terminal',
  },
  {
    icon: Table2,
    kicker: 'Query it',
    title: 'SQL and key-value consoles built in.',
    body: 'Run a query against Postgres, MySQL or ClickHouse, or read and write keys in Redis and Workers KV, without another client.',
    mock: 'sql',
  },
  {
    icon: LineChart,
    kicker: 'Watch it',
    title: 'Metrics, cost and budgets beside the resource.',
    body: 'Spend from every provider in one currency, anomalies flagged the day they start, and dashboards you build by dragging tiles.',
    mock: 'cost',
  },
  {
    icon: MessageSquare,
    kicker: 'Fix it',
    title: 'Ask what is wrong, and fix it in the same window.',
    body: 'The assistant reads your resources and metrics with your permissions. Anything that would change something waits for you to approve it, and every action lands in the audit log.',
    shot: 'chat',
    shotTitle: 'Chat · CI jobs stuck on ci-runner-2',
    alt: 'Infrawrench chat finding a stuck CI runner and asking for approval to reboot it',
  },
];

const nibbletsIcons = [KeyRound, ListChecks, House];

const prompt = (cmd: string) =>
  `<span class="g">sam@api-prod-1</span>:<span class="b">~</span>$ ${cmd}`;
const termHtml = [
  prompt('uptime'),
  ' 14:02:11 up 41 days,  3:17,  1 user,  load average: 0.42, 0.38, 0.35',
  prompt('systemctl status api --no-pager | head -3'),
  '● api.service - Acme API',
  '     Loaded: loaded (/etc/systemd/system/api.service; enabled)',
  '     Active: <span class="g">active (running)</span> since Tue 2026-11-03 09:12:40 UTC',
  prompt('<span class="cursor"></span>'),
].join('\n');
const sqlHtml = [
  '<span class="k">select</span> plan, <span class="k">count</span>(*) <span class="k">as</span> orgs, <span class="k">sum</span>(mrr) <span class="k">as</span> mrr',
  '<span class="k">from</span> subscriptions <span class="k">where</span> status = <span class="s">\'active\'</span>',
  '<span class="k">group by</span> plan <span class="k">order by</span> mrr <span class="k">desc</span>;',
].join('\n');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon.png" type="image/png" />
    <!-- This page also answers `Accept: text/markdown`; the link is for readers
         that would rather follow a URL than negotiate. -->
    <link rel="alternate" type="text/markdown" href="/index.md" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Infrawrench" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/screenshots/og-home.png" />
    <meta property="og:image:alt" content="Infrawrench showing an AWS account's EC2 instances as tiles" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/screenshots/og-home.png" />
  </head>
  <body class="hm">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <nav class="hm-nav" aria-label="Primary">
      <div class="hm-wrap hm-nav-inner">
        <a class="hm-logo" href="/">
          <img src="/icon.svg" width="26" height="26" alt="" />
          <span>Infrawrench</span>
        </a>
        <div class="hm-nav-links">
          <a href="/docs">Docs</a>
          <a href="/blog">Blog</a>
          <a href="https://instances.infrawrench.com">Instances</a>
          <a href="#nibblets">Nibblets</a>
          <button type="button" class="hm-nav-btn" data-open-providers>Providers</button>
          <a href="https://join.slack.com/t/infrawrenchllc/shared_invite/zt-3x6hs7pyf-riCnQeurmX_EDkv5Nan_Ig">
            Community
          </a>
          <a class="hm-btn hm-btn-quiet hm-btn-sm" href="https://app.infrawrench.com">Open Cloud</a>
        </div>
      </div>
    </nav>

    <main id="main-content" tabindex="-1">
      <section class="hero hm-wrap">
        <span class="hm-eyebrow">Free desktop app · Cloud for teams</span>
        <h1 class="hm-h1">Every cloud you run on,<br /><span class="hm-grad">one platform.</span></h1>
        <p class="hm-lede">
          Infrawrench connects to {PROVIDER_COUNT_COPY} providers, finds everything you run on them, and gives your
          team one place to run, watch and secure it all and keep the bill in check, with AI agents that ask before
          they act.
        </p>
        <div class="hm-btns">
          <button class="hm-btn hm-btn-primary" type="button" data-open-download>
            <Download /> <span>Download for <span data-os>macOS</span></span>
          </button>
          <a class="hm-btn hm-btn-quiet" href="https://app.infrawrench.com"><Cloud /> Open the cloud app</a>
        </div>
        <p class="hm-note">The desktop app is free, keeps credentials on your machine and needs no account.</p>
        <button class="agent-link" type="button" data-open-agent-skill>
          <Bot size={15} /> Using a coding agent? MCP server and CLI skill
        </button>
      </section>

      <section class="hm-wrap stage" aria-label="Product">
        <div class="stage-tabs" role="tablist">
          {
            heroViews.map((v, i) => (
              <button role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} data-view={v.id}>
                <img src={`/providers/${v.id}.svg`} width="18" height="18" alt="" />
                {v.label}
              </button>
            ))
          }
        </div>
        <div>
          {
            heroViews.map((v, i) => (
              <div data-frame={v.id} hidden={i !== 0}>
                <AppFrame shot={v.shot} title={v.title} alt={`Infrawrench showing ${v.title}`} eager={i === 0} />
              </div>
            ))
          }
        </div>
      </section>

      <section class="hm-section-tight hm-wrap strip">
        <p class="hm-muted">Works with what you already run</p>
        <div class="strip-logos">
          {stripProviders.map((p) => <img src={`/providers/${p.id}.svg`} width="34" height="34" alt={p.name} title={p.name} />)}
          <button type="button" class="strip-more" data-open-providers>and {STRIP_MORE} more</button>
        </div>
      </section>

      {
        steps.map((s, i) => (
          <section class:list={['step hm-wrap', i % 2 && 'flip']}>
            <div class="step-copy">
              <span class="hm-eyebrow">
                <s.icon size={14} /> {String(i + 1).padStart(2, '0')} · {s.kicker}
              </span>
              <h2 class="hm-h2">{s.title}</h2>
              <p class="hm-lede">{s.body}</p>
            </div>
            <div class="step-visual">
              {s.shot && <AppFrame shot={s.shot} title={s.shotTitle} alt={s.alt} />}
              {s.mock === 'terminal' && (
                <div class="hm-frame mock">
                  <div class="hm-frame-bar"><i /><i /><i /><span>SSH · api-prod-1</span></div>
                  <pre class="term" set:html={termHtml} />
                </div>
              )}
              {s.mock === 'sql' && (
                <div class="hm-frame mock">
                  <div class="hm-frame-bar"><i /><i /><i /><span>SQL · orders-aurora</span></div>
                  <div class="sql">
                    <pre class="sql-q" set:html={sqlHtml} />
                    <table>
                      <thead><tr><th>plan</th><th>orgs</th><th>mrr</th></tr></thead>
                      <tbody>
                        <tr><td>team</td><td>1,204</td><td>$86,688</td></tr>
                        <tr><td>business</td><td>212</td><td>$63,388</td></tr>
                        <tr><td>starter</td><td>3,871</td><td>$34,839</td></tr>
                      </tbody>
                    </table>
                    <p class="sql-foot">3 rows · 41 ms</p>
                  </div>
                </div>
              )}
              {s.mock === 'cost' && (
                <div class="hm-frame mock">
                  <div class="hm-frame-bar"><i /><i /><i /><span>Costs · last 30 days</span></div>
                  <div class="cost">
                    <div class="cost-kpis">
                      <div><span>Month to date</span><b>$18,420</b></div>
                      <div><span>Forecast</span><b>$24,910</b></div>
                      <div><span>Anomalies</span><b class="warn">1 new</b></div>
                    </div>
                    <svg viewBox="0 0 520 170" class="cost-chart" aria-hidden="true">
                      {Array.from({ length: 30 }, (_, d) => {
                        const a = 40 + ((d * 37) % 23) + (d > 22 ? 34 : 0);
                        const b = 22 + ((d * 17) % 11);
                        const c = 12 + ((d * 7) % 6);
                        const x = 6 + d * 17;
                        return (
                          <g>
                            <rect x={x} y={160 - a} width="11" height={a} rx="2" class="s1" />
                            <rect x={x} y={160 - a - b} width="11" height={b} rx="2" class="s2" />
                            <rect x={x} y={160 - a - b - c} width="11" height={c} rx="2" class="s3" />
                          </g>
                        );
                      })}
                    </svg>
                    <div class="cost-legend"><span class="l1">AWS</span><span class="l2">Cloudflare</span><span class="l3">Hetzner</span></div>
                  </div>
                </div>
              )}
            </div>
          </section>
        ))
      }

      <section class="hm-section hm-wrap team">
        <div class="team-head">
          <span class="hm-eyebrow">Infrawrench Cloud</span>
          <h2 class="hm-h2">The same app, hosted for your team.</h2>
          <p class="hm-lede">
            Sign in and everything is already there: accounts, terminals, dashboards and history, shared with
            everyone you work with. Free to start; the audit log and API keys are on the paid plan.
          </p>
        </div>
        <div class="team-grid">
          {
            teamBenefits.map((b) => (
              <div>
                <h3 class="hm-h3">{b.title}</h3>
                <p>{b.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="hm-wrap nibblets" id="nibblets">
        <div class="nibblets-card">
          <div class="nibblets-copy">
            <img class="nibblets-mark" src="/nibblets.svg" width="88" height="88" alt="" />
            <span class="hm-eyebrow">Also from Infrawrench</span>
            <h2 class="hm-h2">Nibblets keep watch while you're away.</h2>
            <p class="hm-lede">
              Nibblets are always-on AI agents, each drawn as a hamster you can dress up. They keep working between
              messages, wake on schedules and heartbeats, and message you when they have something to say. Give one a
              scoped identity in Infrawrench and it can look after your clouds overnight.
            </p>
            <div class="hm-btns">
              <a class="hm-btn hm-btn-primary" href="https://nibblets.dev">Meet the nibblets</a>
              <a class="hm-btn hm-btn-quiet" href="https://github.com/Infrawrench/nibblets">View on GitHub</a>
            </div>
          </div>
          <ul class="nibblets-points">
            {
              nibbletsPoints.map((p, i) => {
                const Icon = nibbletsIcons[i] ?? KeyRound;
                return (
                  <li>
                    <span class="nibblets-icon">
                      <Icon size={17} />
                    </span>
                    <div>
                      <h3 class="hm-h3">{p.title}</h3>
                      <p>{p.body}</p>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </section>

      <section class="hm-section hm-center hm-wrap">
        <h2 class="hm-h2">Close a dozen consoles.</h2>
        <p class="hm-lede">Start on your laptop for free. Invite your team when you want shared accounts, roles and on-call.</p>
        <div class="hm-btns">
          <button class="hm-btn hm-btn-brand" type="button" data-open-download>
            <Download /> <span>Download for <span data-os>macOS</span></span>
          </button>
          <a class="hm-btn hm-btn-quiet" href="https://app.infrawrench.com"><Cloud /> Start a team</a>
        </div>
      </section>
    </main>

    <footer class="hm-footer">
      <div class="hm-wrap">
        <span class="hm-muted">© 2026 Infrawrench Services, Inc. All rights reserved.</span>
        <div class="hm-footer-links">
          <a href="https://app.infrawrench.com">Cloud</a>
          <a href="/docs">Docs</a>
          <a href="/blog">Blog</a>
          <a href="https://nibblets.dev">Nibblets</a>
          <a href="/privacy">Privacy</a>
          <button type="button" data-cookie-preferences hidden>Cookie preferences</button>
          <a href="https://join.slack.com/t/infrawrenchllc/shared_invite/zt-3x6hs7pyf-riCnQeurmX_EDkv5Nan_Ig">Slack</a>
        </div>
      </div>
    </footer>

    <ProvidersModal showBar={false} />
    <DownloadModal />
    <AgentSkillModal />
    <Analytics />

    <script>
      // Download buttons name the visitor's platform.
      const ua = navigator.userAgent;
      const os = /Windows/.test(ua) ? 'Windows' : /Linux|X11/.test(ua) && !/Android/.test(ua) ? 'Linux' : 'macOS';
      document.querySelectorAll<HTMLElement>('[data-os]').forEach((el) => (el.textContent = os));

      // The tabs above the hero shot swap which provider it shows.
      const tabs = document.querySelectorAll<HTMLButtonElement>('[data-view]');
      tabs.forEach((t) =>
        t.addEventListener('click', () => {
          tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
          document
            .querySelectorAll<HTMLElement>('[data-frame]')
            .forEach((f) => (f.hidden = f.dataset.frame !== t.dataset.view));
        }),
      );
    </script>
  </body>
</html>

<style>
  .hero {
    padding: 96px 0 56px;
    text-align: center;
  }
  .hero .hm-lede {
    margin-inline: auto;
  }
  .hero .hm-btns {
    justify-content: center;
  }

  .stage {
    position: relative;
  }
  .stage::before {
    content: '';
    position: absolute;
    inset: 10% 8% -4%;
    background: var(--brand);
    filter: blur(110px);
    opacity: 0.22;
    border-radius: 50%;
    z-index: -1;
  }
  .stage-tabs {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }
  .stage-tabs button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px 7px 9px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text-2);
    font: 500 13.5px var(--sans);
    cursor: pointer;
  }
  .stage-tabs button :global(svg) {
    width: 18px;
    height: 18px;
    border-radius: 4px;
  }
  .stage-tabs button[aria-selected='true'] {
    color: var(--text);
    border-color: var(--text);
  }

  .strip {
    text-align: center;
    font-size: 14px;
  }
  .strip-logos {
    margin-top: 18px;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
  }
  .strip-logo :global(svg) {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    filter: grayscale(1);
    opacity: 0.75;
    transition: 0.2s;
  }
  .strip-logo:hover :global(svg) {
    filter: none;
    opacity: 1;
  }
  .strip-more {
    font-size: 14px;
    color: var(--text-2);
  }

  .step {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 64px;
    align-items: center;
    padding: 88px 0;
  }
  .step.flip .step-copy {
    order: 2;
  }
  .step .hm-lede {
    font-size: 17.5px;
  }
  @media (max-width: 880px) {
    .step {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 56px 0;
    }
    .step.flip .step-copy {
      order: 0;
    }
  }

  .mock {
    background: #1c1c1e;
    color: #e4e4e7;
  }
  .term {
    margin: 0;
    padding: 22px;
    font: 13.5px/1.75 var(--mono);
    white-space: pre-wrap;
    min-height: 300px;
  }
  .term :global(.g) {
    color: #4ade80;
  }
  .term :global(.b) {
    color: #93c5fd;
  }
  .term :global(.cursor) {
    display: inline-block;
    width: 8px;
    height: 16px;
    background: #e4e4e7;
    vertical-align: -3px;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .sql {
    padding: 0 0 12px;
  }
  .sql-q {
    margin: 0;
    padding: 18px 22px;
    font: 13.5px/1.7 var(--mono);
    border-bottom: 1px solid #333337;
    white-space: pre-wrap;
  }
  .sql-q :global(.k) {
    color: #fb7185;
  }
  .sql-q :global(.s) {
    color: #fcd34d;
  }
  .sql table {
    width: 100%;
    border-collapse: collapse;
    font: 13.5px var(--mono);
  }
  .sql th,
  .sql td {
    text-align: left;
    padding: 9px 22px;
    border-bottom: 1px solid #2c2c2f;
  }
  .sql th {
    color: #8b8b93;
    font-weight: 500;
  }
  .sql-foot {
    margin: 10px 22px 0;
    font-size: 12px;
    color: #8b8b93;
  }

  .cost {
    padding: 20px 22px;
  }
  .cost-kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .cost-kpis div {
    background: #2c2c2f;
    border-radius: 10px;
    padding: 12px 14px;
  }
  .cost-kpis span {
    display: block;
    font-size: 12px;
    color: #8b8b93;
  }
  .cost-kpis b {
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .cost-kpis .warn {
    color: #fbbf24;
  }
  .cost-chart {
    width: 100%;
    margin-top: 18px;
  }
  .s1 {
    fill: #fb7185;
  }
  .s2 {
    fill: #fb923c;
  }
  .s3 {
    fill: #71717a;
  }
  .cost-legend {
    display: flex;
    gap: 18px;
    font-size: 12px;
    color: #a1a1aa;
  }
  .cost-legend span::before {
    content: '';
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    margin-right: 6px;
  }
  .l1::before {
    background: #fb7185;
  }
  .l2::before {
    background: #fb923c;
  }
  .l3::before {
    background: #71717a;
  }


  .hm-nav-btn {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: var(--text-2);
    cursor: pointer;
  }
  .hm-nav-btn:hover {
    color: var(--text);
  }
  @media (max-width: 720px) {
    .hm-nav-btn {
      display: none;
    }
  }

  .agent-link {
    margin-top: 22px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: none;
    border: 0;
    color: var(--text-2);
    font: 14px var(--sans);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 4px;
  }
  .agent-link:hover {
    color: var(--text);
  }

  .stage-tabs img {
    border-radius: 4px;
  }
  .strip-logos img {
    border-radius: 8px;
    filter: grayscale(1);
    opacity: 0.75;
    transition: 0.2s;
  }
  .strip-logos img:hover {
    filter: none;
    opacity: 1;
  }
  .strip-more {
    background: none;
    border: 0;
    padding: 0;
    font: 14px var(--sans);
    color: var(--text-2);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .team {
    border-top: 1px solid var(--line);
  }
  .team-head {
    max-width: 720px;
  }
  .team-grid {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
  }
  .team-grid div {
    background: var(--surface);
    padding: 26px;
  }
  .team-grid p {
    margin: 8px 0 0;
    color: var(--text-2);
    font-size: 15px;
  }
  @media (max-width: 860px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }

  .nibblets {
    scroll-margin-top: 80px;
  }
  .nibblets-card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: 56px;
    align-items: center;
    padding: 56px;
