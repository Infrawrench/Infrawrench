---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import FeatureExplorer from '../components/FeatureExplorer.astro';
import CloudHighlight from '../components/CloudHighlight.astro';
import InputsOutputs from '../components/InputsOutputs.astro';
import ProvidersModal from '../components/ProvidersModal.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Infrawrench</title>
    <meta
      name="description"
      content="Manage AWS, GCP, Azure, Kubernetes, and 25+ cloud providers from one unified desktop and web app. SSH terminals, SQL editor, K8s exec, storage browser, and more."
    />
    <link rel="icon" href="/icon.png" type="image/png" />
  </head>
  <body>
    <Nav />
    <Hero />
    <FeatureExplorer />
    <CloudHighlight />
    <InputsOutputs />
    <ProvidersModal />
    <Footer />

  </body>
</html>
