---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import FeatureExplorer from '../components/FeatureExplorer.astro';
import CloudHighlight from '../components/CloudHighlight.astro';
import InputsOutputs from '../components/InputsOutputs.astro';
import ProvidersModal from '../components/ProvidersModal.astro';
import DownloadModal from '../components/DownloadModal.astro';
import AgentSkillModal from '../components/AgentSkillModal.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Infrawrench</title>
    <meta
      name="description"
      content="Manage AWS, GCP, Azure, Kubernetes, and 25+ cloud providers from one unified desktop and web app. SSH terminals, SQL editor, K8s exec, storage browser, and more."
    />
    <link rel="icon" href="/icon.png" type="image/png" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Infrawrench" />
    <meta property="og:title" content="Infrawrench" />
    <meta
      property="og:description"
      content="Manage AWS, GCP, Azure, Kubernetes, and 25+ cloud providers from one unified desktop and web app. SSH terminals, SQL editor, K8s exec, storage browser, and more."
    />
    <meta property="og:image" content="/screenshots/hero.png" />
    <meta property="og:image:alt" content="Infrawrench dashboard overview" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Infrawrench" />
    <meta
      name="twitter:description"
      content="Manage AWS, GCP, Azure, Kubernetes, and 25+ cloud providers from one unified desktop and web app. SSH terminals, SQL editor, K8s exec, storage browser, and more."
    />
    <meta name="twitter:image" content="/screenshots/hero.png" />
  </head>
  <body>
    <Nav />
    <Hero />
    <FeatureExplorer />
    <CloudHighlight />
    <InputsOutputs />
    <ProvidersModal />
    <DownloadModal />
    <AgentSkillModal />
    <Footer />

  </body>
</html>
