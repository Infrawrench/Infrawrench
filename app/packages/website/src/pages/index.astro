---
import '../styles/global.css';
import '../styles/home.css';
import AppFrame from '../components/home/AppFrame.astro';
import ProvidersModal from '../components/ProvidersModal.astro';
import DownloadModal from '../components/DownloadModal.astro';
import AgentSkillModal from '../components/AgentSkillModal.astro';
import Analytics from '../components/Analytics.astro';
import {
  ArrowRight,
  Download,
  Cloud,
  Bot,
  Server,
  CircleDollarSign,
  Activity,
  TriangleAlert,
  ShieldCheck,
  GitBranch,
  LayoutDashboard,
  MessageSquare,
  KeyRound,
  ListChecks,
  House,
} from 'lucide-astro';
import {
  PROVIDER_COUNT_COPY,
  STRIP_MORE,
  homeApps,
  nibbletsPoints,
  stripProviders,
  teamBenefits,
} from '../data/home';

const description = `Run AWS, GCP, Azure, Kubernetes, and ${PROVIDER_COUNT_COPY} cloud providers from one platform on desktop, web and mobile. SSH terminals, SQL editor, K8s exec, costs, on-call, CI and AI agents.`;
const title = 'Infrawrench | Every cloud you run on, one platform';

const appIcons: Record<string, typeof Server> = {
  infrastructure: Server,
  costs: CircleDollarSign,
  observability: Activity,
  incidents: TriangleAlert,
  security: ShieldCheck,
  delivery: GitBranch,
  automation: Bot,
  dashboards: LayoutDashboard,
  chat: MessageSquare,
};

const nibbletsIcons = [KeyRound, ListChecks, House];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon.png" type="image/png" />
    <!-- This page also answers `Accept: text/markdown`; the link is for readers
         that would rather follow a URL than negotiate. -->
    <link rel="alternate" type="text/markdown" href="/index.md" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Infrawrench" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/screenshots/og-home.png" />
    <meta property="og:image:alt" content="Infrawrench's Home, with a card for each app and its tools" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/screenshots/og-home.png" />
  </head>
  <body class="hm">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <nav class="hm-nav" aria-label="Primary">
      <div class="hm-wrap hm-nav-inner">
        <a class="hm-logo" href="/">
          <img src="/icon.svg" width="26" height="26" alt="" />
          <span>Infrawrench</span>
        </a>
        <div class="hm-nav-links">
          <a href="/docs">Docs</a>
          <a href="/blog">Blog</a>
          <a href="https://instances.infrawrench.com">Instances</a>
          <a href="#nibblets">Nibblets</a>
          <button type="button" class="hm-nav-btn" data-open-providers>Providers</button>
          <a href="https://join.slack.com/t/infrawrenchllc/shared_invite/zt-3x6hs7pyf-riCnQeurmX_EDkv5Nan_Ig">
            Community
          </a>
          <a class="hm-btn hm-btn-quiet hm-btn-sm" href="https://app.infrawrench.com">Open Cloud</a>
        </div>
      </div>
    </nav>

    <main id="main-content" tabindex="-1">
      <section class="hero hm-wrap">
        <span class="hm-eyebrow">Free desktop app · Cloud for teams</span>
        <h1 class="hm-h1">Every cloud you run on,<br /><span class="hm-grad">one platform.</span></h1>
        <p class="hm-lede">
          Infrawrench connects to {PROVIDER_COUNT_COPY} providers, finds everything you run on them, and gives your
          team one place to run, watch and secure it all and keep the bill in check, with AI agents that ask before
          they act.
        </p>
        <div class="hm-btns">
          <button class="hm-btn hm-btn-primary" type="button" data-open-download>
            <Download /> <span>Download for <span data-os>macOS</span></span>
          </button>
          <a class="hm-btn hm-btn-quiet" href="https://app.infrawrench.com"><Cloud /> Open the cloud app</a>
        </div>
        <p class="hm-note">The desktop app is free, keeps credentials on your machine and needs no account.</p>
        <button class="agent-link" type="button" data-open-agent-skill>
          <Bot size={15} /> Using a coding agent? MCP server and CLI skill
        </button>
      </section>

      {/* The product, as the apps it is made of: a grid of them beside a
          screenshot of the selected one. It walks through them on its own
          until the visitor picks one (see the script below). */}
      <section class="hm-wrap apps" id="apps" aria-label="Apps">
        <div class="apps-body">
          <div class="apps-grid" role="tablist" aria-label="Apps" aria-orientation="vertical">
            {
              homeApps.map((app, i) => {
                const Icon = appIcons[app.id] ?? Server;
                return (
                  <button
                    role="tab"
                    type="button"
                    id={`app-tab-${app.id}`}
                    aria-controls={`app-panel-${app.id}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                    data-app={app.id}
                  >
                    <Icon size={18} />
                    <span>{app.name}</span>
                  </button>
                );
              })
            }
          </div>
          {/* Every panel sits in the same grid cell and holds the same things
              at the same size, so nothing moves as they change. */}
          <div class="apps-panels">
            {
              homeApps.map((app, i) => (
                <div
                  class="apps-panel"
                  role="tabpanel"
                  id={`app-panel-${app.id}`}
                  aria-labelledby={`app-tab-${app.id}`}
                  data-app-panel={app.id}
                  data-active={i === 0 ? 'true' : 'false'}
                >
                  <AppFrame
                    shot={`app-${app.id}`}
                    title={app.name}
                    alt={`The ${app.name} app in Infrawrench`}
                    eager={i === 0}
                  />
                  <div class="apps-foot">
                    <p>{app.tools.map((tool) => tool.name).join(' · ')}</p>
                    <a class="apps-more" href={`/apps/${app.id}`}>
                      Learn more <ArrowRight size={14} />
                    </a>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="hm-section-tight hm-wrap strip">
        <p class="hm-muted">Works with what you already run</p>
        <div class="strip-logos">
          {stripProviders.map((p) => <img src={`/providers/${p.id}.svg`} width="34" height="34" alt={p.name} title={p.name} />)}
          <button type="button" class="strip-more" data-open-providers>and {STRIP_MORE} more</button>
        </div>
      </section>

      <section class="hm-section hm-wrap team">
        <div class="team-head">
          <span class="hm-eyebrow">Infrawrench Cloud</span>
          <h2 class="hm-h2">The same app, hosted for your team.</h2>
          <p class="hm-lede">
            Sign in and everything is already there: accounts, terminals, dashboards and history, shared with
            everyone you work with. Free to start; the audit log and API keys are on the paid plan.
          </p>
        </div>
        <div class="team-grid">
          {
            teamBenefits.map((b) => (
              <div>
                <h3 class="hm-h3">{b.title}</h3>
                <p>{b.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="hm-wrap nibblets" id="nibblets">
        <div class="nibblets-card">
          <div class="nibblets-copy">
            <img class="nibblets-mark" src="/nibblets.svg" width="88" height="88" alt="" />
            <span class="hm-eyebrow">Also from Infrawrench</span>
            <h2 class="hm-h2">Nibblets keep watch while you're away.</h2>
            <p class="hm-lede">
              Nibblets are always-on AI agents, each drawn as a hamster you can dress up. They keep working between
              messages, wake on schedules and heartbeats, and message you when they have something to say. Give one a
              scoped identity in Infrawrench and it can look after your clouds overnight.
            </p>
            <div class="hm-btns">
              <a class="hm-btn hm-btn-primary" href="https://nibblets.dev">Meet the nibblets</a>
              <a class="hm-btn hm-btn-quiet" href="https://github.com/Infrawrench/nibblets">View on GitHub</a>
            </div>
          </div>
          <ul class="nibblets-points">
            {
              nibbletsPoints.map((p, i) => {
                const Icon = nibbletsIcons[i] ?? KeyRound;
                return (
                  <li>
                    <span class="nibblets-icon">
                      <Icon size={17} />
                    </span>
                    <div>
                      <h3 class="hm-h3">{p.title}</h3>
                      <p>{p.body}</p>
                    </div>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </section>

      <section class="hm-section hm-center hm-wrap">
        <h2 class="hm-h2">Close a dozen consoles.</h2>
        <p class="hm-lede">Start on your laptop for free. Invite your team when you want shared accounts, roles and on-call.</p>
        <div class="hm-btns">
          <button class="hm-btn hm-btn-brand" type="button" data-open-download>
            <Download /> <span>Download for <span data-os>macOS</span></span>
          </button>
          <a class="hm-btn hm-btn-quiet" href="https://app.infrawrench.com"><Cloud /> Start a team</a>
        </div>
      </section>
    </main>

    <footer class="hm-footer">
      <div class="hm-wrap">
        <span class="hm-muted">© 2026 Infrawrench Services, Inc. All rights reserved.</span>
        <div class="hm-footer-links">
          <a href="https://app.infrawrench.com">Cloud</a>
          <a href="/docs">Docs</a>
          <a href="/blog">Blog</a>
          <a href="https://nibblets.dev">Nibblets</a>
          <a href="/privacy">Privacy</a>
          <button type="button" data-cookie-preferences hidden>Cookie preferences</button>
          <a href="https://join.slack.com/t/infrawrenchllc/shared_invite/zt-3x6hs7pyf-riCnQeurmX_EDkv5Nan_Ig">Slack</a>
        </div>
      </div>
    </footer>

    <ProvidersModal showBar={false} />
    <DownloadModal />
    <AgentSkillModal />
    <Analytics />

    <script>
      // Download buttons name the visitor's platform.
      const ua = navigator.userAgent;
      const os = /Windows/.test(ua) ? 'Windows' : /Linux|X11/.test(ua) && !/Android/.test(ua) ? 'Linux' : 'macOS';
      document.querySelectorAll<HTMLElement>('[data-os]').forEach((el) => (el.textContent = os));

      // The apps explorer: a tab per app. Until the visitor picks one it
      // walks through them on its own, so the section shows what is there
      // without asking for a click. A click, a key or keyboard focus stops it
      // for good; hovering only holds it. It never runs for visitors who ask
      // for reduced motion, or while the section is off screen.
      const appTabs = [...document.querySelectorAll<HTMLButtonElement>('[data-app]')];
      const appPanels = document.querySelectorAll<HTMLElement>('[data-app-panel]');
      const selectApp = (tab: HTMLButtonElement) => {
        appTabs.forEach((x) => {
          x.setAttribute('aria-selected', String(x === tab));
          x.tabIndex = x === tab ? 0 : -1;
        });
        appPanels.forEach((p) => (p.dataset.active = String(p.dataset.appPanel === tab.dataset.app)));
      };
      let cycling = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      let held = false;
      let visible = false;
      const stopCycling = () => (cycling = false);
      appTabs.forEach((tab, i) => {
        tab.addEventListener('click', () => {
          stopCycling();
          selectApp(tab);
        });
        tab.addEventListener('keydown', (e) => {
          const step = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
          if (!step) return;
          e.preventDefault();
          stopCycling();
          const next = appTabs[(i + step + appTabs.length) % appTabs.length]!;
          selectApp(next);
          next.focus();
        });
      });
      const appsSection = document.querySelector<HTMLElement>('.apps');
      if (appsSection) {
        appsSection.addEventListener('pointerenter', () => (held = true));
        appsSection.addEventListener('pointerleave', () => (held = false));
        appsSection.addEventListener('focusin', stopCycling);
        new IntersectionObserver(([entry]) => (visible = Boolean(entry?.isIntersecting)), {
          threshold: 0.4,
        }).observe(appsSection);
        setInterval(() => {
          if (!cycling || held || !visible || document.hidden) return;
          const current = appTabs.findIndex((x) => x.getAttribute('aria-selected') === 'true');
          selectApp(appTabs[(current + 1) % appTabs.length]!);
        }, 4500);
      }
    </script>
  </body>
</html>

<style>
  .hero {
    padding: 96px 0 56px;
    text-align: center;
  }
  .hero .hm-lede {
    margin-inline: auto;
  }
  .hero .hm-btns {
    justify-content: center;
  }

  .strip {
    text-align: center;
    font-size: 14px;
  }
  .strip-logos {
    margin-top: 18px;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 22px;
  }
  .strip-logo :global(svg) {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    filter: grayscale(1);
    opacity: 0.75;
    transition: 0.2s;
  }
  .strip-logo:hover :global(svg) {
    filter: none;
    opacity: 1;
  }
  .strip-more {
    font-size: 14px;
    color: var(--text-2);
  }

  .apps {
    position: relative;
  }
  .apps::before {
    content: '';
    position: absolute;
    inset: 10% 8% -4%;
    background: var(--brand);
    filter: blur(110px);
    opacity: 0.22;
    border-radius: 50%;
    z-index: -1;
  }
  .apps-body {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
  }
  .apps-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .apps-grid button {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 12px;
    border-radius: 12px;
    /* A 2px border on every tile, so selecting one never moves the grid. */
    border: 2px solid var(--line);
    background: var(--surface);
    color: var(--text-2);
    font: inherit;
    font-size: 13.5px;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .apps-grid button:hover {
    border-color: var(--line-2);
    color: var(--text);
  }
  .apps-grid button[aria-selected='true'] {
    border-color: var(--rose);
    color: var(--text);
  }
  .apps-grid button:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: 2px;
  }
  .apps-panels {
    display: grid;
  }
  .apps-panel {
    grid-area: 1 / 1;
    min-width: 0;
    /* Swapped at once: a cross-fade between two screenshots of the same
       window reads as a flicker. */
    visibility: hidden;
  }
  .apps-panel[data-active='true'] {
    visibility: visible;
  }
  .apps-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-top: 14px;
    font-size: 14px;
  }
  .apps-foot p {
    margin: 0;
    color: var(--text-2);
  }
  .apps-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    font-weight: 500;
    color: var(--text);
  }
  @media (max-width: 880px) {
    .apps-body {
      grid-template-columns: 1fr;
    }
    .apps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 520px) {
    .apps-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .apps-grid button {
      transition: none;
    }
  }

  .hm-nav-btn {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: var(--text-2);
    cursor: pointer;
  }
  .hm-nav-btn:hover {
    color: var(--text);
  }
  @media (max-width: 720px) {
    .hm-nav-btn {
      display: none;
    }
  }

  .agent-link {
    margin-top: 22px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: none;
    border: 0;
    color: var(--text-2);
    font: 14px var(--sans);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 4px;
  }
  .agent-link:hover {
    color: var(--text);
  }

  .strip-logos img {
    border-radius: 8px;
    filter: grayscale(1);
    opacity: 0.75;
    transition: 0.2s;
  }
  .strip-logos img:hover {
    filter: none;
    opacity: 1;
  }
  .strip-more {
    background: none;
    border: 0;
    padding: 0;
    font: 14px var(--sans);
    color: var(--text-2);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .team {
    border-top: 1px solid var(--line);
  }
  .team-head {
    max-width: 720px;
  }
  .team-grid {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
  }
  .team-grid div {
    background: var(--surface);
    padding: 26px;
  }
  .team-grid p {
    margin: 8px 0 0;
    color: var(--text-2);
    font-size: 15px;
  }
  @media (max-width: 860px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }

  .nibblets {
    scroll-margin-top: 80px;
  }
  .nibblets-card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: 56px;
    align-items: center;
    padding: 56px;
    border-radius: 28px;
    background: linear-gradient(160deg, #dcebfa, #a9cbee);
    color: #0f172a;
  }
  .nibblets-card .hm-eyebrow {
    color: #334155;
  }
  .nibblets-card .hm-lede {
    color: #1e293b;
  }
  .nibblets-card .hm-btn-primary {
    background: #0f172a;
    color: #fff !important;
  }
  .nibblets-card .hm-btn-quiet {
    background: rgb(255 255 255 / 0.6);
    border-color: rgb(15 23 42 / 0.15);
    color: #0f172a !important;
  }
  .nibblets-mark {
    display: block;
    margin-bottom: 18px;
    border-radius: 22px;
    box-shadow: 0 12px 30px -10px rgb(30 64 175 / 0.45);
  }
  .nibblets-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .nibblets-points li {
    display: flex;
    gap: 14px;
    padding: 20px;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.62);
    backdrop-filter: blur(6px);
  }
  .nibblets-points p {
    margin: 6px 0 0;
    font-size: 14.5px;
    color: #334155;
  }
  .nibblets-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: #fff;
    color: #1d4ed8;
  }
  @media (max-width: 900px) {
    .nibblets-card {
      grid-template-columns: 1fr;
      padding: 28px 22px;
      gap: 28px;
    }
  }

</style>
