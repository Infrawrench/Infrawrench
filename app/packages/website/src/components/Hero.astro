---
import { Apple, Monitor, MessageSquare } from 'lucide-astro';
---

<script>
  import { typewriterStrings } from '../data/content';
  import Typewriter from 'typewriter-effect/dist/core';

  new Typewriter('#typewriter', {
    strings: typewriterStrings,
    autoStart: true,
    loop: true,
    delay: 55,
    deleteSpeed: 35,
  });
</script>

<section class="hero hero-glow">
  <div style="max-width: 820px; margin: 0 auto;">
    <h1>Your infrastructure,<br /><em>unified.</em></h1>
    <p class="hero-sub">The desktop and cloud platform for managing</p>
    <p class="typewriter-line">
      <span id="typewriter"></span>
    </p>
  </div>

  <!-- Download cards -->
  <div style="max-width: 640px; margin: 32px auto 0; padding: 0 28px;">
    <div class="download-grid">
      <div class="download-card">
        <Apple size={22} color="#9ca3af" />
        <div class="download-card-name">macOS</div>
        <div class="download-card-sub">Apple Silicon</div>
        <div class="coming-soon-badge">Coming Soon</div>
      </div>
      <div class="download-card">
        <Apple size={22} color="#9ca3af" />
        <div class="download-card-name">macOS</div>
        <div class="download-card-sub">Intel (x64)</div>
        <div class="coming-soon-badge">Coming Soon</div>
      </div>
      <div class="download-card">
        <svg width="22" height="22" viewBox="0 0 88 88" fill="none" aria-hidden="true">
          <path
            d="M0 12.4L35.7 7.5l.1 34.4-35.7.2zm35.7 33.5l.1 34.5L.1 75.5.1 45.7zm4.3-39L87.3 0v41.5l-47.3.4zm47.3 39.4L87.3 88 40 81.1l-.1-34z"
            fill="#9ca3af"></path>
        </svg>
        <div class="download-card-name">Windows</div>
        <div class="download-card-sub">x64 · Installer</div>
        <div class="coming-soon-badge">Coming Soon</div>
      </div>
      <div class="download-card">
        <Monitor size={22} color="#9ca3af" />
        <div class="download-card-name">Linux</div>
        <div class="download-card-sub">AppImage · x64</div>
        <div class="coming-soon-badge">Coming Soon</div>
      </div>
    </div>

    <p class="my-4 text-sm text-gray-500">
      Cloud app coming soon.
    </p>

    <div
      style="margin: 16px auto 0; max-width: 480px; background: #090909; border: 1px solid #151515; border-radius: 10px; padding: 16px 20px; text-align: left; display: flex; align-items: flex-start; gap: 14px;"
    >
      <MessageSquare size={18} color="#4b5563" style="margin-top: 2px; flex-shrink: 0;" />
      <div>
        <p style="font-size: 13.5px; font-weight: 600; color: #e5e7eb; margin: 0 0 3px;">
          Want early access?
        </p>
        <p style="font-size: 13px; color: #6b7280; margin: 0;">
          Join the Slack to get notified when the first build drops.
        </p>
        <a
          href="https://join.slack.com/t/infrawrenchllc/shared_invite/zt-3x6hs7pyf-riCnQeurmX_EDkv5Nan_Ig"
          style="display: inline-block; margin-top: 10px; font-size: 13px; font-weight: 600; color: #60a5fa; text-decoration: none;"
        >
          Join Slack →
        </a>
      </div>
    </div>
  </div>

  <!-- Hero screenshot -->
  <div style="max-width: 1100px; margin: 56px auto 0; padding: 0 4px;">
    <div class="screenshot">
      <img src="/screenshots/hero.png" alt="Infrawrench app overview" class="screenshot-img" />
    </div>
  </div>
</section>
