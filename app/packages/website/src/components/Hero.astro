---
import { Cloud, Download } from 'lucide-astro';

const capabilities = [
  'SSH terminals',
  'Kubernetes exec & logs',
  'SQL editor',
  'KV console',
  'Object storage browser',
  'Dashboards & budgets',
  'Cost tracking',
  'AI chat & workflows',
];
---

<script>
  import { typewriterStrings } from '../data/typewriter-strings';
  import Typewriter from 'typewriter-effect/dist/core';

  new Typewriter('#typewriter', {
    strings: typewriterStrings,
    autoStart: true,
    loop: true,
    delay: 55,
    deleteSpeed: 35,
  });
</script>

<section class="hero hero-glow">
  <div style="max-width: 860px; margin: 0 auto;">
    <h1>Your infrastructure,<br /><em>unified.</em></h1>
    <p class="hero-sub">The desktop and cloud platform for managing</p>
    <p class="typewriter-line">
      <span id="typewriter"></span>
    </p>

    <p class="hero-lede">
      Connect your provider accounts and Infrawrench discovers every resource in them, then gives
      you the tools to actually work on it: open an SSH terminal or a pod shell, run a query, browse
      a bucket, watch costs, and create new resources from typed forms, across 25+ providers, in
      one app instead of a dozen consoles.
    </p>

    <div class="hero-chips">
      {capabilities.map((c) => <span class="hero-chip">{c}</span>)}
    </div>

    <div class="hero-ctas">
      <a class="btn-primary" href="https://app.infrawrench.com">
        <Cloud size={17} />
        Open the cloud app
      </a>
      <button class="btn-secondary" type="button" data-open-download>
        <Download size={17} />
        Download the app
      </button>
    </div>

    <p class="hero-cta-note">
      Run it in your browser with nothing to install, or download the desktop app for macOS,
      Windows, and Linux and keep everything local, free and with no account required.
    </p>
  </div>
</section>
