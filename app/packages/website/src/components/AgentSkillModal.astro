---
import { harnessVariants } from "../data/agent-skill";
import SkillFiles from "./SkillFiles.astro";
---

<div class="modal-overlay" id="agent-skill-modal" role="dialog" aria-modal="true" aria-label="Use with your coding agent">
  <div class="modal-box">
    <div class="modal-header">
      <div>
        <h2 class="modal-title">Use with your coding agent</h2>
        <p class="modal-subtitle">
          Connect the hosted MCP server and add our skills to your repo: your agent can list resources, chart metrics
          and costs, page on-call, and move your CI over.
        </p>
      </div>
      <button class="modal-close" id="close-agent-skill-modal" type="button" data-close-modal aria-label="Close"
        >✕</button
      >
    </div>

    <div class="modal-body">
      <div>
        <div class="agent-skill-tabs" role="tablist" aria-label="Agent harness">
          {
            harnessVariants.map((h) => (
              <button class="agent-skill-tab" type="button" role="tab" data-tabset="agent-harness" data-tab={h.id}>
                {h.label}
              </button>
            ))
          }
        </div>

        {
          harnessVariants.map((h) => (
            <div class="agent-skill-panel" role="tabpanel" data-tabset="agent-harness" data-panel={h.id}>
              <div>
                <p class="agent-skill-section-label">MCP server</p>
                <div class="agent-skill-file">
                  <div class="agent-skill-panel-head">
                    <code class="agent-skill-path">{h.mcp.file}</code>
                    <button class="agent-skill-copy-btn" type="button" data-skill-copy>
                      Copy
                    </button>
                  </div>
                  <pre class="agent-skill-code"><code set:text={h.mcp.content} /></pre>
                </div>
                <p class="agent-skill-note">
                  Signs in through your browser on first connect (OAuth), with tools for resources, costs, workflows, CI,
                  SQL, SSH, and more.
                </p>
              </div>

              <div>
                <p class="agent-skill-section-label">Skills</p>
                <div class="agent-skill-list">
                  {h.skills.map((s) => (
                    <details class="agent-skill-details">
                      <summary>
                        <span class="agent-skill-details-title">{s.skill.title}</span>
                        <span class="agent-skill-details-summary">{s.skill.summary}</span>
                      </summary>
                      <SkillFiles item={s} tabset={`agent-${h.id}-${s.skill.id}`} />
                    </details>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  import "../lib/skill-ui";
</script>
