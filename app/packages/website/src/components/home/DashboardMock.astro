---
// A drawn dashboard, not a screenshot: the figures are the fake "Acme"
// organization's. One SVG with the screenshots' own proportions (1240x740),
// so it sits in the home page's explorer at exactly the height of the
// screenshots beside it and scales with them.
interface Props {
  title?: string;
  class?: string;
}
const { title = 'Dashboards', class: cls } = Astro.props;

const kpis = [
  { label: 'Month to date', value: '$18,420', note: '+6% on last month' },
  { label: 'Forecast', value: '$24,910', note: 'Budget $26,000' },
  { label: 'Uptime, 30 days', value: '99.97%', note: '12 probes' },
  { label: 'Open incidents', value: '0', note: 'Last one 9 days ago' },
];
const budgets = [
  { name: 'Production', used: 74 },
  { name: 'Staging', used: 41 },
  { name: 'Data platform', used: 92 },
];
const resources = [
  { name: 'api-prod-1', kind: 'EC2 instance', stat: 'CPU 38%', points: [22, 26, 21, 30, 34, 28, 33, 41, 36, 38] },
  { name: 'orders-aurora', kind: 'Aurora cluster', stat: '212 connections', points: [30, 31, 29, 34, 33, 36, 35, 38, 37, 40] },
  { name: 'prod-eu', kind: 'Kubernetes cluster', stat: '14 nodes', points: [26, 26, 28, 28, 28, 30, 30, 30, 32, 32] },
  { name: 'edge-router', kind: 'Cloudflare Worker', stat: '1.2k req/s', points: [18, 24, 31, 27, 36, 42, 33, 39, 44, 41] },
];
const bars = Array.from({ length: 30 }, (_, d) => ({
  a: 40 + ((d * 37) % 23) + (d > 22 ? 34 : 0),
  b: 22 + ((d * 17) % 11),
  c: 12 + ((d * 7) % 6),
}));
const spark = (points: number[], x: number, y: number, w: number, h: number) =>
  points.map((p, i) => `${x + (i * w) / (points.length - 1)},${y + h - ((p - 15) / 32) * h}`).join(' ');
---

<figure class:list={['hm-frame dash-mock', cls]} style="margin:0">
  <div class="hm-frame-bar"><i></i><i></i><i></i><span>{title}</span></div>
  <svg viewBox="0 0 1240 740" role="img" aria-label="A dashboard with spend, budgets, uptime and four pinned resources">
    <rect width="1240" height="740" class="bg" />
    <text x="32" y="50" class="h">Overview</text>
    <text x="32" y="74" class="m">Acme · shared with everyone</text>

    {
      kpis.map((k, i) => {
        const x = 32 + i * 298;
        return (
          <g>
            <rect x={x} y="98" width="282" height="104" rx="12" class="card" />
            <text x={x + 18} y="128" class="m">{k.label}</text>
            <text x={x + 18} y="164" class="v">{k.value}</text>
            <text x={x + 18} y="186" class="s">{k.note}</text>
          </g>
        );
      })
    }

    <rect x="32" y="218" width="728" height="300" rx="12" class="card" />
    <text x="50" y="250" class="t">Spend, last 30 days</text>
    {
      bars.map((bar, d) => {
        const x = 52 + d * 23.2;
        const base = 492;
        const k = 1.75;
        return (
          <g>
            <rect x={x} y={base - bar.a * k} width="15" height={bar.a * k} rx="2" class="s1" />
            <rect x={x} y={base - (bar.a + bar.b) * k} width="15" height={bar.b * k} rx="2" class="s2" />
            <rect x={x} y={base - (bar.a + bar.b + bar.c) * k} width="15" height={bar.c * k} rx="2" class="s3" />
          </g>
        );
      })
    }

    <rect x="776" y="218" width="432" height="300" rx="12" class="card" />
    <text x="794" y="250" class="t">Budgets</text>
    {
      budgets.map((b, i) => {
        const y = 286 + i * 74;
        return (
          <g>
            <text x="794" y={y} class="n">{b.name}</text>
            <text x="1190" y={y} class="m" text-anchor="end">{b.used}%</text>
            <rect x="794" y={y + 12} width="396" height="10" rx="5" class="track" />
            <rect x="794" y={y + 12} width={(396 * b.used) / 100} height="10" rx="5" class={b.used > 85 ? 'warn' : 'fill'} />
          </g>
        );
      })
    }

    {
      resources.map((r, i) => {
        const x = 32 + i * 298;
        return (
          <g>
            <rect x={x} y="534" width="282" height="174" rx="12" class="card" />
            <circle cx={x + 24} cy="562" r="4" class="ok" />
            <text x={x + 36} y="567" class="n">{r.name}</text>
            <text x={x + 18} y="592" class="s">{r.kind}</text>
            <polyline points={spark(r.points, x + 18, 610, 246, 52)} class="line" />
            <text x={x + 18} y="690" class="m">{r.stat}</text>
          </g>
        );
      })
    }
  </svg>
</figure>

<style>
  .dash-mock svg {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--sans);
  }
  .bg {
    fill: #1c1c1e;
  }
  .card {
    fill: #26262a;
    stroke: #333337;
  }
  .h {
    fill: #f4f4f5;
    font-size: 22px;
    font-weight: 600;
  }
  .t,
  .n {
    fill: #e4e4e7;
    font-size: 15px;
    font-weight: 500;
  }
  .v {
    fill: #f4f4f5;
    font-size: 28px;
    font-weight: 600;
  }
  .m {
    fill: #a1a1aa;
    font-size: 13px;
  }
  .s {
    fill: #8b8b93;
    font-size: 12px;
  }
  .s1 {
    fill: #fb7185;
  }
  .s2 {
    fill: #fb923c;
  }
  .s3 {
    fill: #71717a;
  }
  .track {
    fill: #3a3a40;
  }
  .fill {
    fill: #e4e4e7;
  }
  .warn {
    fill: #fbbf24;
  }
  .ok {
    fill: #4ade80;
  }
  .line {
    fill: none;
    stroke: #e4e4e7;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
</style>
