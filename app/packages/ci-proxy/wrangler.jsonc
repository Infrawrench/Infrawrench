// The CI proxy: the one public front of the iwci runner pool. It
// authenticates callers, places runs on the runner with the most free
// slots, routes status and log requests back to the runner that has the
// run, and fires `on.schedule` pipelines from a once-a-minute Cron Trigger.
// See README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infrawrench-ci-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "ci-proxy.infrawrench.com", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  // Once a minute: the proxy decides which registered schedules are due.
  // Cron Triggers fire once for the whole Worker, which is what makes a
  // pool of runners fire each schedule once.
  "triggers": { "crons": ["* * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "infrawrench-ci-proxy",
      "database_id": "86de677f-0668-466d-98c2-ae1678d08f63",
      "migrations_dir": "migrations",
    },
  ],

  // The runners' bucket (IWCI_R2_BUCKET), never `infrawrench-ci`, which
  // holds something else. The proxy serves jobs' downloads from it and sweeps
  // the expired ones (src/artifacts.ts).
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "infrawrench-ci-runners" }],

  "vars": {
    // Only used while the `runners` table is empty: comma-separated
    // `name=url` entries (or plain URLs, named by position). The Terraform
    // that provisions runner hosts sets the table with `PUT /v1/runners`.
    "RUNNERS": "local=http://127.0.0.1:8547",
  },

  // Secrets (wrangler secret put):
  //   PROXY_KEY   the bearer key callers send to this Worker
  //   RUNNER_KEY  the IWCI_SERVER_KEY the runners were started with
  //   SECRETS_KEY 32 random bytes, base64: seals stored secrets (README.md)
  //   ARTIFACT_SIGNING_KEY  signs download links; the app's CI_ARTIFACT_SIGNING_KEY
}
