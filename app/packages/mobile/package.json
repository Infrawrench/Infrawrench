{
  "name": "@infrawrench/mobile",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "node scripts/build-terminal-html.mjs && expo start",
    "android": "node scripts/build-terminal-html.mjs && expo run:android",
    "ios": "node scripts/build-terminal-html.mjs && expo run:ios",
    "prebuild:terminal": "node scripts/build-terminal-html.mjs",
    "eas-build-post-install": "pnpm -w exec turbo build --filter='@infrawrench/mobile^...' && node scripts/build-terminal-html.mjs",
    "typecheck": "node scripts/build-terminal-html.mjs && tsgo --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .expo dist assets/generated"
  },
  "dependencies": {
    "@infrawrench/client-core": "workspace:*",
    "@infrawrench/plugin-base": "workspace:*",
    "@tanstack/react-query": "^5.66.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "expo": "~54.0.0",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.10",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.9",
    "expo-crypto": "~15.0.7",
    "expo-device": "~8.0.9",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.16",
    "expo-linking": "~8.0.8",
    "expo-notifications": "~0.32.12",
    "expo-router": "~6.0.11",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "~14.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
