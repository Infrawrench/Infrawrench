{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // An app: nothing reads its declarations, and emitting them makes the
    // compiler serialize the contract-derived registry types (TS7056).
    "declaration": false,
    "declarationMap": false,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "outDir": "out",
    "rootDir": ".",
    "types": ["node", "electron", "sql.js"]
  },
  "include": ["electron", "src/db/schema.ts", "src/lib/deploy-history-types.ts", "shared"]
}
