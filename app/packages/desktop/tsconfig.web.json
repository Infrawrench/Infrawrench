{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@blessed-plugins": ["../web/src/plugins/blessed-plugins.json"]
    }
  },
  "include": ["src", "env.ts"],
  "exclude": ["node_modules"]
}
