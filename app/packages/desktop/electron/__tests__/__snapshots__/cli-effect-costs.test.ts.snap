exports[`costs > refuses bad flags in the legacy words > 2 $ infrawrench costs --charge-type fees 1`] = `
{
  "requests": [],
  "stderr": "DESCRIPTION
  Org cost graphs; --anomalies lists spend spikes, --alerts change-based cost alerts

USAGE
  infrawrench costs <subcommand> [flags]

FLAGS
  --last span                          How far back: 7d, 30d, 12w or 3m
  --from date                          Start of the range (YYYY-MM-DD or an ISO timestamp)
  --to date                            End of the range (YYYY-MM-DD or an ISO timestamp)
  --days n                             costs --anomalies: whole-day window (max 90)
  --limit n                            costs --alerts: recent firings to list (default 20, max 200)
  --group-by dimension                 provider (default), account, service, region, resource, charge_type, commitment, or tag:<key> / virtual_tag:<key> / k8s_node_label:<key> / k8s_pvc_label:<key> / k8s_pod_label:<key>
  --basis cash|amortized|blended       Which cost to sum (default cash)
  --currency code                      Convert to your org's display currency (stated rates, then automatic ECB rates if on)
  --where query                        Filter in the cost query language, e.g. "provider = 'aws' AND tag['env'] != 'dev'"
  --filter name|id                     A saved cost filter, resolved on the server; combines with --where by AND
  --charge-type type                   Keep only this kind of charge (repeatable): usage, commitment_covered_usage, commitment_fee, commitment_discount, credit, tax, refund, adjustment, support, other
  --measure cost|usage|count           What to sum: cost (money), usage (quantities, with --unit) or count
  --bin hour|day|week|month|quarter    The date bins
  --unit unit                          With --measure usage: the unit to sum, as the provider spells it
  --cumulative                         Running totals from the start of the range
  --x-axis dimension                   Put a dimension's values on the X axis (tag:<key> for a tag; date for the bins)
  --segment-by-date                    With --x-axis and no --group-by: split each value's bar by date bin
  --compare                            Add the previous period of the same length, with the change
  --alerts                             Change-based cost alerts and recent firings ("spend moved >X%")
  --anomalies                          Days a provider or service spiked past its own baseline; also introduces feedback, suppressions, precision and sensitivity

INHERITED FLAGS
  --json                   Print JSON (same as --output json)
  --text                   Print text, the default (same as --output text)
  --output, -o choice      Output mode (choices: json, text)
  --org id|name            Scope to one organization (default: INFRAWRENCH_ORG, or your only one)
  --local                  Scope to the local (desktop) workspace
  --account, -a id|name    Account id or name for resource commands
  --color                  ANSI colours (--no-color turns them off)

GLOBAL FLAGS
  --help, -h       Show help information
  --version, -v    Show version information

SUBCOMMANDS
  tag-keys        The tag keys in your cost data, Kubernetes node and volume labels grouped
  forecast        A saved report's projected spend with its low/expected/high band (default: next 90 days)
  forecasts       A report's named forecasts, the default marked
  push            Push your own cost rows (--file or stdin), or upload a CSV/FOCUS file into a custom source
  sources         Custom cost sources (uploaded spend); "costs sources <name>" for one's upload history
  feedback        Tell detection what a spike was: --expected | --unexpected | --clear (after --anomalies)
  suppressions    What is kept from alerting: scope, recurrence, window, hits, reason (after --anomalies)
  precision       Per-month share of reviewed findings marked unexpected (after --anomalies)
  sensitivity     Providers and services whose threshold feedback has raised, and why (after --anomalies)

ERROR
  --charge-type must be one of usage, commitment_covered_usage, commitment_fee, commitment_discount, credit, tax, refund, adjustment, support, other (got "fees").
",
  "stdout": "",
}
`;

