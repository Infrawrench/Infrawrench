exports[`costs push and sources > refuses bad input in the legacy words > 2 $ infrawrench costs push --source colo --format xml --file <dir>/plain.csv 1`] = `
{
  "requests": [],
  "stderr": "DESCRIPTION
  Push your own cost rows (--file or stdin), or upload a CSV/FOCUS file into a custom source

USAGE
  infrawrench costs push [flags]

FLAGS
  --source name                Who is pushing: the system raising this (required)
  --file, -f path              JSON rows, or a CSV / FOCUS file with --format (stdin when omitted)
  --format json|csv|focus      What the rows are: json (default), csv or focus
  --map field=column           --format csv: map a column (date, cost, currency, service, account, region, resource, usageQuantity, usageUnit, tags; tag=<col> keeps a column as a tag). Repeatable
  --currency code              Currency for CSV rows with no currency column
  --date-format ymd|mdy|dmy    Order of slash-separated CSV dates
  --replace                    Dates overlap an earlier upload: supersede its spend
  --append                     Dates overlap an earlier upload: add to its spend

INHERITED FLAGS
  --json                   Print JSON (same as --output json)
  --text                   Print text, the default (same as --output text)
  --output, -o choice      Output mode (choices: json, text)
  --org id|name            Scope to one organization (default: INFRAWRENCH_ORG, or your only one)
  --local                  Scope to the local (desktop) workspace
  --account, -a id|name    Account id or name for resource commands
  --color                  ANSI colours (--no-color turns them off)
  --anomalies              Days a provider or service spiked past its own baseline; also introduces feedback, suppressions, precision and sensitivity

GLOBAL FLAGS
  --help, -h       Show help information
  --version, -v    Show version information

ERROR
  --format for costs push must be json, csv or focus.
",
  "stdout": "",
}
`;

