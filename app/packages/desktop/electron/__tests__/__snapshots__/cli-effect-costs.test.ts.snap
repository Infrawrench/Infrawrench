exports[`page > refuses a page with nothing to say, no source, a bad cooldown or --local > 2 $ infrawrench page hi --source monitor --cooldown 1.5 1`] = `
{
  "requests": [],
  "stderr": "DESCRIPTION
  Alert the org's on-call transports (page clear drops a key's cooldown)

USAGE
  infrawrench page <subcommand> [flags] [<message...>]

ARGUMENTS
  message... string    The alert text (the words join into one message) (optional)

FLAGS
  --source name     Who is pushing: the system raising this (required)
  --key k           The throttle key (the server defaults it to "default")
  --title t         A title above the message
  --cooldown min    Minutes to suppress repeat pages under the same key
  --voice           Also place a voice call

INHERITED FLAGS
  --json                   Print JSON (same as --output json)
  --text                   Print text, the default (same as --output text)
  --output, -o choice      Output mode (choices: json, text)
  --org id|name            Scope to one organization (default: INFRAWRENCH_ORG, or your only one)
  --local                  Scope to the local (desktop) workspace
  --account, -a id|name    Account id or name for resource commands
  --color                  ANSI colours (--no-color turns them off)

GLOBAL FLAGS
  --help, -h       Show help information
  --version, -v    Show version information

SUBCOMMANDS
  clear    Drop a page key's cooldown after a recovery

ERROR
  --cooldown must be a whole number of minutes, got "1.5"
",
  "stdout": "",
}
`;

