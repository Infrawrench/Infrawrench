exports[`exports > lists exports and runs one like the legacy command > 2 $ infrawrench exports rerun x 1`] = `
{
  "requests": [],
  "stderr": "DESCRIPTION
  Scheduled cost exports (raw rows to a warehouse or object store) with the last run's status and error

USAGE
  infrawrench exports <subcommand> [flags]

INHERITED FLAGS
  --json                   Print JSON (same as --output json)
  --text                   Print text, the default (same as --output text)
  --output, -o choice      Output mode (choices: json, text)
  --org id|name            Scope to one organization (default: INFRAWRENCH_ORG, or your only one)
  --local                  Scope to the local (desktop) workspace
  --account, -a id|name    Account id or name for resource commands
  --color                  ANSI colours (--no-color turns them off)

GLOBAL FLAGS
  --help, -h       Show help information
  --version, -v    Show version information

SUBCOMMANDS
  run           Run one export now and list the objects it wrote
  warehouses    Snowflake/Databricks destinations, your accounts of each, and the --target keys they take
  create        A warehouse export: load cost rows into a Snowflake or Databricks table on a schedule
  setup         The least-privilege GRANT statements a warehouse export needs

ERROR
  Unknown subcommand "rerun" for "infrawrench exports"

  Did you mean this?
    run
",
  "stdout": "",
}
`;

