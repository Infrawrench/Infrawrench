exports[`unit-costs > refuses bad flags in the legacy words > 2 $ infrawrench unit-costs active-customers --format xml 1`] = `
{
  "requests": [],
  "stderr": "DESCRIPTION
  Business metrics and their cost per unit over time; a period with no reported value prints as —

USAGE
  infrawrench unit-costs <subcommand> [flags] [<key...>]

ARGUMENTS
  key... string    The business metric (the words join into one key) (optional)

FLAGS
  --last span                                   How far back: 7d, 30d, 12w or 3m
  --from date                                   Start of the range (YYYY-MM-DD or an ISO timestamp)
  --to date                                     End of the range (YYYY-MM-DD or an ISO timestamp)
  --group-by daily|weekly|monthly|cumulative    The bins (default daily)
  --basis cash|amortized|blended                Which cost to divide (default cash)
  --currency code                               Three-letter currency code, e.g. USD
  --where query                                 Narrow the spend, in the cost query language
  --margin                                      (revenue − cost) ÷ revenue instead of cost per unit; revenue metrics only
  --mode unit|margin|usage|raw                  Which calculation
  --scale 1|100|1k|1m|1b                        Cost per this many units
  --label key=v[,v]|key!=v                      Only metric values with (or without) these labels; repeatable
  --split label                                 One series per value of a metric label
  --usage-unit unit                             Cost per provider usage unit, no business metric needed
  --labels                                      The metric's labels, their values and the cost dimension each maps to
  --usage-units                                 The usage units your cost rows carry
  --format csv|ndjson                           The series as a file on stdout: one row per bucket per series, with the spend and metric value behind each ratio

INHERITED FLAGS
  --json                   Print JSON (same as --output json)
  --text                   Print text, the default (same as --output text)
  --output, -o choice      Output mode (choices: json, text)
  --org id|name            Scope to one organization (default: INFRAWRENCH_ORG, or your only one)
  --local                  Scope to the local (desktop) workspace
  --account, -a id|name    Account id or name for resource commands
  --color                  ANSI colours (--no-color turns them off)

GLOBAL FLAGS
  --help, -h       Show help information
  --version, -v    Show version information

SUBCOMMANDS
  sources     Accounts that can feed a business metric on a schedule, and the fields each importer takes
