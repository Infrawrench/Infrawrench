exports[`compliance > refuses bad selections in the legacy words > 2 $ infrawrench compliance --last 30d 1`] = `
{
  "requests": [],
  "stderr": "\`compliance\` takes an audit period as --from/--to (YYYY-MM-DD), not --last. Omit both for the last 90 days.
",
  "stdout": "",
}
`;

