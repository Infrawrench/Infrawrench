exports[`canvas > lists, shows and refreshes like the legacy command > 0 $ infrawrench canvas list --json 1`] = `
{
  "requests": [
    "GET /cost-canvases",
  ],
  "stderr": "",
  "stdout": "{
  "org": "org_1",
  "canvases": [
    {
      "id": "cv1",
      "name": "AI spend",
      "description": "Model and GPU spend",
      "spec": {
        "version": 1,
        "blocks": [
          {
            "id": "b1",
            "kind": "text",
            "text": "# Overview\\nWhat we spend on models."
          },
          {
            "id": "b2",
            "kind": "kpi",
            "title": "Monthly AI spend",
            "metric": {
              "type": "spend",
              "dateRange": {
                "kind": "relative",
                "preset": "30d"
              },
              "filters": []
            }
          },
          {
            "id": "b3",
            "kind": "chart",
            "title": "By service",
            "config": {
              "chartType": "stacked_bar",
              "groupBy": "service"
            }
          },
          {
            "id": "b4",
            "kind": "table",
            "title": "By account",
            "query": {
              "groupBy": "account",
              "binning": "monthly"
            }
          },
          {
            "id": "b5",
            "kind": "budgets",
            "title": "Budgets"
          },
          {
            "id": "b6",
            "kind": "anomalies",
            "title": "Spikes",
            "days": 30,
            "limit": 5
          },
          {
            "id": "b7",
            "kind": "custom_graph",
            "graphId": "g1"
          },
          {
            "id": "b8",
            "kind": "cost_report",
            "reportId": "r1"
          }
        ]
      },
      "prompt": "Show me AI spend",
      "conversationId": null,
      "createdByUserId": null,
      "createdAt": "2026-10-01T00:00:00.000Z",
      "updatedAt": "2026-11-01T09:00:00.000Z",
      "placements": [
        {
          "widgetId": "w1",
          "dashboardId": "d1",
          "dashboardName": "Finance"
        }
      ]
    }
  ]
}
",
}
`;

