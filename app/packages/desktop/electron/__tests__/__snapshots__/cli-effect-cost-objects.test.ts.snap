exports[`tag-keys > lists the keys and edits the lists > 2 $ infrawrench tag-keys bury misc 1`] = `
{
  "requests": [],
  "stderr": "DESCRIPTION
  Every tag key in cost data and inventory, with providers, usage and whether it is hidden or pinned

USAGE
  infrawrench tag-keys <subcommand> [flags]

INHERITED FLAGS
  --json                   Print JSON (same as --output json)
  --text                   Print text, the default (same as --output text)
  --output, -o choice      Output mode (choices: json, text)
  --org id|name            Scope to one organization (default: INFRAWRENCH_ORG, or your only one)
  --local                  Scope to the local (desktop) workspace
  --account, -a id|name    Account id or name for resource commands
  --color                  ANSI colours (--no-color turns them off)

GLOBAL FLAGS
  --help, -h       Show help information
  --version, -v    Show version information

SUBCOMMANDS
  hide      Hide a key, or a prefix like 'aws:cloudformation:*', from every picker (data untouched)
  unhide    Put a hidden key back in the pickers
  pin       Pin a key to the top of every picker
  unpin     Unpin a key

ERROR
  Unknown subcommand "bury" for "infrawrench tag-keys"
",
  "stdout": "",
}
`;

