{
  "name": "@infrawrench/desktop",
  "version": "1.28.0",
  "license": "BUSL-1.1",
  "private": true,
  "description": "A tool for managing infrastructure.",
  "author": {
    "name": "Infrawrench LLC",
    "email": "astrid@infrawrench.com"
  },
  "homepage": "https://infrawrench.com",
  "main": "out/main/index.js",
  "scripts": {
    "print-iwappd-hash": "node scripts/print-iwappd-hash.mjs",
    "test": "node scripts/ensure-env.mjs && vitest run",
    "dev": "node scripts/ensure-env.mjs && node scripts/ensure-iwappd.mjs && electron-vite dev",
    "build": "node scripts/ensure-env.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "node scripts/ensure-env.mjs && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "node scripts/ensure-env.mjs && node scripts/ensure-iwappd.mjs && electron-vite build && bash build/dist.sh"
  },
  "build": {
    "appId": "com.infrawrench.desktop",
    "productName": "Infrawrench",
    "executableName": "Infrawrench",
    "npmRebuild": false,
    "protocols": [
      {
        "name": "infrawrench",
        "role": "Editor",
        "schemes": [
          "infrawrench"
        ]
      }
    ],
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/**/{.turbo,.cache,test,tests,__tests__,example,examples,docs,doc,.github,.vscode,.idea,benchmark,benchmarks,fixture,fixtures}/**",
      "!**/node_modules/**/*.{md,markdown,ts,map,log,tsbuildinfo,flow,h,c,cc,cpp,gyp,gypi,d.ts}",
      "!**/node_modules/**/{LICENSE,LICENCE,CHANGELOG,HISTORY,CONTRIBUTING,AUTHORS,NOTICE,COPYING}{,.*}",
      "!**/node_modules/**/.{editorconfig,eslintrc,prettierrc,npmignore,gitignore,gitattributes,nycrc,babelrc,travis.yml,circleci}{,*}",
      "!**/node_modules/**/{tsconfig,jsconfig,rollup.config,webpack.config,karma.conf,jest.config,vitest.config}{,.*}.*",
      "!**/{.turbo,.cache}/**",
      "!**/node_modules/@infrawrench/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "asarUnpack": [
      "**/node_modules/@jitl/quickjs-*/dist/*.wasm"
    ],
    "extraResources": [
      "iwappd.tar.xz"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://infrawrench.com/api/updates",
        "channel": "latest"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "entitlements": "build/info.plist",
      "entitlementsInherit": "build/info.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Infrawrench uses the microphone so you can record a clip in the Speech tab and transcribe it against your own speech provider."
      },
      "artifactName": "${productName}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ]
    },
    "win": {
      "artifactName": "${productName}-setup-windows-${arch}.${ext}"
    },
    "linux": {
      "category": "Development"
    },
    "appImage": {
      "artifactName": "${productName}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@infrawrench/appstream-core": "workspace:*",
    "@infrawrench/appstream-host": "workspace:*",
