{
  "name": "@infrawrench/desktop",
  "version": "1.15.2",
  "license": "BUSL-1.1",
  "private": true,
  "description": "A tool for managing infrastructure.",
  "author": {
    "name": "Infrawrench LLC",
    "email": "astrid@infrawrench.com"
  },
  "homepage": "https://infrawrench.com",
  "main": "out/main/index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "node scripts/ensure-env.mjs && electron-vite dev",
    "build": "node scripts/ensure-env.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "node scripts/ensure-env.mjs && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "node scripts/ensure-env.mjs && electron-vite build && bash build/dist.sh"
  },
  "build": {
    "appId": "com.infrawrench.desktop",
    "productName": "Infrawrench",
    "executableName": "Infrawrench",
    "npmRebuild": false,
    "protocols": [
      {
        "name": "infrawrench",
        "role": "Editor",
        "schemes": [
          "infrawrench"
        ]
      }
    ],
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/**/{.turbo,.cache,test,tests,__tests__,example,examples,docs,doc,.github,.vscode,.idea,benchmark,benchmarks,fixture,fixtures}/**",
      "!**/node_modules/**/*.{md,markdown,ts,map,log,tsbuildinfo,flow,h,c,cc,cpp,gyp,gypi,d.ts}",
      "!**/node_modules/**/{LICENSE,LICENCE,CHANGELOG,HISTORY,CONTRIBUTING,AUTHORS,NOTICE,COPYING}{,.*}",
      "!**/node_modules/**/.{editorconfig,eslintrc,prettierrc,npmignore,gitignore,gitattributes,nycrc,babelrc,travis.yml,circleci}{,*}",
      "!**/node_modules/**/{tsconfig,jsconfig,rollup.config,webpack.config,karma.conf,jest.config,vitest.config}{,.*}.*",
      "!**/{.turbo,.cache}/**",
      "!**/node_modules/@infrawrench/**"
    ],
    "asarUnpack": [
      "**/node_modules/@jitl/quickjs-*/dist/*.wasm"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://infrawrench.com/api/updates",
        "channel": "latest"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "entitlements": "build/info.plist",
      "entitlementsInherit": "build/info.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Infrawrench uses the microphone so you can record a clip in the Speech tab and transcribe it against your own speech provider."
      },
      "artifactName": "${productName}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ]
    },
    "win": {
      "artifactName": "${productName}-setup-windows-${arch}.${ext}"
    },
    "linux": {
      "category": "Development"
    },
    "appImage": {
      "artifactName": "${productName}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@infrawrench/workflow-runtime": "workspace:*",
    "@kubernetes/client-node": "^1.4.0",
    "@libsql/client": "^0.14.0",
    "dockerode": "^5.0.0",
    "electron-updater": "^6.8.3",
    "ioredis": "^5.10.1",
    "memjs": "^1.3.2",
    "mongodb": "^7.2.0",
    "mysql2": "^3.22.3",
    "node-pty": "^1.1.0",
    "pg": "^8.20.0",
    "sql.js": "^1.12.0",
    "ssh2": "^1.16.0",
    "ws": "^8.21.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@infrawrench/client-core": "workspace:*",
    "@infrawrench/plugin-anthropic": "workspace:*",
    "@infrawrench/plugin-assemblyai": "workspace:*",
    "@infrawrench/plugin-aws": "workspace:*",
    "@infrawrench/plugin-azure": "workspace:*",
    "@infrawrench/plugin-base": "workspace:*",
    "@infrawrench/plugin-cartesia": "workspace:*",
    "@infrawrench/plugin-clickhouse": "workspace:*",
    "@infrawrench/plugin-cloudflare": "workspace:*",
    "@infrawrench/plugin-cloudinary": "workspace:*",
    "@infrawrench/plugin-cohere": "workspace:*",
    "@infrawrench/plugin-databricks": "workspace:*",
    "@infrawrench/plugin-deepgram": "workspace:*",
    "@infrawrench/plugin-deepseek": "workspace:*",
    "@infrawrench/plugin-digitalocean": "workspace:*",
    "@infrawrench/plugin-docker": "workspace:*",
    "@infrawrench/plugin-elevenlabs": "workspace:*",
    "@infrawrench/plugin-fireworks": "workspace:*",
    "@infrawrench/plugin-fly": "workspace:*",
    "@infrawrench/plugin-gcp": "workspace:*",
    "@infrawrench/plugin-gemini": "workspace:*",
    "@infrawrench/plugin-gladia": "workspace:*",
    "@infrawrench/plugin-groq": "workspace:*",
    "@infrawrench/plugin-hetzner": "workspace:*",
    "@infrawrench/plugin-kafka": "workspace:*",
    "@infrawrench/plugin-kubernetes": "workspace:*",
    "@infrawrench/plugin-memcached": "workspace:*",
    "@infrawrench/plugin-mistral": "workspace:*",
    "@infrawrench/plugin-mongodb": "workspace:*",
    "@infrawrench/plugin-mssql": "workspace:*",
    "@infrawrench/plugin-mysql": "workspace:*",
    "@infrawrench/plugin-neon": "workspace:*",
    "@infrawrench/plugin-netlify": "workspace:*",
    "@infrawrench/plugin-openai": "workspace:*",
    "@infrawrench/plugin-openrouter": "workspace:*",
    "@infrawrench/plugin-opensearch": "workspace:*",
    "@infrawrench/plugin-ovh": "workspace:*",
    "@infrawrench/plugin-planetscale": "workspace:*",
    "@infrawrench/plugin-postgres": "workspace:*",
    "@infrawrench/plugin-redis": "workspace:*",
    "@infrawrench/plugin-replicate": "workspace:*",
    "@infrawrench/plugin-revai": "workspace:*",
    "@infrawrench/plugin-scaleway": "workspace:*",
    "@infrawrench/plugin-speechmatics": "workspace:*",
    "@infrawrench/plugin-ssh": "workspace:*",
    "@infrawrench/plugin-together": "workspace:*",
    "@infrawrench/plugin-turso": "workspace:*",
    "@infrawrench/plugin-vercel": "workspace:*",
    "@infrawrench/plugin-workos": "workspace:*",
    "@infrawrench/plugin-xai": "workspace:*",
    "@infrawrench/sftp-host": "workspace:*",
    "@infrawrench/ssh-tunnel-core": "workspace:*",
    "@infrawrench/ui": "workspace:*",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router": "^1.114.7",
    "@tanstack/router-plugin": "^1.167.12",
    "@types/dockerode": "^3.3.31",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@types/ssh2": "^1.15.4",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^41.2.1",
    "electron-builder": "^26.10.0",
    "electron-vite": "^3.1.0",
    "jsdom": "^29.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  }
}
