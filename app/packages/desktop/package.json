{
  "name": "@infrawrench/desktop",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "private": true,
  "description": "A tool for managing infrastructure.",
  "author": {
    "name": "Infrawrench LLC",
    "email": "astrid@infrawrench.com"
  },
  "homepage": "https://infrawrench.com",
  "main": "out/main/index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "node scripts/ensure-env.mjs && electron-vite dev",
    "build": "node scripts/ensure-env.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "node scripts/ensure-env.mjs && tsgo --noEmit -p tsconfig.node.json && tsgo --noEmit -p tsconfig.web.json",
    "dist": "node scripts/ensure-env.mjs && electron-vite build && bash build/dist.sh"
  },
  "build": {
    "appId": "com.infrawrench.desktop",
    "productName": "Infrawrench",
    "executableName": "Infrawrench",
    "npmRebuild": false,
    "protocols": [
      {
        "name": "infrawrench",
        "role": "Editor",
        "schemes": [
          "infrawrench"
        ]
      }
    ],
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/**/{.turbo,.cache,test,tests,__tests__,example,examples,docs,doc,.github,.vscode,.idea}/**",
      "!**/node_modules/**/*.{md,markdown,ts,map,log,tsbuildinfo}",
      "!**/{.turbo,.cache}/**",
      "!**/node_modules/@infrawrench/**"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://infrawrench.com/api/updates",
        "channel": "latest"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "entitlements": "build/info.plist",
      "entitlementsInherit": "build/info.plist",
      "artifactName": "${productName}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "artifactName": "${productName}-setup-windows-${arch}.${ext}"
    },
    "linux": {
      "category": "Development"
    },
    "appImage": {
      "artifactName": "${productName}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@libsql/client": "^0.14.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router": "^1.114.7",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dockerode": "^4.0.4",
    "ioredis": "^5.3.2",
    "memjs": "^1.3.1",
    "monaco-editor": "^0.52.2",
    "mongodb": "^6.12.0",
    "mysql2": "^3.14.0",
    "node-pty": "^1.1.0",
    "pg": "^8.13.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.12.0",
    "electron-updater": "^6.8.3",
    "ssh2": "^1.16.0",
    "tailwindcss": "^4.2.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@infrawrench/sftp-host": "workspace:*",
    "@infrawrench/ssh-tunnel-core": "workspace:*",
    "@infrawrench/plugin-aws": "workspace:*",
    "@infrawrench/plugin-azure": "workspace:*",
    "@infrawrench/plugin-base": "workspace:*",
    "@infrawrench/plugin-clickhouse": "workspace:*",
    "@infrawrench/plugin-cloudflare": "workspace:*",
    "@infrawrench/plugin-cloudinary": "workspace:*",
    "@infrawrench/plugin-databricks": "workspace:*",
    "@infrawrench/plugin-digitalocean": "workspace:*",
    "@infrawrench/plugin-docker": "workspace:*",
    "@infrawrench/plugin-fly": "workspace:*",
    "@infrawrench/plugin-gcp": "workspace:*",
    "@infrawrench/plugin-hetzner": "workspace:*",
    "@infrawrench/plugin-kubernetes": "workspace:*",
    "@infrawrench/plugin-memcached": "workspace:*",
    "@infrawrench/plugin-mongodb": "workspace:*",
    "@infrawrench/plugin-mysql": "workspace:*",
    "@infrawrench/plugin-mssql": "workspace:*",
    "@infrawrench/plugin-neon": "workspace:*",
    "@infrawrench/plugin-netlify": "workspace:*",
    "@infrawrench/plugin-ovh": "workspace:*",
    "@infrawrench/plugin-planetscale": "workspace:*",
    "@infrawrench/plugin-postgres": "workspace:*",
    "@infrawrench/plugin-redis": "workspace:*",
    "@infrawrench/plugin-scaleway": "workspace:*",
    "@infrawrench/plugin-ssh": "workspace:*",
    "@infrawrench/plugin-turso": "workspace:*",
    "@infrawrench/plugin-vercel": "workspace:*",
    "@infrawrench/ui": "workspace:*",
    "@tanstack/router-plugin": "^1.167.12",
    "@types/dockerode": "^3.3.31",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "@types/ssh2": "^1.15.4",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.2.1",
    "electron-builder": "^26.0.12",
    "electron-builder-squirrel-windows": "^26.0.12",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.5",
    "vitest": "^3.0.5"
  }
}
