      "patches": [
        {
          "pointer": "/components/schemas/JsonValue_Output",
          "value": {},
          "why": "A recursive union, which is TS2502 once it is a property of `components`. Nothing here reads into it."
        },
        {
          "pointer": "/components/schemas/AnalyticsResponse_Output/properties/result/items",
          "value": {
            "type": "object",
            "additionalProperties": true
          },
          "why": "The document leaves a row untyped. Each row is an object keyed by the query's columns."
        },
        {
          "pointer": "/paths/~1v1~1projects~1{ref}~1database~1query/post/responses/201/content",
          "value": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "why": "The document describes no body here. A query answers with its rows, keyed by column."
        },
        {
          "pointer": "/components/schemas/DiskRequestBody/properties/attributes",
          "value": {
            "type": "object",
            "properties": {
              "iops": {
                "type": "integer"
              },
              "size_gb": {
                "type": "integer"
              },
              "throughput_mibps": {
                "type": "integer"
              },
              "type": {
                "type": "string"
              }
            }
          },
          "why": "The plugin merges the fields a user changed over what the server reports, so it cannot promise one union member, and Supabase validates the combination."
        },
        {
          "pointer": "/components/schemas/ApplyProjectAddonBody/properties/addon_variant",
          "value": {
            "type": "string"
          },
          "why": "Built from a form value (`ci_${size}`, `pitr_${days}`) that goes through as typed, and Supabase validates it."
        },
        {
          "pointer": "/components/schemas/V1CreateProjectBody/properties/desired_instance_size",
          "value": {
            "type": "string"
          },
          "why": "The value comes from a form and goes through as typed, and Supabase validates it, so one outside this list stays Supabase's error."
        },
        {
          "pointer": "/components/schemas/V1CreateProjectBody/properties/region_selection/oneOf/0/properties/code",
          "value": {
            "type": "string"
          },
          "why": "Filled from `available-regions`, whose codes the document itself calls not a stable API."
        },
        {
