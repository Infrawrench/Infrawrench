    "/v2/namespaces/{namespace}/repositories": ["get", "post"],
    "/v2/namespaces/{namespace}/repositories/{repository}": ["get"],
    "/v2/namespaces/{namespace}/repositories/{repository}/tags": ["get"],
    "/v2/namespaces/{namespace}/repositories/{repository}/tags/{tag}": ["get"],
    "/v2/namespaces/{namespace}/repositories/{repository}/immutabletags": ["patch"],
    "/v2/repositories/{namespace}/{repository}/": ["patch", "delete"],
    "/v2/repositories/{namespace}/{repository}/privacy": ["post"],
    "/v2/repositories/{namespace}/{repository}/tags/{tag}/": ["delete"],
    "/v2/repositories/{namespace}/{repository}/groups": ["post"],
    "/v2/repositories/{namespace}/{repository}/groups/{group_id}/": ["patch"],
    "/v2/orgs/{org_name}/members": ["get"],
    "/v2/orgs/{org_name}/members/{username}": ["put", "delete"],
    "/v2/orgs/{org_name}/invites": ["get"],
    "/v2/orgs/{org_name}/groups": ["get", "post"],
    "/v2/orgs/{org_name}/groups/{group_name}": ["get", "patch", "delete"],
    "/v2/orgs/{org_name}/groups/{group_name}/members": ["get", "post"],
    "/v2/orgs/{org_name}/groups/{group_name}/members/{username}": ["delete"],
    "/v2/invites/{id}": ["delete"],
    "/v2/invites/{id}/resend": ["patch"],
    "/v2/invites/bulk": ["post"]
  }
}
