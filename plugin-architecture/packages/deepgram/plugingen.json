    {
      "pointer": "/components/schemas/AgentConfigurationV1Config",
      "value": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "greeting": { "type": "string" },
              "listen": {
                "type": "object",
                "properties": {
                  "provider": { "$ref": "#/components/schemas/AgentBlockProvider" }
                }
              },
              "think": {
                "type": "object",
                "properties": {
                  "provider": { "$ref": "#/components/schemas/AgentBlockProvider" },
                  "prompt": { "type": "string" },
                  "functions": { "type": "array", "items": { "type": "object" } }
                }
              },
              "speak": {
                "oneOf": [
                  { "$ref": "#/components/schemas/AgentBlockSpeak" },
                  { "type": "array", "items": { "$ref": "#/components/schemas/AgentBlockSpeak" } }
                ]
              }
            }
          }
        ]
      },
      "why": "An empty object in the schema. It is the `agent` block of a Settings message, and the plugin also accepts it as the JSON string the create body sends."
    },
    {
      "pointer": "/components/schemas/CreateAgentConfigurationV1ResponseConfig",
      "value": { "$ref": "#/components/schemas/AgentConfigurationV1Config" },
      "why": "An empty object in the schema, and the same block as a configuration read returns."
