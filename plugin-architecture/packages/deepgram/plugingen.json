      "value": {
        "type": "object",
        "properties": {
          "code": { "type": "number" },
          "completed": { "type": "string" },
          "deployment": { "type": "string" },
          "details": {
            "type": "object",
            "properties": {
              "duration": { "type": "number" },
              "method": { "type": "string" },
              "usd": { "type": "number" },
              "tier": { "type": "string" },
              "total_audio": { "type": "number" }
            }
          }
        }
      },
      "why": "An empty object in the schema. The fields are the ones the request log reads, as they appear in the document's example."
