    },
    {
      "pointer": "/components/schemas/UsageBreakdownV1ResponseResultsItems/properties/total_hours",
      "value": { "type": "number" },
      "why": "Written as `type: string, title: float`, which is how this document spells a float."
    },
    {
      "pointer": "/components/schemas/UsageBreakdownV1ResponseResultsItems/properties/agent_hours",
      "value": { "type": "number" },
      "why": "Written as `type: string, title: float`, which is how this document spells a float."
    },
