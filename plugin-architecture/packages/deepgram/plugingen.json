          "scopes": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "expiration_date": { "type": "string" }
        }
      },
      "why": "The document types this body as a oneOf of two branches of any type, so nothing would be checked. These are the fields the plugin sends; only `expiration_date` appears in the document, in its example."
    },
    {
      "pointer": "/components/schemas/ListProjectMembersV1ResponseMembersItems/required",
      "value": ["member_id"],
      "why": "The document marks nothing required here. A member is addressed by this id."
