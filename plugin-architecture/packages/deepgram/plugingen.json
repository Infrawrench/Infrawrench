    {
      "pointer": "/components/schemas/AgentBlockProvider",
      "value": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "model": { "type": "string" },
          "version": { "type": "string" }
        }
      },
      "why": "Not in the document. One provider of an `agent` block, for the configuration schema patched above."
    },
    {
      "pointer": "/components/schemas/AgentBlockSpeak",
      "value": {
        "type": "object",
        "properties": {
          "provider": { "$ref": "#/components/schemas/AgentBlockProvider" }
        }
      },
      "why": "Not in the document. `speak` is one of these or a fallback list of them, for the configuration schema patched above."
    }
