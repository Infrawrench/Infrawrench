    },
    {
      "pointer": "/components/schemas/BillingBreakdownV1ResponseResultsItems/properties/dollars",
      "value": { "type": "number" },
      "why": "Written as `type: string, title: float`, which is how this document spells a float. Deepgram's reference shows `\"dollars\": 0.25`."
    },
    {
      "pointer": "/components/schemas/UsageBreakdownV1ResponseResultsItems/properties/hours",
      "value": { "type": "number" },
