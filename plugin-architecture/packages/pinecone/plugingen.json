{
  "$schema": "../../../plugingen/plugingen.schema.json",
  "documents": [
    {
      "name": "control",
      "specUrl": "https://raw.githubusercontent.com/pinecone-io/pinecone-api/main/2026-07/db_control_2026-07.oas.yaml",
      "paths": {
        "/indexes": ["get", "post"],
        "/indexes/create-for-model": ["post"],
        "/indexes/{index_name}": ["get", "patch", "delete"],
        "/indexes/{index_name}/backups": ["post"],
        "/indexes/{index_name}/backup-schedules": ["get", "post"],
        "/collections": ["get", "post"],
        "/collections/{collection_name}": ["get", "delete"],
        "/backups": ["get"],
        "/backups/{backup_id}": ["get", "delete"],
        "/backups/{backup_id}/create-index": ["post"],
        "/backup-schedules/{schedule_id}": ["get", "patch", "delete"],
        "/backup-schedules/{schedule_id}/history": ["get"],
        "/restore-jobs": ["get"],
        "/restore-jobs/{job_id}": ["get"]
      },
      "patches": [
        {
          "pointer": "/components/schemas/CreateIndexForModelRequest/properties/embed/properties/field_map",
          "value": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "why": "The document says only `type: object`, which generates an object that can hold nothing. Its own example maps `text` to a field name, which is what the plugin sends."
        }
      ]
    },
    {
      "name": "inference",
      "specUrl": "https://raw.githubusercontent.com/pinecone-io/pinecone-api/main/2026-07/inference_2026-07.oas.yaml",
      "paths": {
        "/models": ["get"]
      }
    },
    {
      "name": "assistant",
      "specUrl": "https://raw.githubusercontent.com/pinecone-io/pinecone-api/main/2026-07/assistant_control_2026-07.oas.yaml",
      "paths": {
        "/assistants": ["get", "post"],
        "/assistants/{assistant_name}": ["get", "patch", "delete"]
      },
      "patches": [
        {
          "pointer": "/components/schemas/UpdateAssistantRequest/properties/metadata",
          "value": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          },
          "why": "The document says only `type: object`, which generates an object that can hold nothing. Its description calls this custom organizational data, which is what the plugin sends from the metadata field."
        }
      ]
    },
    {
      "name": "assistant-data",
      "specUrl": "https://raw.githubusercontent.com/pinecone-io/pinecone-api/main/2026-07/assistant_data_2026-07.oas.yaml",
      "paths": {
