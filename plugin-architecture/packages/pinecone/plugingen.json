      "specUrl": "https://raw.githubusercontent.com/pinecone-io/pinecone-api/main/2026-07/db_data_2026-07.oas.yaml",
      "paths": {
        "/describe_index_stats": ["post"]
      }
    },
    {
      "name": "admin",
      "specUrl": "https://raw.githubusercontent.com/pinecone-io/pinecone-api/main/2026-07/admin_2026-07.oas.yaml",
      "paths": {
        "/admin/projects": ["get", "post"],
        "/admin/projects/{project_id}": ["get", "patch", "delete"],
        "/admin/projects/{project_id}/api-keys": ["get", "post"],
        "/admin/api-keys/{api_key_id}": ["get", "patch", "delete"],
        "/admin/service-accounts": ["get", "post"],
        "/admin/service-accounts/{service_account_id}": ["get", "patch", "delete"],
        "/admin/service-accounts/{service_account_id}/rotate-secret": ["post"]
      }
    },
    {
