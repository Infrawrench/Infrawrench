      }
    },
    {
      "name": "oauth",
      "specUrl": "https://raw.githubusercontent.com/pinecone-io/pinecone-api/main/2026-07/oauth_2026-07.oas.yaml",
      "paths": {
        "/oauth/token": ["post"]
      }
    }
  ]
}
