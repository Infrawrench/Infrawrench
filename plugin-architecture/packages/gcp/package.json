{
  "name": "@infrawrench/plugin-gcp",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node-driver": {
      "import": {
        "types": "./node-driver.d.ts",
        "default": "./dist/node-driver.js"
      },
      "require": {
        "types": "./node-driver.d.cts",
        "default": "./dist/node-driver.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "node-driver.d.ts",
    "node-driver.d.cts"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@infrawrench/plugin-base": "workspace:*",
    "js-yaml": "^4.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8",
    "tsdown": "^0.22.14"
  }
}
