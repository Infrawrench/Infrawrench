      "pointer": "/paths/~1focus-report~1{period}",
      "value": {
        "get": {
          "operationId": "get-focus-report",
          "parameters": [
            {
              "in": "path",
              "name": "period",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "ok",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "presigned_url": {
                        "type": "string"
                      },
                      "expires_in": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "why": "The published document does not list this [BETA] operation. Shape from exoscale/egoscale v3, GetFocusReport and FocusReport."
    },
