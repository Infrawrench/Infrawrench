{
  "$schema": "../../../plugingen/plugingen.schema.json",
  "documents": [
    {
      "name": "platform",
      "specUrl": "https://docs.perplexity.ai/openapi.json",
      "patches": [
        {
          "pointer": "/components/schemas/ApiChatCompletionsRequest/properties/model",
          "value": { "type": "string" },
          "why": "An enum in the document; the create form's text goes through as typed."
        },
        {
          "pointer": "/components/schemas/ApiChatCompletionsRequest/properties/search_recency_filter",
          "value": { "type": "string" },
          "why": "An enum in the document; the create form's text goes through as typed."
        },
        {
          "pointer": "/components/schemas/Input/oneOf/1/items",
          "value": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": { "type": "string", "enum": ["user", "assistant", "system", "developer"] },
              "content": { "type": "string" }
            }
          },
          "why": "The plugin sends only chat turns, with no `type`. InputItem requires and discriminates on it, though the provider's own function-calling example also leaves it out."
        }
      ],
      "paths": {
        "/v1/models": ["get"],
        "/v1/async/sonar": ["get", "post"],
        "/v1/async/sonar/{api_request}": ["get"],
        "/v1/agent": ["post"],
        "/v1/skills": ["get"],
        "/v1/skills/{skill_id}": ["get", "delete"],
        "/v1/skills/{skill_id}/revisions": ["get"]
      }
    },
    {
      "name": "orchestrator",
      "specUrl": "https://docs.perplexity.ai/openapi-gateway-chat.json",
      "pathPrefix": "/orchestrator/v1",
      "paths": {
        "/models": ["get"],
        "/models/{model}": ["get"]
      }
    }
  ]
}
