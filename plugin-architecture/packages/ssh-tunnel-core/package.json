{
  "name": "@infrawrench/ssh-tunnel-core",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
