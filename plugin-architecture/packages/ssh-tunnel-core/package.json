{
  "name": "@infrawrench/ssh-tunnel-core",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "type": "module",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./chain": {
      "types": {
        "import": "./dist/chain.d.ts",
        "require": "./dist/chain.d.cts"
      },
      "import": "./dist/chain.js",
      "require": "./dist/chain.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@infrawrench/plugin-base": "workspace:*"
  },
  "peerDependencies": {
    "ssh2": ">=1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ssh2": "^1.15.5",
    "ssh2": "^1.17.0",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
