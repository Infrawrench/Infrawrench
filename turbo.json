{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"],
      "inputs": ["src/**", "tsconfig.json", "tsdown.config.ts", "vite.config.ts", "next.config.ts"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:db": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "CLICKHOUSE_METRICS_URL",
        "CLICKHOUSE_METRICS_USER",
        "CLICKHOUSE_METRICS_PASSWORD",
        "CLICKHOUSE_METRICS_DATABASE",
        "CLICKHOUSE_METRICS_REPLICATED"
      ]
    },
    "test:postgres": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "test:clickhouse": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "CLICKHOUSE_METRICS_URL",
        "CLICKHOUSE_METRICS_USER",
        "CLICKHOUSE_METRICS_PASSWORD",
        "CLICKHOUSE_METRICS_DATABASE",
        "CLICKHOUSE_METRICS_REPLICATED"
      ]
    },
    "test:clickhouse:shadow": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "CLICKHOUSE_METRICS_URL",
        "CLICKHOUSE_METRICS_USER",
        "CLICKHOUSE_METRICS_PASSWORD",
        "CLICKHOUSE_METRICS_DATABASE",
        "CLICKHOUSE_METRICS_REPLICATED"
      ]
    },
    "test:postgres:shadow": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
