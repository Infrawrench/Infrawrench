# Integration test credentials.
# Only add tokens for providers you want to test.
# Providers with missing credentials are automatically skipped.

# ─── Cloud providers ──────────────────────────────────────────────────────────

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# GCP (paste the full JSON or a path)
GCP_SERVICE_ACCOUNT_JSON=
GCP_PROJECT=

# Azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# DigitalOcean
DIGITALOCEAN_API_TOKEN=

# Hetzner
HETZNER_API_TOKEN=

# Scaleway
SCALEWAY_ACCESS_KEY=
SCALEWAY_SECRET_KEY=
SCALEWAY_DEFAULT_PROJECT_ID=

# OVH
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
OVH_ENDPOINT=eu
OVH_PROJECT_ID=

# Cloudflare
CLOUDFLARE_API_TOKEN=

# ─── Database providers ───────────────────────────────────────────────────────

# Neon
NEON_API_KEY=

# PlanetScale
PLANETSCALE_SERVICE_TOKEN_ID=
PLANETSCALE_SERVICE_TOKEN_SECRET=
PLANETSCALE_ORGANIZATION_NAME=

# Turso
TURSO_API_TOKEN=
TURSO_ORGANIZATION_NAME=

# Databricks
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# ─── Self-hosted / local ─────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_CONNECTION_STRING=

# MySQL
MYSQL_CONNECTION_STRING=

# MongoDB
MONGODB_CONNECTION_STRING=

# Redis
REDIS_CONNECTION_STRING=

# Memcached
MEMCACHED_CONNECTION_STRING=

# Docker
DOCKER_HOST=unix:///var/run/docker.sock

# SSH
SSH_HOST=
SSH_PORT=22
SSH_USERNAME=
SSH_PRIVATE_KEY=

# Kubernetes (path to kubeconfig or inline YAML)
KUBECONFIG=
