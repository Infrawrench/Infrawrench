{
  "name": "infrawrench",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260411.1",
    "knip": "^6.4.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "^0.8.13",
      "yaml": ">=2.8.3",
      "@esbuild-kit/core-utils>esbuild": ">=0.25.0"
    }
  }
}
