{
  "name": "infrawrench",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean && find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "knip": "^6.32.0",
    "prettier": "^3.9.6",
    "react-doctor": "^0.2.16",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "yaml": ">=2.8.3",
      "@esbuild-kit/core-utils>esbuild": ">=0.25.0"
    }
  }
}
